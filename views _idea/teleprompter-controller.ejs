                        <div class="flex-1">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-white/30">
                                    Weather
                                </span>

                                <span class="text-[7px] uppercase tracking-[1px] text-green-500">
                                    READY
