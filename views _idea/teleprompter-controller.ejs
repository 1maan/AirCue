                </div>


                <div class="flex justify-between items-center">

                    <span class="text-[9px] text-white/35">
                        Text Width
                    </span>

                    <div class="flex items-center gap-2">

                        <button
                            onclick="changeWidth(-2)"
                            class="w-7 h-7 border border-white/10 text-white/40">
                            −
                        </button>

                        <span id="widthValue" class="mono text-[9px] w-10 text-center">
                            76%
                        </span>

                        <button
                            onclick="changeWidth(2)"
                            class="w-7 h-7 border border-white/10 text-white/40">
                            +
                        </button>

                    </div>

                </div>

            </div>


            <!-- POSITION -->
            <div class="p-5 border-b border-white/10">

                <div class="text-[9px] uppercase tracking-[2px] text-white/25 mb-5">
                    Position
                </div>


                <div class="flex justify-between items-center mb-5">

                    <span class="text-[9px] text-white/35">
                        Top Margin
                    </span>

                    <input
                        id="topMargin"
                        type="range"
                        min="0"
                        max="200"
                        value="80"
                        class="w-28"
                    >

                </div>


                <div class="flex justify-between items-center mb-5">

                    <span class="text-[9px] text-white/35">
                        Side Margin
                    </span>

                    <input
                        id="sideMargin"
                        type="range"
                        min="2"
                        max="25"
                        value="12"
                        class="w-28"
                    >

                </div>


                <div class="grid grid-cols-2 gap-2">

                    <button
                        onclick="moveScript(-20)"
                        class="h-8 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/35 hover:text-white">
                        Move Up
                    </button>

                    <button
                        onclick="moveScript(20)"
                        class="h-8 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/35 hover:text-white">
                        Move Down
                    </button>

                </div>

            </div>


            <!-- DISPLAY -->
            <div class="p-5 border-b border-white/10">

                <div class="text-[9px] uppercase tracking-[2px] text-white/25 mb-4">
                    Display
                </div>


                <div class="space-y-3">

                    <label class="flex items-center justify-between">

                        <span class="text-[9px] text-white/35">
                            Mirror Horizontally
                        </span>

                        <input
                            type="checkbox"
                            class="w-4 h-4 accent-white"
                        >

                    </label>


                    <label class="flex items-center justify-between">

                        <span class="text-[9px] text-white/35">
                            Mirror Vertically
                        </span>

                        <input
                            type="checkbox"
                            class="w-4 h-4 accent-white"
                        >

                    </label>


                    <label class="flex items-center justify-between">

                        <span class="text-[9px] text-white/35">
                            Show Safe Area
                        </span>

                        <input
                            type="checkbox"
                            class="w-4 h-4 accent-white"
                        >

                    </label>

                </div>

            </div>


            <!-- CG -->
            <div class="p-5">

                <div class="flex items-center justify-between mb-4">

                    <span class="text-[9px] uppercase tracking-[2px] text-white/25">
                        Current CG
                    </span>

                    <span class="text-[8px] text-green-500 uppercase">
                        Ready
                    </span>

                </div>


                <div class="border border-white/10 bg-[#111315] p-3">

                    <div class="text-[8px] uppercase tracking-[1px] text-white/20">
                        Lower Third
                    </div>

                    <div class="text-xs font-semibold mt-2">
                        Government announces new project
                    </div>

                    <div class="text-[8px] text-white/25 mt-1">
                        ACTIVE
                    </div>

                </div>


                <div class="grid grid-cols-2 gap-2 mt-3">

                    <button class="h-9 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/40 hover:text-white">
                        Hide CG
                    </button>

                    <button class="h-9 bg-white text-black text-[8px] uppercase tracking-[1px] font-bold">
                        Show CG
                    </button>

                </div>

            </div>

        </aside>

    </div>

</div>


<script>

    let playing = false;

    let speed = 2.5;

    let fontSize = 28;

    let lineHeight = 1.65;

    let textWidth = 76;

    let scriptPosition = 0;


    function togglePlay() {

        playing = !playing;

        const button = document.getElementById("playButton");
        const state = document.getElementById("stateLabel");

        if (playing) {

            button.textContent = "Ⅱ";
            state.textContent = "Playing";
            state.className =
                "text-[8px] uppercase tracking-[1px] text-green-500";

        } else {

            button.textContent = "▶";
            state.textContent = "Paused";
            state.className =
                "text-[8px] uppercase tracking-[1px] text-yellow-500";

        }

    }


    function updateSpeed(value) {

        speed = parseFloat(value);

        document.getElementById("speedLabel").textContent =
            speed.toFixed(1);

        document.getElementById("speedValue").textContent =
            speed.toFixed(1);

        /*
            Socket.IO:

            socket.emit("teleprompter:speed", {
                runOrderId,
                storyId,
                speed
            });
        */

    }


    function setSpeed(value) {

        document.getElementById("speed").value = value;

        updateSpeed(value);

    }


    function changeFontSize(amount) {

        fontSize += amount;

        if (fontSize < 18) fontSize = 18;
        if (fontSize > 60) fontSize = 60;

        document.querySelector(".teleprompter-text").style.fontSize =
            fontSize + "px";

        document.getElementById("fontSizeValue").textContent =
            fontSize + "px";

        /*
            socket.emit("teleprompter:settings", {
                fontSize
            });
        */

    }


    function changeLineHeight(amount) {

        lineHeight += amount;

        lineHeight = Math.round(lineHeight * 10) / 10;

        if (lineHeight < 1) lineHeight = 1;
        if (lineHeight > 2.5) lineHeight = 2.5;

        document.querySelector(".teleprompter-text").style.lineHeight =
            lineHeight;

        document.getElementById("lineHeightValue").textContent =
            lineHeight.toFixed(1);

    }


    function changeWidth(amount) {

        textWidth += amount;

        if (textWidth < 50) textWidth = 50;
        if (textWidth > 90) textWidth = 90;

        const padding = (100 - textWidth) / 2;

        document.getElementById("script").style.paddingLeft =
            padding + "%";

        document.getElementById("script").style.paddingRight =
            padding + "%";

        document.getElementById("widthValue").textContent =
            textWidth + "%";

    }


    function moveScript(amount) {

        scriptPosition += amount;

        document.getElementById("script").style.transform =
            `translateY(${scriptPosition}px)`;

    }


    function resetScroll() {

        scriptPosition = 0;

        document.getElementById("script").style.transform =
            "translateY(0)";

        document.getElementById("positionText").textContent =
            "0%";

    }


    function nudge(direction) {

        scriptPosition += direction * 25;

