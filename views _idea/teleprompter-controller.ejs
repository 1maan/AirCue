                </div>

            </div>

        </main>


        <!-- RIGHT CONTROLS -->
        <aside class="w-[320px] shrink-0 bg-[#151719] border-l border-white/10 overflow-y-auto scrollbar">


            <!-- LIVE STATE -->
            <div class="p-5 border-b border-white/10">

                <div class="flex items-center justify-between">

                    <span class="text-[9px] uppercase tracking-[2px] text-white/25">
                        Control State
                    </span>

                    <span id="stateLabel" class="text-[8px] uppercase tracking-[1px] text-green-500">
                        Playing
                    </span>

                </div>


                <div class="mt-5 flex items-center justify-between">

                    <div>

                        <div class="text-[8px] uppercase tracking-[1px] text-white/20">
                            Current
                        </div>

                        <div class="text-xs font-semibold mt-2">
                            Story 08
                        </div>

                    </div>


                    <div class="text-right">

                        <div class="text-[8px] uppercase tracking-[1px] text-white/20">
                            Speed
                        </div>

                        <div id="speedValue" class="mono text-lg mt-1">
                            2.5
                        </div>

                    </div>

                </div>

            </div>


            <!-- SPEED -->
            <div class="p-5 border-b border-white/10">

                <div class="flex justify-between items-center mb-5">

                    <span class="text-[9px] uppercase tracking-[2px] text-white/25">
                        Scroll Speed
                    </span>

                    <span id="speedLabel" class="mono text-[10px]">
                        2.5
                    </span>

                </div>


                <input
                    id="speed"
                    type="range"
                    min="0"
                    max="5"
                    step="0.1"
                    value="2.5"
                    oninput="updateSpeed(this.value)"
                >


                <div class="flex justify-between mt-3">

                    <span class="text-[7px] text-white/20 uppercase">
                        Slow
                    </span>

                    <span class="text-[7px] text-white/20 uppercase">
                        Fast
                    </span>

                </div>


                <div class="grid grid-cols-3 gap-2 mt-5">

                    <button onclick="setSpeed(1)" class="h-8 border border-white/10 text-[8px] text-white/35 hover:text-white">
                        1.0
                    </button>

                    <button onclick="setSpeed(2.5)" class="h-8 border border-white/10 text-[8px] text-white/35 hover:text-white">
                        2.5
                    </button>

                    <button onclick="setSpeed(4)" class="h-8 border border-white/10 text-[8px] text-white/35 hover:text-white">
                        4.0
                    </button>

                </div>

            </div>


            <!-- TEXT -->
            <div class="p-5 border-b border-white/10">

                <div class="text-[9px] uppercase tracking-[2px] text-white/25 mb-5">
                    Text
                </div>


                <div class="flex justify-between items-center mb-5">

                    <span class="text-[9px] text-white/35">
                        Font Size
                    </span>

                    <div class="flex items-center gap-2">

                        <button
                            onclick="changeFontSize(-2)"
                            class="w-7 h-7 border border-white/10 text-white/40 hover:text-white">
                            −
                        </button>

                        <span id="fontSizeValue" class="mono text-[9px] w-10 text-center">
                            28px
                        </span>

                        <button
                            onclick="changeFontSize(2)"
                            class="w-7 h-7 border border-white/10 text-white/40 hover:text-white">
                            +
                        </button>

                    </div>

                </div>


                <div class="flex justify-between items-center mb-5">

                    <span class="text-[9px] text-white/35">
                        Line Height
                    </span>

                    <div class="flex items-center gap-2">

                        <button
                            onclick="changeLineHeight(-0.1)"
