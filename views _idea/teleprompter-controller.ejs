                    <div class="flex gap-3">

                        <span class="mono text-[9px] text-white/25 w-5">
                            10
                        </span>

                        <div class="flex-1">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-white/30">
                                    Sports
                                </span>

                                <span class="text-[7px] uppercase tracking-[1px] text-green-500">
                                    READY
                                </span>

                            </div>

