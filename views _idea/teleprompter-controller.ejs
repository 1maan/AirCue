                <div>

                    <div class="flex items-center gap-3">

                        <span class="mono text-[9px] text-white/20">
                            STORY 08
                        </span>

                        <span class="text-white/15">
                            /
                        </span>

                        <span class="text-[9px] uppercase tracking-[1.5px] text-white/35">
                            Politics
                        </span>

                    </div>

                    <div class="text-sm font-bold mt-2">
                        Government announces new development project
                    </div>

                </div>


                <div class="flex items-center gap-8">

                    <div class="text-right">

                        <div class="text-[7px] uppercase tracking-[2px] text-white/20">
                            Story Time
                        </div>

                        <div class="mono text-sm mt-1">
                            01:24
                            <span class="text-white/20">/ 02:15</span>
                        </div>

                    </div>

                    <div class="text-right">

                        <div class="text-[7px] uppercase tracking-[2px] text-white/20">
                            Position
                        </div>

                        <div id="positionText" class="mono text-sm mt-1">
                            42%
                        </div>

                    </div>

                </div>

            </div>


            <!-- Prompter -->
            <div
                id="prompter"
                class="flex-1 overflow-hidden relative">

                <!-- Position marker -->
