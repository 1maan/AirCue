<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AirCue | Teleprompter Controller</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #0d0f10;
            color: #f4f4f4;
        }

        .mono {
            font-family: "Courier New", monospace;
        }

        .scrollbar::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        .scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .scrollbar::-webkit-scrollbar-thumb {
            background: #34383b;
        }

        input[type="range"] {
            appearance: none;
            width: 100%;
            height: 3px;
            background: #303437;
            outline: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            appearance: none;
            width: 13px;
            height: 13px;
            background: #f4f4f4;
            cursor: pointer;
        }

        input[type="range"]::-moz-range-thumb {
            width: 13px;
            height: 13px;
            background: #f4f4f4;
            border: 0;
            cursor: pointer;
        }

        .teleprompter-text {
            font-size: 28px;
            line-height: 1.65;
        }
    </style>
</head>

<body class="h-screen overflow-hidden">

<div class="h-screen flex flex-col">


    <!-- TOP BAR -->
    <header class="h-[62px] shrink-0 bg-[#17191b] border-b border-white/10 flex items-center">

        <div class="w-[235px] h-full px-5 border-r border-white/10 flex items-center">

            <div class="flex items-center gap-3">

                <div class="w-8 h-8 border border-white/30 flex items-center justify-center">
                    <div class="w-3.5 h-3.5 bg-white"></div>
                </div>

                <div>
                    <div class="font-bold text-base">
                        AirCue
                    </div>

                    <div class="text-[7px] uppercase tracking-[2px] text-white/25">
                        Teleprompter Control
                    </div>
                </div>

            </div>

        </div>


        <div class="flex-1 px-6 flex items-center gap-5">

            <div>

                <div class="text-sm font-bold">
                    Evening News
                </div>

                <div class="mono text-[8px] text-white/25 mt-1">
                    10 AUG 2026 / 18:00
                </div>

            </div>

            <span class="px-2 py-1 bg-red-500/10 text-red-400 text-[7px] uppercase tracking-[1px]">
                LIVE
            </span>

        </div>


        <div class="px-5 flex items-center gap-5">

            <div class="flex items-center gap-2">

                <span class="w-2 h-2 bg-green-500"></span>

                <span class="text-[8px] uppercase tracking-[1px] text-green-500">
                    Prompter Connected
                </span>

            </div>

            <div class="h-6 w-px bg-white/10"></div>

            <div class="text-right">

                <div class="text-[7px] uppercase tracking-[2px] text-white/20">
                    Sync
                </div>

                <div class="mono text-[9px] text-white/50">
                    18ms
                </div>

            </div>

        </div>

    </header>


    <!-- MAIN -->
    <div class="flex flex-1 min-h-0">


        <!-- LEFT RUNDOWN -->
        <aside class="w-[280px] shrink-0 bg-[#151719] border-r border-white/10 flex flex-col">

            <div class="h-[58px] shrink-0 px-4 border-b border-white/10 flex items-center justify-between">

                <div>

                    <div class="text-[9px] uppercase tracking-[2px] text-white/25">
                        Run Order
                    </div>

                    <div class="text-[10px] text-white/50 mt-1">
                        08 / 18 · On Air
                    </div>

                </div>

                <div class="mono text-[9px] text-white/20">
                    28:42
                </div>

            </div>


            <div class="flex-1 overflow-y-auto scrollbar">


                <!-- Completed -->
                <div class="px-4 py-3 border-b border-white/10">

                    <div class="flex gap-3">

                        <span class="mono text-[9px] text-white/15 w-5">
                            06
                        </span>

                        <div>

                            <div class="text-[8px] uppercase tracking-[1px] text-white/20">
                                Weather
                            </div>

                            <div class="text-[10px] text-white/25 mt-1">
                                Weather forecast
                            </div>

                        </div>

                    </div>

                </div>


                <div class="px-4 py-3 border-b border-white/10">

                    <div class="flex gap-3">

                        <span class="mono text-[9px] text-white/15 w-5">
                            07
                        </span>

                        <div>

                            <div class="text-[8px] uppercase tracking-[1px] text-white/20">
                                Local
                            </div>

                            <div class="text-[10px] text-white/25 mt-1">
                                New council development
                            </div>

                        </div>

                    </div>

                </div>


                <!-- CURRENT -->
                <button
                    onclick="selectStory(8)"
                    class="w-full text-left px-4 py-4 border-l-2 border-red-500 border-b border-white/10 bg-white/[0.06]">

                    <div class="flex gap-3">

                        <span class="mono text-[9px] text-red-400 w-5">
                            08
                        </span>

                        <div class="flex-1">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-red-400">
                                    Politics
                                </span>

                                <span class="w-1.5 h-1.5 bg-red-500 animate-pulse"></span>

                            </div>

                            <div class="text-xs font-semibold mt-1 leading-5">
                                Government announces new development project
                            </div>

                            <div class="flex justify-between mt-3">

                                <span class="text-[7px] uppercase tracking-[1px] text-red-400">
                                    ON AIR
                                </span>

                                <span class="mono text-[8px] text-white/25">
                                    01:24
                                </span>

                            </div>

                        </div>

                    </div>

                </button>


                <!-- Next -->
                <button
                    onclick="selectStory(9)"
                    class="w-full text-left px-4 py-4 border-b border-white/10 hover:bg-white/[0.03]">

                    <div class="flex gap-3">

                        <span class="mono text-[9px] text-white/25 w-5">
                            09
                        </span>

                        <div class="flex-1">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-white/30">
                                    Business
                                </span>

                                <span class="text-[7px] uppercase tracking-[1px] text-green-500">
                                    READY
                                </span>

                            </div>

                            <div class="text-[10px] mt-1 text-white/65 leading-4">
