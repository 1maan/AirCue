<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AirCue | Evening News</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #111315;
            color: #f4f4f4;
        }

        .mono {
            font-family: "Courier New", monospace;
        }

        textarea,
        input,
        select {
            outline: none;
        }

        .scrollbar::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        .scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .scrollbar::-webkit-scrollbar-thumb {
            background: #34383b;
        }

        .story-item {
            cursor: grab;
        }

        .story-item:active {
            cursor: grabbing;
        }
    </style>
</head>

<body class="h-screen overflow-hidden">

<div class="h-screen flex flex-col">


    <!-- TOP BAR -->
    <header class="h-[64px] shrink-0 border-b border-white/10 bg-[#17191b] flex items-center">

        <!-- Brand -->
        <div class="w-[220px] h-full px-5 border-r border-white/10 flex items-center">

            <div class="flex items-center gap-3">

                <div class="w-8 h-8 border border-white/30 flex items-center justify-center">
                    <div class="w-3.5 h-3.5 bg-white"></div>
                </div>

                <div>
                    <div class="font-bold text-base">
                        AirCue
                    </div>

                    <div class="text-[7px] uppercase tracking-[2px] text-white/25">
                        Run Order
                    </div>
                </div>

            </div>

        </div>


        <!-- Run order title -->
        <div class="flex-1 px-6 flex items-center gap-4">

            <div>

                <div class="text-sm font-bold">
                    Evening News
                </div>

                <div class="flex items-center gap-2 mt-1">

                    <span class="mono text-[8px] text-white/25">
                        10 AUG 2026
                    </span>

                    <span class="text-white/15">
                        /
                    </span>

                    <span class="mono text-[8px] text-white/25">
                        18:00
                    </span>

                </div>

            </div>


            <span class="px-2 py-1 bg-red-500/10 text-red-400 text-[7px] uppercase tracking-[1px]">
                LIVE
            </span>

        </div>


        <!-- Save status -->
        <div class="px-5 flex items-center gap-5">

            <div class="flex items-center gap-2">

                <span id="saveDot" class="w-1.5 h-1.5 bg-green-500"></span>

                <span id="saveStatus" class="text-[8px] uppercase tracking-[1px] text-white/30">
                    Saved
                </span>

            </div>


            <div class="h-6 w-px bg-white/10"></div>


            <button
                class="text-[9px] uppercase tracking-[1px] text-white/35 hover:text-white">
                Preview
            </button>


            <button
                onclick="openController()"
                class="h-8 px-4 bg-white text-black text-[8px] uppercase tracking-[1.5px] font-bold">
                Controller
            </button>


            <button
                class="text-white/30 hover:text-white text-lg">
                •••
            </button>

        </div>

    </header>


    <!-- WORKSPACE -->
    <div class="flex flex-1 min-h-0">


        <!-- RUN ORDER -->
        <aside class="w-[300px] shrink-0 border-r border-white/10 bg-[#151719] flex flex-col">

            <div class="h-[58px] shrink-0 px-4 border-b border-white/10 flex items-center justify-between">

                <div>

                    <div class="text-[9px] uppercase tracking-[2px] text-white/25">
                        Run Order
                    </div>

                    <div class="text-[10px] text-white/60 mt-1">
                        18 Items · 28:42
                    </div>

                </div>


                <button
                    onclick="addStory()"
                    class="w-8 h-8 border border-white/10 text-white/40 hover:text-white hover:border-white/30 text-lg">
                    +
                </button>

            </div>


            <!-- Rundown list -->
            <div class="flex-1 overflow-y-auto scrollbar">


                <!-- Opening -->
                <div class="story-item border-b border-white/10 px-4 py-3">

                    <div class="flex items-start gap-3">

                        <span class="mono text-[9px] text-white/20 w-5 pt-0.5">
                            01
                        </span>

                        <div class="flex-1 min-w-0">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-white/25">
                                    INTRO
                                </span>

                                <span class="mono text-[8px] text-white/20">
                                    00:25
                                </span>

                            </div>

                            <div class="text-xs mt-1 text-white/50">
                                Opening Headlines
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Completed -->
                <div class="story-item border-b border-white/10 px-4 py-3">

                    <div class="flex items-start gap-3">

                        <span class="mono text-[9px] text-white/20 w-5 pt-0.5">
                            02
                        </span>

                        <div class="flex-1 min-w-0">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-white/25">
                                    POLITICS
                                </span>

                                <span class="mono text-[8px] text-white/20">
                                    01:42
                                </span>

                            </div>

                            <div class="text-xs mt-1 text-white/40">
                                Parliament approves new bill
                            </div>

                            <div class="mt-2 text-[7px] uppercase tracking-[1px] text-white/20">
                                Completed
                            </div>

                        </div>

                    </div>

                </div>


                <!-- ON AIR -->
                <div
                    onclick="selectStory(this)"
                    class="story-item border-l-2 border-red-500 border-b border-white/10 px-4 py-4 bg-white/[0.06]">

                    <div class="flex items-start gap-3">

                        <span class="mono text-[9px] text-red-400 w-5 pt-0.5">
                            03
                        </span>

                        <div class="flex-1 min-w-0">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-red-400">
                                    POLITICS
                                </span>

                                <span class="mono text-[8px] text-white/30">
                                    02:15
                                </span>

                            </div>

                            <div class="text-xs mt-1 font-semibold">
                                Government announces new development project
                            </div>

                            <div class="mt-2 flex items-center gap-2">

                                <span class="w-1.5 h-1.5 bg-red-500 animate-pulse"></span>

                                <span class="text-[7px] uppercase tracking-[1px] text-red-400">
                                    On Air
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Ready -->
                <div class="story-item border-b border-white/10 px-4 py-3">

                    <div class="flex items-start gap-3">

                        <span class="mono text-[9px] text-white/20 w-5 pt-0.5">
                            04
                        </span>

                        <div class="flex-1 min-w-0">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-white/25">
                                    BUSINESS
                                </span>

                                <span class="mono text-[8px] text-white/20">
                                    01:40
                                </span>

                            </div>

                            <div class="text-xs mt-1 text-white/60">
                                New regulations announced for businesses
                            </div>

                            <div class="mt-2 text-[7px] uppercase tracking-[1px] text-green-500">
                                Ready
                            </div>

                        </div>

                    </div>

                </div>


                <div class="story-item border-b border-white/10 px-4 py-3">

                    <div class="flex items-start gap-3">

                        <span class="mono text-[9px] text-white/20 w-5 pt-0.5">
                            05
                        </span>

                        <div class="flex-1 min-w-0">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-white/25">
                                    SPORTS
                                </span>

                                <span class="mono text-[8px] text-white/20">
                                    02:05
                                </span>

                            </div>

                            <div class="text-xs mt-1 text-white/60">
                                Maldives prepares for regional tournament
                            </div>

                            <div class="mt-2 text-[7px] uppercase tracking-[1px] text-green-500">
                                Ready
                            </div>

                        </div>

                    </div>

                </div>


                <div class="story-item border-b border-white/10 px-4 py-3">

                    <div class="flex items-start gap-3">

                        <span class="mono text-[9px] text-white/20 w-5 pt-0.5">
                            06
                        </span>

                        <div class="flex-1 min-w-0">

                            <div class="flex items-center justify-between">

                                <span class="text-[8px] uppercase tracking-[1px] text-white/25">
                                    WEATHER
                                </span>

                                <span class="mono text-[8px] text-white/20">
                                    01:10
                                </span>

                            </div>

                            <div class="text-xs mt-1 text-white/60">
                                Weather forecast
                            </div>

                        </div>

                    </div>

                </div>


                <!-- More -->
                <div class="px-4 py-5 text-center">

                    <span class="text-[8px] uppercase tracking-[2px] text-white/15">
                        + 12 more items
                    </span>

                </div>

            </div>


            <!-- Add -->
            <div class="p-3 border-t border-white/10">

                <button
                    onclick="addStory()"
                    class="w-full h-9 border border-white/10 text-[8px] uppercase tracking-[1.5px] text-white/35 hover:text-white hover:border-white/30">

                    + Add Item

                </button>

            </div>

        </aside>


        <!-- STORY EDITOR -->
        <section class="flex-1 min-w-0 flex flex-col bg-[#111315]">


            <!-- Story toolbar -->
            <div class="h-[58px] shrink-0 border-b border-white/10 px-6 flex items-center justify-between">

                <div class="flex items-center gap-3">

                    <span class="mono text-[9px] text-white/20">
                        STORY 03
                    </span>

                    <span class="text-white/15">
                        /
                    </span>

                    <span class="text-[9px] uppercase tracking-[1.5px] text-white/40">
                        Politics
                    </span>

                </div>


                <div class="flex items-center gap-4">

                    <button class="text-[8px] uppercase tracking-[1px] text-white/30 hover:text-white">
                        Duplicate
                    </button>

                    <button class="text-[8px] uppercase tracking-[1px] text-white/30 hover:text-white">
                        Move
                    </button>

                    <button class="text-[8px] uppercase tracking-[1px] text-red-400/60 hover:text-red-400">
                        Remove
                    </button>

                </div>

            </div>


            <!-- Editor -->
            <div class="flex-1 overflow-y-auto scrollbar px-10 py-8">

                <div class="max-w-[850px] mx-auto">


                    <!-- Headline -->
                    <div class="mb-8">

                        <label class="block text-[9px] uppercase tracking-[2px] text-white/25 mb-3">
                            Headline
                        </label>

                        <input
                            type="text"
                            value="Government announces new development project"
                            class="w-full bg-transparent border-0 border-b border-white/10 pb-4 text-2xl font-bold tracking-[-0.5px] text-white focus:border-white/40"
                        >

                    </div>


                    <!-- Meta -->
                    <div class="grid grid-cols-3 gap-4 mb-8">

                        <div>

                            <label class="block text-[8px] uppercase tracking-[2px] text-white/25 mb-2">
                                Reporter
                            </label>

                            <input
                                type="text"
                                value="Hussain"
                                class="w-full h-9 px-3 bg-[#17191b] border border-white/10 text-xs text-white/70 focus:border-white/30"
                            >

                        </div>


                        <div>

                            <label class="block text-[8px] uppercase tracking-[2px] text-white/25 mb-2">
                                Category
                            </label>

                            <select
                                class="w-full h-9 px-3 bg-[#17191b] border border-white/10 text-xs text-white/70">

                                <option>Politics</option>
                                <option>Business</option>
                                <option>Sports</option>
                                <option>Local</option>

                            </select>

                        </div>


                        <div>

                            <label class="block text-[8px] uppercase tracking-[2px] text-white/25 mb-2">
                                Duration
                            </label>

                            <input
                                type="text"
                                value="02:15"
                                class="w-full h-9 px-3 bg-[#17191b] border border-white/10 text-xs text-white/70 focus:border-white/30"
                            >

                        </div>

                    </div>


                    <!-- Script -->
                    <div class="mb-8">

                        <div class="flex items-center justify-between mb-3">

                            <label class="text-[9px] uppercase tracking-[2px] text-white/25">
                                Teleprompter Script
                            </label>

                            <span class="mono text-[8px] text-white/20">
                                326 WORDS
                            </span>

                        </div>


                        <textarea
                            rows="18"
                            class="w-full resize-none bg-[#17191b] border border-white/10 p-5 text-sm leading-7 text-white/75 focus:border-white/30"
                        >The government has announced a new development project aimed at improving public services across the country.

Officials said the project will focus on upgrading existing facilities and introducing new services for communities.

The announcement was made during a press conference held in Malé today.

Authorities said further details about the project will be released in the coming weeks.

The government expects the first phase of the project to begin later this year.</textarea>

                    </div>


                    <!-- Notes -->
                    <div>

                        <label class="block text-[9px] uppercase tracking-[2px] text-white/25 mb-3">
                            Producer Notes
                        </label>

                        <textarea
                            rows="4"
                            placeholder="Add notes for presenter or producer..."
                            class="w-full resize-none bg-[#17191b] border border-white/10 p-4 text-xs leading-6 text-white/60 placeholder:text-white/15 focus:border-white/30"
                        ></textarea>

                    </div>

                </div>

            </div>


            <!-- Bottom save -->
            <div class="h-[58px] shrink-0 border-t border-white/10 px-6 flex items-center justify-between">

                <div class="text-[8px] text-white/20">
                    Last edited by Hussain · 12:29:08
                </div>

                <div class="flex items-center gap-3">

                    <button class="h-9 px-4 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/40 hover:text-white">
                        Save Draft
                    </button>

                    <button class="h-9 px-5 bg-white text-black text-[8px] uppercase tracking-[1.5px] font-bold">
                        Mark Ready
                    </button>

                </div>

            </div>

        </section>


        <!-- RIGHT CONTROL PANEL -->
        <aside class="w-[310px] shrink-0 border-l border-white/10 bg-[#151719] flex flex-col overflow-y-auto scrollbar">


            <!-- AIR STATUS -->
            <div class="p-5 border-b border-white/10">

                <div class="flex items-center justify-between mb-4">

                    <span class="text-[9px] uppercase tracking-[2px] text-white/25">
                        Air Status
                    </span>

                    <div class="flex items-center gap-2">

                        <span class="w-1.5 h-1.5 bg-red-500 animate-pulse"></span>

                        <span class="text-[8px] uppercase text-red-400 tracking-[1px]">
                            On Air
                        </span>

                    </div>

                </div>


                <div class="text-xs font-bold leading-5">
                    Government announces new development project
                </div>


                <div class="grid grid-cols-2 gap-2 mt-5">

                    <button class="h-9 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/40 hover:text-white">
                        Preview
                    </button>

                    <button class="h-9 bg-white text-black text-[8px] uppercase tracking-[1px] font-bold">
                        Send to Air
                    </button>

                </div>

            </div>


            <!-- CG -->
            <div class="p-5 border-b border-white/10">

                <div class="flex items-center justify-between mb-4">

                    <span class="text-[9px] uppercase tracking-[2px] text-white/25">
                        Graphics / CG
                    </span>

                    <span class="text-[8px] text-green-500 uppercase tracking-[1px]">
                        Ready
                    </span>

                </div>


                <div class="space-y-3">


                    <div class="border border-white/10 bg-[#111315] p-3">

                        <div class="flex justify-between items-start">

                            <div>

                                <div class="text-[8px] uppercase tracking-[1px] text-white/25">
                                    Lower Third
                                </div>

                                <div class="text-xs mt-2">
                                    Government announces new project
                                </div>

                            </div>

                            <button class="text-[9px] text-white/25 hover:text-white">
                                ✕
                            </button>

                        </div>

                        <div class="mt-3 text-[8px] text-white/25">
                            ACTIVE
                        </div>

                    </div>


                    <button class="w-full h-9 border border-dashed border-white/10 text-[8px] uppercase tracking-[1px] text-white/25 hover:text-white hover:border-white/30">
                        + Add CG
                    </button>

                </div>

            </div>


            <!-- STORY STATE -->
            <div class="p-5 border-b border-white/10">

                <div class="text-[9px] uppercase tracking-[2px] text-white/25 mb-4">
                    Story State
                </div>


                <div class="grid grid-cols-2 gap-2">

                    <button class="h-9 bg-green-500/10 border border-green-500/20 text-green-500 text-[8px] uppercase tracking-[1px]">
                        Ready
                    </button>

                    <button class="h-9 border border-white/10 text-white/30 text-[8px] uppercase tracking-[1px]">
                        Hold
                    </button>

                    <button class="h-9 border border-white/10 text-white/30 text-[8px] uppercase tracking-[1px]">
                        Complete
                    </button>

                    <button class="h-9 border border-red-500/20 text-red-400 text-[8px] uppercase tracking-[1px]">
                        Breaking
                    </button>

                </div>

            </div>


            <!-- TIMING -->
            <div class="p-5 border-b border-white/10">

                <div class="text-[9px] uppercase tracking-[2px] text-white/25 mb-4">
                    Timing
                </div>


                <div class="flex justify-between mb-3">

                    <span class="text-[9px] text-white/30">
                        Story duration
                    </span>

                    <span class="mono text-[10px]">
                        02:15
                    </span>

                </div>


                <div class="h-1 bg-white/10">

                    <div class="h-full bg-white/50 w-[38%]"></div>

                </div>


                <div class="flex justify-between mt-3">

                    <span class="mono text-[8px] text-white/20">
                        00:00
                    </span>

                    <span class="mono text-[8px] text-white/20">
                        02:15
                    </span>

                </div>

            </div>


            <!-- TELEPROMPTER -->
            <div class="p-5">

                <div class="flex items-center justify-between mb-4">

                    <span class="text-[9px] uppercase tracking-[2px] text-white/25">
                        Teleprompter
                    </span>

                    <span class="flex items-center gap-2 text-[8px] text-green-500 uppercase">

                        <span class="w-1.5 h-1.5 bg-green-500"></span>

                        Connected

                    </span>

                </div>


                <div class="grid grid-cols-2 gap-2">

                    <div class="border border-white/10 p-3">

                        <div class="text-[8px] uppercase text-white/20">
                            Speed
                        </div>

                        <div class="mono text-sm mt-2">
                            2.5
                        </div>

                    </div>


                    <div class="border border-white/10 p-3">

                        <div class="text-[8px] uppercase text-white/20">
                            Position
                        </div>

                        <div class="mono text-sm mt-2">
                            42%
                        </div>

                    </div>

                </div>


                <button
                    onclick="openController()"
                    class="w-full h-9 mt-3 border border-white/10 text-[8px] uppercase tracking-[1.5px] text-white/40 hover:text-white hover:border-white/30">

                    Open Teleprompter Controller

                </button>

            </div>

        </aside>

    </div>

</div>


<script>

    function selectStory(element) {

        document.querySelectorAll(".story-item").forEach(item => {
            item.classList.remove("bg-white/[0.06]", "border-l-2", "border-red-500");
        });

        element.classList.add(
            "bg-white/[0.06]",
            "border-l-2",
            "border-red-500"
        );

        markUnsaved();

    }


    function markUnsaved() {

        document.getElementById("saveDot").className =
            "w-1.5 h-1.5 bg-yellow-500";

        document.getElementById("saveStatus").textContent =
            "Unsaved";

    }


    function addStory() {

        alert("Add story modal would open here.");

    }


    function openController() {

        window.location.href = "/controller";

    }

</script>

</body>
</html>