<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AirCue | Live Insert</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #101213;
            color: #f4f4f4;
            font-family: Arial, Helvetica, sans-serif;
        }

        .mono {
            font-family: "Courier New", monospace;
        }

        textarea,
        input,
        select {
            outline: none;
        }

        textarea::-webkit-scrollbar {
            width: 5px;
        }

        textarea::-webkit-scrollbar-thumb {
            background: #34383b;
        }

        .scrollbar::-webkit-scrollbar {
            width: 5px;
        }

        .scrollbar::-webkit-scrollbar-thumb {
            background: #34383b;
        }
    </style>
</head>

<body class="h-screen overflow-hidden">

<div class="h-screen flex flex-col">


    <!-- TOP BAR -->

    <header class="h-[64px] shrink-0 bg-[#17191b] border-b border-white/10 flex items-center">

        <div class="w-[220px] h-full border-r border-white/10 px-5 flex items-center">

            <div class="flex items-center gap-3">

                <div class="w-8 h-8 border border-white/30 flex items-center justify-center">

                    <div class="w-3.5 h-3.5 bg-white"></div>

                </div>

                <div>

                    <div class="font-bold">
                        AirCue
                    </div>

                    <div class="text-[7px] uppercase tracking-[2px] text-white/25">
                        Live Insert
                    </div>

                </div>

            </div>

        </div>


        <div class="flex-1 px-6">

            <div class="text-sm font-bold">
                Evening News
            </div>

            <div class="mono text-[8px] text-white/25 mt-1">
                10 AUG 2026 / 18:00
            </div>

        </div>


        <div class="px-6 flex items-center gap-5">

            <div class="flex items-center gap-2">

                <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>

                <span class="text-[8px] uppercase tracking-[1px] text-red-400">
                    On Air
                </span>

            </div>

            <div class="h-6 w-px bg-white/10"></div>

            <div class="flex items-center gap-2">

                <span class="w-2 h-2 bg-green-500 rounded-full"></span>

                <span class="text-[8px] uppercase tracking-[1px] text-green-500">
                    Connected
                </span>

            </div>

        </div>

    </header>


    <!-- WORKSPACE -->

    <div class="flex flex-1 min-h-0">


        <!-- LEFT: CURRENT AIR -->

        <aside class="w-[300px] shrink-0 bg-[#151719] border-r border-white/10 flex flex-col">

            <div class="p-5 border-b border-white/10">

                <div class="text-[9px] uppercase tracking-[2px] text-white/25">
                    Currently On Air
                </div>

                <div class="mt-5">

                    <div class="flex items-center gap-2">

                        <span class="w-1.5 h-1.5 bg-red-500 rounded-full animate-pulse"></span>

                        <span class="text-[8px] uppercase tracking-[1px] text-red-400">
                            Story 08
                        </span>

                    </div>

                    <div class="text-sm font-bold leading-5 mt-3">
                        Government announces new development project
                    </div>

                    <div class="mono text-[9px] text-white/25 mt-3">
                        01:24 / 02:15
                    </div>

                </div>

            </div>


            <div class="p-5 border-b border-white/10">

                <div class="text-[9px] uppercase tracking-[2px] text-white/25 mb-4">
                    Next
                </div>

                <div class="border border-white/10 p-4">

                    <div class="text-[8px] uppercase tracking-[1px] text-green-500">
                        Story 09
                    </div>

                    <div class="text-xs mt-2 leading-5">
                        New regulations announced for businesses
                    </div>

                    <div class="mono text-[8px] text-white/20 mt-3">
                        01:40
                    </div>

                </div>

            </div>


            <div class="flex-1 p-5">

                <div class="text-[9px] uppercase tracking-[2px] text-white/25 mb-4">
                    Insert Behaviour
                </div>


                <div class="space-y-3">


                    <label class="flex gap-3 cursor-pointer">

                        <input
                            type="radio"
                            name="insertType"
                            value="interrupt"
                            checked
                            class="mt-1 accent-red-500"
                        >

                        <div>

                            <div class="text-[10px]">
                                Interrupt current story
                            </div>

                            <div class="text-[8px] text-white/25 mt-1 leading-4">
                                Send the breaking item immediately.
                            </div>

                        </div>

                    </label>


                    <label class="flex gap-3 cursor-pointer">

                        <input
                            type="radio"
                            name="insertType"
                            value="after"
                            class="mt-1 accent-red-500"
                        >

                        <div>

                            <div class="text-[10px]">
                                Play after current story
                            </div>

                            <div class="text-[8px] text-white/25 mt-1 leading-4">
                                Add it after the current item.
                            </div>

                        </div>

                    </label>


                    <label class="flex gap-3 cursor-pointer">

                        <input
                            type="radio"
                            name="insertType"
                            value="rundown"
                            class="mt-1 accent-red-500"
                        >

                        <div>

                            <div class="text-[10px]">
                                Add to rundown
                            </div>

                            <div class="text-[8px] text-white/25 mt-1 leading-4">
                                Save it without taking it to air.
                            </div>

                        </div>

                    </label>

                </div>

            </div>


            <div class="p-4 border-t border-white/10">

                <button
                    onclick="cancelInsert()"
                    class="w-full h-9 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/35 hover:text-white">
                    Cancel
                </button>

            </div>

        </aside>


        <!-- CENTER -->

        <main class="flex-1 min-w-0 flex flex-col">


            <div class="h-[62px] shrink-0 px-7 border-b border-white/10 flex items-center justify-between">

                <div>

                    <div class="text-[9px] uppercase tracking-[2px] text-red-400">
                        Breaking / Live Insert
                    </div>

                    <div class="text-[10px] text-white/30 mt-1">
                        Create a new presenter item
                    </div>

                </div>


                <div class="flex items-center gap-3">

                    <span
                        id="draftStatus"
                        class="text-[8px] uppercase tracking-[1px] text-yellow-500">
                        Draft
                    </span>

                    <div class="w-1 h-1 bg-white/20"></div>

                    <span class="mono text-[8px] text-white/20">
                        AUTO SAVE ON
                    </span>

                </div>

            </div>


            <div class="flex-1 overflow-y-auto scrollbar p-8">

                <div class="max-w-[850px] mx-auto">


                    <!-- ALERT -->

                    <div class="border border-red-500/20 bg-red-500/[0.04] p-4 mb-8">

                        <div class="flex items-start gap-3">

                            <div class="w-7 h-7 bg-red-500/10 flex items-center justify-center shrink-0">

                                <span class="text-red-400 text-xs">
                                    !
                                </span>

                            </div>

                            <div>

                                <div class="text-[9px] uppercase tracking-[1.5px] text-red-400">
                                    Live Insert
                                </div>

                                <div class="text-[9px] text-white/30 mt-2 leading-4">
                                    This item can be sent directly to the presenter.
                                    Check the script before sending it to air.
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- TITLE -->

                    <div class="mb-7">

                        <label class="block text-[9px] uppercase tracking-[2px] text-white/25 mb-3">
                            Headline
                        </label>

                        <input
                            id="headline"
                            type="text"
                            placeholder="Enter breaking news headline..."
                            class="w-full h-12 px-4 bg-[#17191b] border border-white/10 text-base font-bold placeholder:text-white/15 focus:border-red-500/40"
                            oninput="updateStatus()"
                        >

                    </div>


                    <!-- CATEGORY -->

                    <div class="grid grid-cols-2 gap-4 mb-7">

                        <div>

                            <label class="block text-[9px] uppercase tracking-[2px] text-white/25 mb-3">
                                Category
                            </label>

                            <select
                                class="w-full h-10 px-3 bg-[#17191b] border border-white/10 text-xs text-white/70">

                                <option>Breaking News</option>
                                <option>Politics</option>
                                <option>Local</option>
                                <option>Business</option>
                                <option>Sports</option>
                                <option>Weather</option>

                            </select>

                        </div>


                        <div>

                            <label class="block text-[9px] uppercase tracking-[2px] text-white/25 mb-3">
                                Estimated Duration
                            </label>

                            <input
                                type="text"
                                value="01:00"
                                class="w-full h-10 px-3 bg-[#17191b] border border-white/10 text-xs mono text-white/60"
                            >

                        </div>

                    </div>


                    <!-- SCRIPT -->

                    <div class="mb-7">

                        <div class="flex items-center justify-between mb-3">

                            <label class="text-[9px] uppercase tracking-[2px] text-white/25">
                                Presenter Script
                            </label>

                            <span
                                id="wordCount"
                                class="mono text-[8px] text-white/20">
                                0 WORDS
                            </span>

                        </div>


                        <textarea
                            id="script"
                            rows="15"
                            placeholder="Type the breaking news script here..."
                            class="w-full resize-none bg-[#17191b] border border-white/10 p-5 text-sm leading-7 text-white/75 placeholder:text-white/15 focus:border-red-500/30"
                            oninput="updateWordCount(); updateStatus();"
                        ></textarea>

                    </div>


                    <!-- PRODUCER NOTE -->

                    <div class="mb-7">

                        <label class="block text-[9px] uppercase tracking-[2px] text-white/25 mb-3">
                            Producer Note
                        </label>

                        <textarea
                            rows="4"
                            placeholder="Optional instructions for presenter..."
                            class="w-full resize-none bg-[#17191b] border border-white/10 p-4 text-xs leading-6 text-white/60 placeholder:text-white/15 focus:border-white/30"
                        ></textarea>

                    </div>


                    <!-- CG -->

                    <div class="border-t border-white/10 pt-7">

                        <div class="flex items-center justify-between mb-5">

                            <div>

                                <div class="text-[9px] uppercase tracking-[2px] text-white/25">
                                    Breaking CG
                                </div>

                                <div class="text-[8px] text-white/20 mt-1">
                                    Lower third displayed while this item is active.
                                </div>

                            </div>


                            <label class="flex items-center gap-2 cursor-pointer">

                                <input
                                    id="cgEnabled"
                                    type="checkbox"
                                    checked
                                    class="accent-red-500 w-4 h-4"
                                >

                                <span class="text-[8px] uppercase tracking-[1px] text-white/40">
                                    Enable
                                </span>

                            </label>

                        </div>


                        <div class="grid grid-cols-2 gap-4">

                            <div>

                                <label class="block text-[8px] uppercase tracking-[1px] text-white/25 mb-2">
                                    Primary Text
                                </label>

                                <input
                                    id="cgPrimary"
                                    type="text"
                                    placeholder="Breaking headline"
                                    class="w-full h-10 px-3 bg-[#17191b] border border-white/10 text-xs"
                                >

                            </div>


                            <div>

                                <label class="block text-[8px] uppercase tracking-[1px] text-white/25 mb-2">
                                    Secondary Text
                                </label>

                                <input
                                    id="cgSecondary"
                                    type="text"
                                    placeholder="Location / source"
                                    class="w-full h-10 px-3 bg-[#17191b] border border-white/10 text-xs"
                                >

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->

            <div class="h-[70px] shrink-0 border-t border-white/10 px-7 flex items-center justify-between">


                <div>

                    <div class="text-[8px] uppercase tracking-[1px] text-white/20">
                        Destination
                    </div>

                    <div class="flex items-center gap-2 mt-2">

                        <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>

                        <span class="text-[9px] text-white/50">
                            Presenter Teleprompter
                        </span>

                    </div>

                </div>


                <div class="flex items-center gap-3">

                    <button
                        onclick="saveDraft()"
                        class="h-10 px-5 border border-white/10 text-[8px] uppercase tracking-[1.5px] text-white/40 hover:text-white">
                        Save Draft
                    </button>


                    <button
                        onclick="sendToAir()"
                        class="h-10 px-7 bg-red-600 hover:bg-red-500 text-white text-[8px] uppercase tracking-[1.5px] font-bold">
                        Send To Air
                    </button>

                </div>

            </div>

        </main>


        <!-- RIGHT PREVIEW -->

        <aside class="w-[330px] shrink-0 bg-[#151719] border-l border-white/10 flex flex-col">


            <div class="h-[58px] shrink-0 px-5 border-b border-white/10 flex items-center justify-between">

                <span class="text-[9px] uppercase tracking-[2px] text-white/25">
                    Presenter Preview
                </span>

                <span class="text-[8px] text-green-500 uppercase">
                    Live
                </span>

            </div>


            <div class="flex-1 p-5">

                <div class="h-full min-h-[500px] bg-black border border-white/10 relative overflow-hidden">

                    <div class="absolute top-4 left-4 right-4 flex justify-between">

                        <span class="text-[6px] uppercase tracking-[1px] text-white/20">
                            AirCue
                        </span>

                        <span class="text-[6px] uppercase tracking-[1px] text-red-400">
                            Breaking
                        </span>

                    </div>


                    <div class="absolute left-6 right-6 top-[35%]">

                        <div
                            id="previewHeadline"
                            class="text-xl font-bold leading-7">
                            Breaking headline
                        </div>

                        <div class="mt-7 text-sm leading-6 text-white/70">

                            Your presenter script will appear
                            on the teleprompter here.

                        </div>

                    </div>


                    <div class="absolute bottom-5 left-5 right-5">

                        <div class="h-px bg-white/10 mb-3"></div>

                        <div class="flex justify-between">

                            <span class="text-[6px] uppercase tracking-[1px] text-white/20">
                                Breaking News
                            </span>

                            <span class="mono text-[7px] text-white/20">
                                18:00
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <div class="p-4 border-t border-white/10">

                <div class="flex items-center justify-between">

                    <span class="text-[8px] uppercase tracking-[1px] text-white/25">
                        Controller
                    </span>

                    <span class="flex items-center gap-2 text-[8px] text-green-500">

                        <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>

                        Connected

                    </span>

                </div>

            </div>

        </aside>

    </div>

</div>


<!-- SEND TO AIR CONFIRMATION -->

<div
    id="confirmModal"
    class="hidden fixed inset-0 z-50 bg-black/80 items-center justify-center">

    <div class="w-[420px] bg-[#181a1c] border border-white/10">

        <div class="p-6 border-b border-white/10">

            <div class="text-[9px] uppercase tracking-[2px] text-red-400">
                Confirm Live Insert
            </div>

            <div class="text-lg font-bold mt-3">
                Send this item to air?
            </div>

            <div class="text-[9px] text-white/30 mt-3 leading-5">
                The presenter will immediately receive this item.
                The current story may be interrupted.
            </div>

        </div>


        <div class="p-5 flex justify-end gap-3">

            <button
                onclick="closeModal()"
                class="h-9 px-5 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/40">
                Cancel
            </button>

            <button
                onclick="confirmSend()"
                class="h-9 px-6 bg-red-600 text-[8px] uppercase tracking-[1px] font-bold">
                Confirm
            </button>

        </div>

    </div>

</div>


<script>

    function updateWordCount() {

        const text =
            document.getElementById("script").value.trim();

        const words =
            text ? text.split(/\s+/).length : 0;

        document.getElementById("wordCount").textContent =
            `${words} WORDS`;

    }


    function updateStatus() {

        document.getElementById("draftStatus").textContent =
            "Unsaved";

        document.getElementById("draftStatus").className =
            "text-[8px] uppercase tracking-[1px] text-yellow-500";


        const headline =
            document.getElementById("headline").value;

        document.getElementById("previewHeadline").textContent =
            headline || "Breaking headline";

    }


    function saveDraft() {

        document.getElementById("draftStatus").textContent =
            "Saved";

        document.getElementById("draftStatus").className =
            "text-[8px] uppercase tracking-[1px] text-green-500";


        /*
            Socket.IO example:

            socket.emit("breaking:create", {
                runOrderId,
                headline,
                script,
                category,
                duration,
                cg
            });
        */

    }


    function sendToAir() {

        const headline =
            document.getElementById("headline").value.trim();

        const script =
            document.getElementById("script").value.trim();


        if (!headline || !script) {

            alert("Add a headline and presenter script first.");

            return;

        }


        document.getElementById("confirmModal")
            .classList.remove("hidden");

        document.getElementById("confirmModal")
            .classList.add("flex");

    }


    function closeModal() {

        document.getElementById("confirmModal")
            .classList.add("hidden");

        document.getElementById("confirmModal")
            .classList.remove("flex");

    }


    function confirmSend() {

        closeModal();


        /*
            Socket.IO:

            socket.emit("breaking:send-to-air", {

                runOrderId,

                headline:
                    document.getElementById("headline").value,

                script:
                    document.getElementById("script").value,

                cg: {

                    enabled:
                        document.getElementById("cgEnabled").checked,

                    primary:
                        document.getElementById("cgPrimary").value,

                    secondary:
                        document.getElementById("cgSecondary").value

                }

            });
        */


        alert("Breaking item sent to presenter.");

    }


    function cancelInsert() {

        window.location.href = "/controller";

    }


    /*
        SOCKET.IO RECEIVING EXAMPLE

        socket.on("breaking:status", data => {

            if (data.status === "on-air") {

                // Update controller state.

            }

            if (data.status === "completed") {

                // Return to original story.

            }

        });

    */

</script>

</body>
</html>