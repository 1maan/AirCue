<script>

    let selectedStory = 1;

    let playing = false;

    let fontSize = 18;

    let lineHeight = 1.8;

    let margin = 12;


    function selectStory(id) {

        selectedStory = id;


        document
            .querySelectorAll(".story-item")
            .forEach(item => {

                item.classList.remove("story-active");

            });


        const selected =
            document.querySelector(
                `[data-story="${id}"]`
            );


        if (selected) {

            selected.classList.add(
                "story-active"
            );

        }


        /*
            REAL SOCKET.IO

            socket.emit("rundown:select", {
                storyId: id
            });

        */

    }


    function sendCommand(command) {

        if (command === "toggle") {

            playing = !playing;

            document.getElementById("playButton")
                .textContent =
                playing ? "Ⅱ" : "▶";

        }


        /*
            socket.emit("teleprompter:command", {

                command: command,

                storyId: selectedStory

            });

        */

    }


    function changeSpeed(value) {

        document.getElementById("speedText")
            .textContent = value;


        /*
            socket.emit("teleprompter:speed", {
                speed: Number(value)
            });
        */

    }


    function nudge(amount) {

        /*
            socket.emit("teleprompter:nudge", {
                amount: amount
            });
        */

    }


    function adjustFont(amount) {

        fontSize += amount;

        fontSize =
            Math.max(
                10,
                Math.min(
                    40,
                    fontSize
                )
            );


        /*
            socket.emit("teleprompter:settings", {
                fontSize
            });
        */

    }


    function changeLineHeight(amount) {

        lineHeight += amount;


        lineHeight =
            Math.max(
                1,
                Math.min(
                    2.5,
                    lineHeight
                )
            );


        /*
            socket.emit("teleprompter:settings", {
                lineHeight
            });
        */

    }


    function adjustMargin(amount) {

        margin += amount;


        margin =
            Math.max(
                5,
                Math.min(
                    30,
                    margin
                )
            );


        /*
            socket.emit("teleprompter:settings", {
                margin
            });
        */

    }


    function toggleMirror() {

