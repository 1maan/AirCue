    /*
        KEYBOARD SHORTCUTS

        SPACE       Play / Pause
        RIGHT       Next story
        LEFT        Previous story
        UP          Nudge up
        DOWN        Nudge down
        CTRL + G    Take CG
    */


    document.addEventListener(
        "keydown",
        event => {

            if (
                event.code === "Space" &&
                !event.target.matches("input")
            ) {

                event.preventDefault();

                sendCommand("toggle");

            }


            if (
                event.code === "ArrowRight" &&
                !event.target.matches("input")
            ) {

                sendCommand("next");

            }


            if (
                event.code === "ArrowLeft" &&
                !event.target.matches("input")
            ) {

                sendCommand("previous");

            }


            if (
                event.code === "ArrowUp" &&
                !event.target.matches("input")
            ) {

                nudge(-100);

            }


            if (
                event.code === "ArrowDown" &&
                !event.target.matches("input")
            ) {

                nudge(100);

            }


            if (
                event.ctrlKey &&
                event.code === "KeyG"
            ) {

                event.preventDefault();

                takeCG();

            }

        }
    );

</script>

