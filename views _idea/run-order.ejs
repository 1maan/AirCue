<script>

    let currentDate = new Date(2026, 7, 10);

    function formatDate(date) {

        const months = [
            "JAN", "FEB", "MAR", "APR", "MAY", "JUN",
            "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"
        ];

        return `${String(date.getDate()).padStart(2, "0")} ${months[date.getMonth()]} ${date.getFullYear()}`;
    }


    function changeDate(days) {

        currentDate.setDate(currentDate.getDate() + days);

        document.getElementById("dateLabel").textContent =
            formatDate(currentDate);

        // In your Node.js app, reload the run orders here.
        // Example:
        // window.location.href = `/runorders?date=${currentDate.toISOString().split("T")[0]}`;

    }


    function createRunOrder() {

        // Replace with your modal or route.
        window.location.href = "/runorders/new";

    }

</script>

