                    Live Events
                </div>


                <div class="space-y-3">


                    <div class="flex justify-between">

                        <span class="text-[8px] text-white/40">
                            teleprompter:scroll
                        </span>

                        <span class="mono text-[7px] text-white/20">
                            1 sec ago
                        </span>

                    </div>


                    <div class="flex justify-between">

                        <span class="text-[8px] text-white/40">
                            story:changed
                        </span>

                        <span class="mono text-[7px] text-white/20">
                            18 sec ago
                        </span>

                    </div>


                    <div class="flex justify-between">

                        <span class="text-[8px] text-white/40">
                            device:heartbeat
                        </span>

                        <span class="mono text-[7px] text-white/20">
                            2 sec ago
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <div class="p-5 border-t border-white/10 flex justify-end gap-3">

            <button
                onclick="sendPing()"
                class="h-9 px-5 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/40 hover:text-white">
                Send Ping
            </button>

            <button
                onclick="closeDevice()"
                class="h-9 px-6 bg-white text-black text-[8px] uppercase tracking-[1px] font-bold">
                Done
            </button>

        </div>

    </div>

</div>


<!-- PAIR DEVICE -->

<div
    id="pairModal"
    class="hidden fixed inset-0 z-50 bg-black/80 items-center justify-center">

    <div class="w-[430px] bg-[#181a1c] border border-white/10">


        <div class="p-6 border-b border-white/10">

            <div class="text-[8px] uppercase tracking-[2px] text-white/20">
                Device Pairing
            </div>

            <div class="text-lg font-bold mt-2">
                Pair a device
            </div>

        </div>


        <div class="p-6">


            <div class="border border-dashed border-white/10 p-8 text-center">

                <div class="text-3xl text-white/20">
                    ⌁
                </div>

                <div class="text-[10px] mt-4">
                    Enter pairing code
                </div>

                <div class="text-[7px] text-white/20 mt-2">
                    Generate this code from the AirCue device.
                </div>


                <input
                    id="pairCode"
                    maxlength="6"
                    placeholder="000000"
                    class="w-full h-12 mt-6 bg-[#111315] border border-white/10 text-center mono text-lg tracking-[6px]"
                >

            </div>

        </div>


        <div class="p-5 border-t border-white/10 flex justify-end gap-3">

            <button
                onclick="closePair()"
                class="h-9 px-5 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/40">
                Cancel
            </button>

            <button
                onclick="connectDevice()"
                class="h-9 px-6 bg-white text-black text-[8px] uppercase tracking-[1px] font-bold">
                Connect
            </button>

        </div>

    </div>

</div>


<script>

    let selectedDevice = null;


    function openDevice(name) {

        selectedDevice = name;

        document.getElementById("modalDeviceName")
            .textContent = name;

        document.getElementById("deviceModal")
            .classList.remove("hidden");

        document.getElementById("deviceModal")
            .classList.add("flex");

    }


    function closeDevice() {

        document.getElementById("deviceModal")
            .classList.add("hidden");

        document.getElementById("deviceModal")
            .classList.remove("flex");

    }


    function pairDevice() {

        document.getElementById("pairModal")
            .classList.remove("hidden");

        document.getElementById("pairModal")
            .classList.add("flex");

    }


    function closePair() {

        document.getElementById("pairModal")
            .classList.add("hidden");

        document.getElementById("pairModal")
            .classList.remove("flex");

    }


    function connectDevice() {

        const code =
            document.getElementById("pairCode").value;


        if (code.length !== 6) {

            alert("Enter a 6 digit pairing code.");

            return;

        }


        /*
            Real Socket.IO implementation:

            socket.emit("device:pair", {
                pairingCode: code
            });

        */


        closePair();

        alert("Pairing request sent.");

    }


    function disconnectDevice(name) {

        if (!confirm(
            "Disconnect " + name + "?"
        )) {

            return;

        }


        /*
            socket.emit("device:disconnect", {
                deviceId: name
            });
        */


        console.log(
            "Disconnecting:",
            name
        );

    }


    function sendPing() {

        if (!selectedDevice) {
            return;
        }


        /*
            socket.emit("device:ping", {
                deviceId: selectedDevice
            });
        */


        console.log(
            "Ping:",
            selectedDevice
        );

    }


    function filterDevices() {

        const search =
            document.getElementById("search")
                .value
                .toLowerCase();

        const type =
            document.getElementById("typeFilter")
                .value;

        const status =
            document.getElementById("statusFilter")
                .value;


        document
            .querySelectorAll(".device-card")
            .forEach(card => {

                const name =
                    card.dataset.name.toLowerCase();

                const cardType =
                    card.dataset.type;

                const cardStatus =
                    card.dataset.status;


                const matchSearch =
                    name.includes(search);

                const matchType =
                    type === "all" ||
                    cardType === type;

                const matchStatus =
                    status === "all" ||
                    cardStatus === status;


                card.style.display =
                    matchSearch &&
                    matchType &&
                    matchStatus
                        ? ""
                        : "none";

            });

    }


    function refreshDevices() {

        /*
            socket.emit("devices:list");

            socket.on("devices:list", devices => {

                // Re-render device cards

            });
        */


        document.getElementById("lastUpdate")
            .textContent = "just now";

    }


    /*
        REAL-TIME SOCKET.IO EXAMPLE

        socket.on("device:connected", device => {

            console.log(
                "Device connected:",
                device
            );

        });


        socket.on("device:disconnected", device => {

            console.log(
                "Device disconnected:",
                device
            );

        });


        socket.on("device:heartbeat", data => {

            console.log(
                "Heartbeat:",
                data
            );

        });


        socket.on("teleprompter:scroll", data => {

            console.log(
                "Scroll position:",
                data.position
            );

        });


        socket.on("story:changed", data => {

            console.log(
                "Story changed:",
                data.storyId
            );

        });


        socket.on("cg:take", data => {

            console.log(
                "CG taken:",
                data
            );

        });

    */

</script>

