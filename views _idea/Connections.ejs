                    <span class="text-[10px]">◉</span>

                    <span class="text-[9px]">
                        Users
                    </span>

                </button>


                <button
                    class="w-full h-9 px-3 flex items-center gap-3 bg-white/[0.06] border-l-2 border-white text-left">

                    <span class="text-[10px]">▣</span>

                    <span class="text-[9px]">
                        Devices
                    </span>

                </button>


                <button
                    onclick="location.href='/admin/logs'"
