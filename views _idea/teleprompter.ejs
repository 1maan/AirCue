<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AirCue | Presenter</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #000;
            color: #fff;
            font-family: Arial, Helvetica, sans-serif;
            overflow: hidden;
        }

        .mono {
            font-family: "Courier New", monospace;
        }

        #script {
            transform: translateY(0);
        }

        .script-text {
            font-size: 42px;
            line-height: 1.7;
            font-weight: 600;
        }

        .mirror {
            transform: scaleX(-1);
        }

        .safe-line {
            position: absolute;
            left: 0;
            right: 0;
            top: 28%;
            border-top: 1px solid rgba(255, 255, 255, 0.12);
        }
    </style>
</head>

<body>

<div id="screen" class="w-screen h-screen relative bg-black">


    <!-- TOP INFORMATION -->

    <div
        id="topBar"
        class="absolute top-0 left-0 right-0 h-16 px-7 flex items-center justify-between z-20
               bg-gradient-to-b from-black/80 to-transparent">

        <div class="flex items-center gap-4">

            <div class="w-7 h-7 border border-white/30 flex items-center justify-center">

                <div class="w-3 h-3 bg-white"></div>

            </div>

            <div>

                <div class="text-xs font-bold">
                    AirCue
                </div>

                <div class="text-[7px] uppercase tracking-[2px] text-white/30">
                    Presenter
                </div>

            </div>

        </div>


        <div class="flex items-center gap-6">


            <div class="text-right">

                <div class="text-[7px] uppercase tracking-[2px] text-white/25">
                    Bulletin
                </div>

                <div class="text-[10px]">
                    Evening News
                </div>

            </div>


            <div class="h-7 w-px bg-white/10"></div>


            <div class="text-right">

                <div class="text-[7px] uppercase tracking-[2px] text-white/25">
                    Story
                </div>

                <div class="mono text-[10px]">
                    08 / 18
                </div>

            </div>


            <div
                id="connection"
                class="flex items-center gap-2">

                <span class="w-2 h-2 bg-green-500 rounded-full"></span>

                <span class="text-[7px] uppercase tracking-[1px] text-white/40">
                    Connected
                </span>

            </div>

        </div>

    </div>


    <!-- SAFE AREA -->

    <div
        id="safeArea"
        class="absolute left-[8%] right-[8%] top-[28%] bottom-[12%]
               border-x border-white/[0.04] pointer-events-none z-10">

        <div class="safe-line"></div>

    </div>


    <!-- SCRIPT -->

    <main
        id="prompter"
        class="absolute inset-0 overflow-hidden">

        <div
            id="script"
            class="absolute top-0 left-[10%] right-[10%] pt-[38vh] pb-[100vh]">

            <div class="script-text max-w-[1100px] mx-auto">

                <p class="font-bold mb-14">
                    Government announces new development project
                </p>


                <p class="mb-12">
                    The government has announced a new development project
                    aimed at improving public services across the country.
                </p>


                <p class="mb-12">
                    Officials said the project will focus on upgrading
                    existing facilities and introducing new services
                    for communities.
                </p>


                <p class="mb-12">
                    The announcement was made during a press conference
                    held in Malé today.
                </p>


                <p class="mb-12">
                    Authorities said further details about the project
                    will be released in the coming weeks.
                </p>


                <p class="mb-12">
                    The government expects the first phase of the project
                    to begin later this year.
                </p>


                <p class="mb-12">
                    Officials have not yet provided a specific completion
                    date for the project.
                </p>


                <p class="mb-12">
                    More information is expected to be announced following
                    the completion of the initial planning process.
                </p>

            </div>

        </div>

    </main>


    <!-- CURRENT STORY -->

    <div
        id="storyInfo"
        class="absolute bottom-7 left-7 z-20
               text-[8px] uppercase tracking-[2px] text-white/30">

        POLITICS
        <span class="mx-2 text-white/10">/</span>
        GOVERNMENT

    </div>


    <!-- CLOCK -->

    <div
        id="clock"
        class="absolute bottom-7 right-7 z-20 mono text-[10px] text-white/30">
        18:00:00
    </div>


    <!-- ON AIR INDICATOR -->

    <div
        id="onAir"
        class="absolute top-7 left-1/2 -translate-x-1/2 z-30
               flex items-center gap-2">

        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>

        <span class="text-[8px] uppercase tracking-[2px] text-red-400">
            On Air
        </span>

    </div>


    <!-- BREAKING NEWS -->

    <div
        id="breaking"
        class="hidden absolute top-0 left-0 right-0 z-40
               bg-red-600 h-10 items-center justify-center">

        <span class="text-[10px] uppercase tracking-[3px] font-bold">
            Breaking News
        </span>

    </div>


    <!-- NEXT STORY -->

    <div
        id="nextStory"
        class="absolute bottom-7 left-1/2 -translate-x-1/2 z-20
               text-[7px] uppercase tracking-[2px] text-white/20">

        NEXT · BUSINESS

    </div>


    <!-- CONTROLLER DISCONNECTED -->

    <div
        id="disconnected"
        class="hidden absolute inset-0 bg-black/80 z-50
               items-center justify-center">

        <div class="text-center">

            <div class="w-3 h-3 bg-red-500 rounded-full mx-auto mb-5"></div>

            <div class="text-sm font-bold">
                Controller Disconnected
            </div>

            <div class="text-[9px] text-white/30 mt-2">
                Waiting for AirCue connection
            </div>

        </div>

    </div>

</div>


<script>

    /*
        PRESENTATION STATE
    */

    let playing = true;

    let speed = 2.5;

    let position = 0;

    let fontSize = 42;

    let lineHeight = 1.7;

    let sideMargin = 10;

    let mirror = false;

    let showSafeArea = false;


    /*
        APPLY SETTINGS
    */

    function applySettings(settings) {

        if (settings.speed !== undefined) {
            speed = settings.speed;
        }

        if (settings.fontSize !== undefined) {

            fontSize = settings.fontSize;

            document.querySelector(".script-text").style.fontSize =
                fontSize + "px";

        }

        if (settings.lineHeight !== undefined) {

            lineHeight = settings.lineHeight;

            document.querySelector(".script-text").style.lineHeight =
                lineHeight;

        }

        if (settings.sideMargin !== undefined) {

            sideMargin = settings.sideMargin;

            document.getElementById("script").style.left =
                sideMargin + "%";

            document.getElementById("script").style.right =
                sideMargin + "%";

        }

        if (settings.mirror !== undefined) {

            mirror = settings.mirror;

            document.getElementById("prompter")
                .classList.toggle("mirror", mirror);

        }

        if (settings.showSafeArea !== undefined) {

            showSafeArea = settings.showSafeArea;

            document.getElementById("safeArea").style.display =
                showSafeArea ? "block" : "none";

        }

    }


    /*
        STORY CHANGE
    */

    function loadStory(story) {

        document.querySelector(".script-text").innerHTML =
            story.script;

        document.getElementById("storyInfo").innerHTML =
            `${story.category}
             <span class="mx-2 text-white/10">/</span>
             ${story.slug}`;

        position = 0;

        updatePosition();

    }


    /*
        SCROLL
    */

    let lastTime = performance.now();

    function scrollLoop(time) {

        const delta = time - lastTime;

        if (playing) {

            position -= speed * delta / 30;

            updatePosition();

        }

        lastTime = time;

        requestAnimationFrame(scrollLoop);

    }


    function updatePosition() {

        document.getElementById("script").style.transform =
            `translateY(${position}px)`;

    }


    requestAnimationFrame(scrollLoop);


    /*
        CLOCK
    */

    function updateClock() {

        const now = new Date();

        const h = String(now.getHours()).padStart(2, "0");
        const m = String(now.getMinutes()).padStart(2, "0");
        const s = String(now.getSeconds()).padStart(2, "0");

        document.getElementById("clock").textContent =
            `${h}:${m}:${s}`;

    }

    setInterval(updateClock, 1000);

    updateClock();


    /*
        KEYBOARD SHORTCUTS

        Space = pause/play
        Arrow Up = faster
        Arrow Down = slower
        F = fullscreen
        R = reset
    */

    document.addEventListener("keydown", function(event) {

        if (event.code === "Space") {

            event.preventDefault();

            playing = !playing;

        }


        if (event.code === "ArrowUp") {

            speed += 0.2;

            if (speed > 5) speed = 5;

        }


        if (event.code === "ArrowDown") {

            speed -= 0.2;

            if (speed < 0) speed = 0;

        }


        if (event.key.toLowerCase() === "r") {

            position = 0;

            updatePosition();

        }


        if (event.key.toLowerCase() === "f") {

            if (!document.fullscreenElement) {

                document.documentElement.requestFullscreen();

            } else {

                document.exitFullscreen();

            }

        }

    });


    /*
        SOCKET.IO

        Replace the simulated state with this.

        const socket = io();

        socket.emit("presenter:join", {
            runOrderId: 1,
            presenterId: 1
        });


        socket.on("teleprompter:state", (state) => {

            playing = state.playing;

            speed = state.speed;

            position = state.position;

            updatePosition();

        });


        socket.on("teleprompter:settings", (settings) => {

            applySettings(settings);

        });


        socket.on("teleprompter:story", (story) => {

            loadStory(story);

        });


        socket.on("cg:state", (cg) => {

            // Show or hide CG on the presenter monitor
            // if required by your workflow.

        });


        socket.on("breaking-news", (data) => {

            document.getElementById("breaking")
                .classList.remove("hidden");

            document.getElementById("breaking")
                .classList.add("flex");

        });


        socket.on("controller:disconnect", () => {

            document.getElementById("disconnected")
                .classList.remove("hidden");

            document.getElementById("disconnected")
                .classList.add("flex");

        });


        socket.on("controller:connect", () => {

            document.getElementById("disconnected")
                .classList.add("hidden");

            document.getElementById("disconnected")
                .classList.remove("flex");

        });

    */

</script>

</body>
</html>