<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>AirCue | Newsroom</title>

    <!-- Outfit -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              outfit: ["Outfit", "sans-serif"]
            }
          }
        }
      }
    </script>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Outfit", sans-serif;
        background: #f5f5f5;
        color: #171717;
      }

      .mono {
        font-family: "Courier New", monospace;
      }

      .scrollbar::-webkit-scrollbar {
        width: 5px;
        height: 5px;
      }

      .scrollbar::-webkit-scrollbar-thumb {
        background: #d4d4d4;
        border-radius: 10px;
      }
    </style>
  </head>

  <body class="font-outfit">
    <div class="min-h-screen">
      <!-- TOP BAR -->
      <header class="h-[68px] border-b border-[#e5e5e5] bg-white">
        <div class="flex h-full items-center px-7">
          <!-- BRAND -->
          <div class="flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-[8px] bg-black">
              <div class="h-3.5 w-3.5 rounded-[2px] bg-white"></div>
            </div>

            <div>
              <div class="text-[17px] font-semibold tracking-[-0.5px]">AirCue</div>

              <div class="text-[9px] font-medium text-gray-400">Newsroom</div>
            </div>
          </div>

          <!-- NAV -->
          <nav class="ml-14 flex items-center gap-1">
            <a href="/dashboard" class="rounded-lg bg-[#f1f1f1] px-4 py-2 text-[12px] font-medium text-black"> Dashboard </a>

            <a href="/runorders" class="rounded-lg px-4 py-2 text-[12px] text-gray-500 hover:bg-gray-100 hover:text-black"> Run Orders </a>

            <a href="/stories" class="rounded-lg px-4 py-2 text-[12px] text-gray-500 hover:bg-gray-100 hover:text-black"> Stories </a>

            <a href="/controller" class="rounded-lg px-4 py-2 text-[12px] text-gray-500 hover:bg-gray-100 hover:text-black"> Teleprompter </a>

            <a href="/cg" class="rounded-lg px-4 py-2 text-[12px] text-gray-500 hover:bg-gray-100 hover:text-black"> Graphics </a>
          </nav>

          <!-- RIGHT -->
          <div class="ml-auto flex items-center gap-6">
            <!-- ON AIR -->
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-red-500"></span>

              <span class="text-[11px] font-medium text-red-500"> On Air </span>
            </div>

            <!-- CLOCK -->
            <div class="mono text-[12px] font-bold">
              <span id="clock">00:00:00</span>
            </div>

            <!-- USER -->
            <button class="flex h-9 w-9 items-center justify-center rounded-full bg-[#eeeeee] text-[10px] font-semibold">HI</button>
          </div>
        </div>
      </header>

      <!-- PAGE -->
      <main class="mx-auto max-w-[1600px] px-7 py-7">
        <!-- PAGE HEADER -->
        <div class="mb-7 flex items-end justify-between">
          <div>
            <h1 class="text-[26px] font-semibold tracking-[-0.8px]">Evening News</h1>

            <div class="mt-1 flex items-center gap-2 text-[12px] text-gray-400">
              <span>Today</span>

              <span>•</span>

              <span>19:00</span>

              <span>•</span>

              <span>6 stories</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button class="rounded-lg border border-[#dddddd] bg-white px-4 py-2 text-[11px] font-medium hover:bg-gray-50">Preview</button>

            <button class="rounded-lg bg-black px-4 py-2 text-[11px] font-medium text-white hover:bg-gray-800">Open Run Order</button>
          </div>
        </div>

        <!-- CONTENT -->
        <div class="grid grid-cols-[1fr_340px] gap-6">
          <!-- RUNDOWN -->
          <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
            <!-- HEADER -->
            <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4">
              <div>
                <div class="text-[14px] font-semibold">Rundown</div>

                <div class="mt-0.5 text-[11px] text-gray-400">Current evening bulletin</div>
              </div>

              <div class="flex items-center gap-2">
                <button class="rounded-lg border border-[#dddddd] px-3 py-1.5 text-[10px] font-medium hover:bg-gray-50">+ Story</button>

                <button class="rounded-lg border border-[#dddddd] px-3 py-1.5 text-[10px] font-medium hover:bg-gray-50">+ Break</button>
              </div>
            </div>

            <!-- TABLE HEADER -->
            <div class="grid grid-cols-[50px_1fr_100px_80px_80px] border-b border-[#eeeeee] bg-[#fafafa] px-5 py-2.5">
              <div class="text-[10px] font-medium text-gray-400">#</div>

              <div class="text-[10px] font-medium text-gray-400">Story</div>

              <div class="text-[10px] font-medium text-gray-400">Type</div>

              <div class="text-[10px] font-medium text-gray-400">Duration</div>

              <div class="text-right text-[10px] font-medium text-gray-400">Status</div>
            </div>

            <!-- STORIES -->
            <div class="scrollbar max-h-[580px] overflow-y-auto">
              <!-- ACTIVE -->
              <div class="grid grid-cols-[50px_1fr_100px_80px_80px] items-center border-b border-l-[3px] border-[#eeeeee] border-l-red-500 bg-red-50/40 px-5 py-4">
                <div class="text-[12px] font-medium text-gray-400">01</div>

                <div>
                  <div class="text-[13px] font-medium">Government announces new economic measures</div>

                  <div class="mt-1 text-[10px] text-gray-400">Lead story</div>
                </div>

                <div class="text-[10px] text-gray-500">VO / SOT</div>

                <div class="mono text-[10px] text-gray-500">01:42</div>

                <div class="text-right text-[10px] font-medium text-red-500">ON AIR</div>
              </div>

              <!-- STORY -->
              <div class="grid grid-cols-[50px_1fr_100px_80px_80px] items-center border-b border-[#eeeeee] px-5 py-4 hover:bg-gray-50">
                <div class="text-[12px] text-gray-400">02</div>

                <div>
                  <div class="text-[13px] font-medium">Weather update for the Maldives</div>

                  <div class="mt-1 text-[10px] text-gray-400">Weather package</div>
                </div>

                <div class="text-[10px] text-gray-500">PKG</div>

                <div class="mono text-[10px] text-gray-500">02:15</div>

                <div class="text-right text-[10px] font-medium text-green-600">READY</div>
              </div>

              <!-- STORY -->
              <div class="grid grid-cols-[50px_1fr_100px_80px_80px] items-center border-b border-[#eeeeee] px-5 py-4 hover:bg-gray-50">
                <div class="text-[12px] text-gray-400">03</div>

                <div>
                  <div class="text-[13px] font-medium">Parliament session continues today</div>

                  <div class="mt-1 text-[10px] text-gray-400">Live report</div>
                </div>

                <div class="text-[10px] text-gray-500">LIVE</div>

                <div class="mono text-[10px] text-gray-500">03:05</div>

                <div class="text-right text-[10px] font-medium text-blue-600">NEXT</div>
              </div>

              <!-- BREAK -->
              <div class="border-b border-[#eeeeee] bg-[#fafafa] px-5 py-3">
                <div class="flex items-center gap-3">
                  <div class="h-px flex-1 bg-gray-200"></div>

                  <span class="text-[9px] font-medium text-gray-400"> COMMERCIAL BREAK </span>

                  <div class="h-px flex-1 bg-gray-200"></div>
                </div>
              </div>

              <!-- STORY -->
              <div class="grid grid-cols-[50px_1fr_100px_80px_80px] items-center border-b border-[#eeeeee] px-5 py-4 hover:bg-gray-50">
                <div class="text-[12px] text-gray-400">04</div>

                <div>
                  <div class="text-[13px] font-medium">Sports roundup</div>

                  <div class="mt-1 text-[10px] text-gray-400">Sports desk</div>
                </div>

                <div class="text-[10px] text-gray-500">VO</div>

                <div class="mono text-[10px] text-gray-500">00:58</div>

                <div class="text-right text-[10px] font-medium text-gray-400">DRAFT</div>
              </div>

              <!-- STORY -->
              <div class="grid grid-cols-[50px_1fr_100px_80px_80px] items-center border-b border-[#eeeeee] px-5 py-4 hover:bg-gray-50">
                <div class="text-[12px] text-gray-400">05</div>

                <div>
                  <div class="text-[13px] font-medium">New developments in local transport</div>

                  <div class="mt-1 text-[10px] text-gray-400">Reporter package</div>
                </div>

                <div class="text-[10px] text-gray-500">PKG</div>

                <div class="mono text-[10px] text-gray-500">01:36</div>

                <div class="text-right text-[10px] font-medium text-green-600">READY</div>
              </div>

              <!-- STORY -->
              <div class="grid grid-cols-[50px_1fr_100px_80px_80px] items-center px-5 py-4 hover:bg-gray-50">
                <div class="text-[12px] text-gray-400">06</div>

                <div>
                  <div class="text-[13px] font-medium">Business market update</div>

                  <div class="mt-1 text-[10px] text-gray-400">Business desk</div>
                </div>

                <div class="text-[10px] text-gray-500">VO</div>

                <div class="mono text-[10px] text-gray-500">01:12</div>

                <div class="text-right text-[10px] font-medium text-green-600">READY</div>
              </div>
            </div>

            <!-- FOOTER -->
            <div class="flex items-center justify-between border-t border-[#eeeeee] bg-[#fafafa] px-5 py-3">
              <div class="flex gap-5 text-[10px] text-gray-400">
                <span> Stories <strong class="ml-1 text-black">06</strong> </span>

                <span> Duration <strong class="mono ml-1 text-black">18:42</strong> </span>
              </div>

              <span class="text-[10px] text-gray-400"> Saved 18:43 </span>
            </div>
          </section>

          <!-- RIGHT PANEL -->
          <aside class="space-y-4">
            <!-- CURRENT -->
            <section class="rounded-xl border border-[#e3e3e3] bg-white">
              <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4">
                <div class="text-[12px] font-medium">Now Playing</div>

                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-red-500"></span>

                  <span class="text-[10px] font-medium text-red-500"> On Air </span>
                </div>
              </div>

              <div class="p-5">
                <div class="text-[10px] text-gray-400">Story 01</div>

                <div class="mt-2 text-[16px] leading-snug font-medium">Government announces new economic measures</div>

                <div class="mt-6 flex items-end justify-between">
                  <div>
                    <div class="text-[10px] text-gray-400">Elapsed</div>

                    <div class="mono mt-1 text-2xl font-bold">01:42</div>
                  </div>

                  <div class="text-right">
                    <div class="text-[10px] text-gray-400">Duration</div>

                    <div class="mono mt-1 text-sm font-medium">02:45</div>
                  </div>
                </div>

                <div class="mt-5 h-1 rounded-full bg-gray-100">
                  <div class="h-1 w-[62%] rounded-full bg-red-500"></div>
                </div>
              </div>
            </section>

            <!-- NEXT -->
            <section class="rounded-xl border border-[#e3e3e3] bg-white">
              <div class="border-b border-[#eeeeee] px-5 py-4">
                <div class="text-[12px] font-medium">Up Next</div>
              </div>

              <div class="p-5">
                <div class="text-[10px] text-gray-400">Story 02</div>

                <div class="mt-2 text-[13px] font-medium">Weather update for the Maldives</div>

                <div class="mt-1 text-[10px] text-gray-400">PKG • 02:15</div>
              </div>
            </section>

            <!-- CONTROLS -->
            <section class="rounded-xl border border-[#e3e3e3] bg-white">
              <div class="border-b border-[#eeeeee] px-5 py-4">
                <div class="text-[12px] font-medium">Controls</div>
              </div>

              <div class="grid grid-cols-2 gap-px bg-[#eeeeee]">
                <a href="/controller" class="bg-white p-5 hover:bg-gray-50">
                  <div class="text-[12px] font-medium">Teleprompter</div>

                  <div class="mt-1 text-[10px] text-gray-400">Controller</div>
                </a>

                <a href="/cg" class="bg-white p-5 hover:bg-gray-50">
                  <div class="text-[12px] font-medium">Graphics</div>

                  <div class="mt-1 text-[10px] text-gray-400">CG control</div>
                </a>

                <a href="/breaking-news" class="bg-white p-5 hover:bg-gray-50">
                  <div class="flex items-center gap-2">
                    <div class="text-[12px] font-medium">Breaking News</div>

                    <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
                  </div>

                  <div class="mt-1 text-[10px] text-gray-400">2 pending</div>
                </a>

                <a href="/stories/new" class="bg-white p-5 hover:bg-gray-50">
                  <div class="text-[12px] font-medium">New Story</div>

                  <div class="mt-1 text-[10px] text-gray-400">Create story</div>
                </a>
              </div>
            </section>

            <!-- SYSTEM -->
            <section class="rounded-xl border border-[#e3e3e3] bg-white">
              <div class="border-b border-[#eeeeee] px-5 py-4">
                <div class="text-[12px] font-medium">System</div>
              </div>

              <div class="px-5 py-2">
                <div class="flex items-center justify-between border-b border-gray-100 py-3">
                  <span class="text-[10px]"> Teleprompter </span>

                  <span class="text-[10px] text-green-600"> Connected </span>
                </div>

                <div class="flex items-center justify-between border-b border-gray-100 py-3">
                  <span class="text-[10px]"> Graphics </span>

                  <span class="text-[10px] text-green-600"> Connected </span>
                </div>

                <div class="flex items-center justify-between py-3">
                  <span class="text-[10px]"> Database </span>

                  <span class="text-[10px] text-green-600"> Online </span>
                </div>
              </div>
            </section>
          </aside>
        </div>
      </main>

      <script>

        function updateClock() {

          const now = new Date();

          const h = String(now.getHours()).padStart(2, "0");
          const m = String(now.getMinutes()).padStart(2, "0");
          const s = String(now.getSeconds()).padStart(2, "0");

          document.getElementById("clock").textContent =
            `${h}:${m}:${s}`;

        }

        updateClock();

        setInterval(updateClock, 1000);
      </script>
    </div>
  </body>
</html>
