<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirCue | Run Order</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon" />
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f5f5f5;
        color: #171717;
      }
      .dragging {
        opacity: .4;
      }

      .drag-over {
        border-top: 2px solid #111;
      }
      .scrollbar::-webkit-scrollbar {
        width: 5px;
        height: 5px;
      }
      .scrollbar::-webkit-scrollbar-thumb {
        background: #d4d4d4;
        border-radius: 10px;
      }
      .border-top-red{
        border-top: 1px rgb(255, 42, 124) solid !important;
      }
    </style>
  </head>
<script src="/socket.io/socket.io.js"></script>
<body class="Outfit-Regular">
    <div class="min-h-screen">
      <%- include('partials/header') -%>
      <main class="mx-auto max-w-[1500px] p-4 md:p-7">

        <!-- PAGE HEADER -->
<div class="mb-7 flex items-end justify-between gap-3">
    <div>
      <h1 class="Outfit-SemiBold text-[26px] tracking-[-0.8px] text-nowrap"><%= runOrder.name %></h1>
      <p class="mt-1 text-[12px] text-gray-400 break-all line-clamp-1">Broadcast Rundowns</p>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="openAddStoryModal()" class="Outfit-Medium max-sm:hidden cursor-pointer rounded-lg border border-[#dddddd] bg-white px-4 py-2 text-[11px] text-nowrap hover:bg-gray-50">Add Story</button>
      <button onclick="openBreakModal()" class="Outfit-Medium max-sm:hidden cursor-pointer rounded-lg border border-[#dddddd] bg-white px-4 py-2 text-[11px] text-nowrap hover:bg-gray-50">Add Break</button>
      <button onclick="saveRunOrder('<%= runOrder.id %>')" class="Outfit-Medium flex cursor-pointer gap-0.5 rounded-lg bg-black px-4 py-2 text-[11px] text-nowrap text-white hover:bg-gray-800">Save <span class="hidden sm:block">Run</span> Order</button>
    </div>
</div>

        <!-- WORKSPACE -->

<div class="grid gap-5 xl:grid-cols-[1fr_300px]">
  <!-- RUN ORDER -->

  <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
    <!-- HEADER -->

    <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-Medium text-[13px]">Rundown</div>

        <div class="mt-0.5 text-[9px] text-gray-400">Drag items to reorder.</div>
      </div>

      <div class="flex items-center gap-2">
        <span class="text-[9px] text-green-600"> Editing </span>
      </div>
    </div>

    <!-- TABLE HEADER -->

    <div class="grid grid-cols-[45px_35px_1fr_60px] border-b border-[#eeeeee] bg-gray-50 px-4 py-2.5 sm:grid-cols-[45px_35px_1fr_70px_60px]">
      <div class="text-[9px] text-gray-400">#</div>
      <div class="text-[9px] text-gray-400">Story</div>
      <div class="text-[9px] text-gray-400 max-sm:hidden">Date</div>
      <div class="text-right text-[9px] text-gray-400">Actions</div>
    </div>
    <!-- ITEMS -->

<div id="runOrderList" class="min-h-[450px]">
<%
function formatTime(dateString) {
    if (!dateString) return '';
    const date = new Date(dateString);

    if (isNaN(date.getTime())) return '';

    const day = date.toLocaleDateString('en-GB', {
        weekday: 'short'
    });

    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');

    return `${day} ${hours}:${minutes}`;
}
%>
<% if(runDown.length === 0){ %>
<div id="NoRundownItems" class="flex min-h-[450px] flex-col items-center justify-center px-6 py-12 text-center">
  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gray-100 text-gray-400">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="5" y="3" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.5" />
      <path d="M8 8H16M8 12H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </div>
  <div class="Outfit-Medium mt-3 text-[12px] text-gray-700">Rundown is empty</div>
  <div class="mt-1 max-w-55 text-[10px] leading-4 text-gray-400">No stories or breaks have been added to this rundown yet.</div>
</div>
<% } %>
<% runDown.forEach(item=>{ %>
<% if(item.item_type == 'story'){ %>
  
<div data-itemid="<%= item.story_id %>" draggable="true" class="runorder-item runorder-story border-t grid cursor-pointer border-b border-[#eeeeee] px-4 py-2 sm:grid-cols-[45px_35px_1fr_70px_60px] grid-cols-[45px_35px_1fr_60px] md:gap-0">
  <div class="flex items-center gap-2 pointer-events-none">
    <span class="drag-handle cursor-grab text-[15px] text-gray-300 pointer-events-auto"> ⋮⋮ </span>
  </div>
    <p class="text-[10px] flex items-center text-gray-400 runorder-counter">00</p>
    <div class="min-w-0 flex-1"><p class="Outfit-Faseyha-Medium truncate text-[11px]"><%= item.slug %></p></div>
    <p class="Outfit-Regular flex items-center line-clamp-1 text-[10px] max-sm:hidden"> <%= formatTime(item.ca) %> </p>
    <div class="flex justify-end">
        <button id="deleteRunOrderItem" class="ml-1 cursor-pointer flex h-7 w-7 items-center justify-center rounded-md text-[12px] text-red-400 hover:bg-red-50">×</button>
    </div>
</div>
<% } %>

<% if(item.item_type == 'break'){ %>
<div draggable="true" class="runorder-item runorder-break border-t border-[#eeeeee] bg-red-500  px-4 py-2">
  <div class="flex items-center gap-3 pointer-events-none">
    <div class="drag-handle cursor-grab text-[15px] text-white pointer-events-auto">⋮⋮</div>
    <div class="h-px flex-1 bg-red-400"></div>
    <div class="flex items-center gap-3">
      <span class="rounded-md bg-red-400 px-2 py-1 text-[10px] font-medium text-white uppercase runorder-break-type"> <%= item.break_name %> </span>
    </div>
    <div class="h-px flex-1 bg-red-400"></div>
    <div class="flex justify-end">
        <button id="deleteRunOrderItem" class="ml-1 pointer-events-auto cursor-pointer flex h-7 w-7 items-center justify-center rounded-md text-[12px] text-white hover:bg-red-800">×</button>
    </div>
  </div>
</div>
<% } %>
<% }) %>

</div>

    <!-- EMPTY -->

    <div id="emptyRunOrder" class="hidden px-5 py-20 text-center">
      <div class="text-[13px]">Run order is empty</div>

      <div class="mt-1 text-[10px] text-gray-400">Add a story or break to get started.</div>

      <div class="mt-4 flex justify-center gap-2">
        <button onclick="openAddStoryModal()" class="rounded-lg bg-black px-4 py-2.5 text-[10px] text-white">Add Story</button>

        <button onclick="openBreakModal()" class="rounded-lg border border-[#dddddd] px-4 py-2.5 text-[10px]">Add Break</button>
      </div>
    </div>
  </section>

  <!-- RIGHT PANEL -->

  <aside class="space-y-4">
    <!-- QUICK ADD -->
    <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
      <div class="border-b border-[#eeeeee] px-4 py-4">
        <div class="Outfit-Medium text-[12px]">Quick Add</div>
      </div>
      <div class="space-y-2 p-3">
        <button onclick="openAddStoryModal()" class="flex w-full cursor-pointer items-center gap-3 rounded-lg p-3 text-left hover:bg-gray-50">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-[15px]">+</div>
          <div>
            <div class="text-[11px]">Add Story</div>
            <div class="mt-0.5 text-[9px] text-gray-400">Existing or new story</div>
          </div>
        </button>
        <button onclick="openBreakModal()" class="flex w-full cursor-pointer items-center gap-3 rounded-lg p-3 text-left hover:bg-gray-50">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-100 text-[9px]">BRK</div>
          <div>
            <div class="text-[11px]">Add Break</div>
            <div class="mt-0.5 text-[9px] text-gray-400">Commercial or segment break</div>
          </div>
        </button>
      </div>
    </section>

    <!-- RUN ORDER INFO -->
    <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
      <div class="border-b border-[#eeeeee] px-4 py-4">
        <div class="Outfit-Medium text-[12px]">Run Order</div>
      </div>

      <div class="space-y-3 p-4">
        <div class="flex justify-between">
          <span class="text-[9px] text-gray-400"> Name </span>

          <span class="text-[10px]"> <%= runOrder.name %> </span>
        </div>

        <div class="flex justify-between">
          <span class="text-[9px] text-gray-400"> Air Time </span>

          <span class="text-[10px]"> <%= runOrder.air_time.slice(0, 5) %> </span>
        </div>

        <div class="flex justify-between">
          <span class="text-[9px] text-gray-400"> Producer </span>

          <span class="text-[10px]"> <%= runOrder.full_name || 'No Producer' %> </span>
        </div>

        <div class="flex justify-between">
          <span class="text-[9px] text-gray-400"> Status </span>
          <span class="<%= isActive ? 'text-green-500' : 'text-red-500' %> text-[10px]"> <%= isActive ? 'Active' : 'Not Active' %> </span>
        </div>

        <div class="flex justify-between">
          <span class="text-[9px] text-gray-400"> Stories </span>

          <span class="text-[10px]" id="footerStoryCount"> 0 </span>
        </div>
      </div>
    </section>
  </aside>
</div>

      </main>
    </div>

    <!-- ========================================
     ADD STORY MODAL
========================================= -->

<div id="addStoryModal" class="fixed inset-x-0 top-0 bottom-0 z-5000 hidden items-center justify-center overflow-hidden bg-black/30 p-2 sm:p-4">
  <div class="flex h-full min-h-0 w-full max-w-[650px] flex-col overflow-hidden rounded-xl bg-white shadow-xl">
    <!-- HEADER -->
    <div class="flex items-center justify-between gap-3 border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-SemiBold line-clamp-1 text-[14px] break-all">Add Story</div>
        <div class="mt-0.5 line-clamp-1 text-[10px] break-all text-gray-400">Add an existing story or create a new one.</div>
      </div>
      <div onclick="closeAddStoryModal()" class="aspect-square h-fit w-fit cursor-pointer rounded-sm px-2 text-gray-400 hover:bg-gray-200 hover:text-black">
        <p class="cursor-pointer">×</p>
      </div>
    </div>
    <!-- TABS -->
    <div class="shrink-0 border-b border-[#eeeeee] p-3">
      <div class="grid grid-cols-2 rounded-lg bg-gray-100 p-1">
        <button id="existingStoryTab" onclick="switchStoryTab('existing')" class="cursor-pointer rounded-md bg-white py-2 text-[10px] shadow-sm">Existing Stories</button>
        <!-- <button id="newStoryTab" onclick="switchStoryTab('new')" class="cursor-pointer rounded-md py-2 text-[10px] text-gray-500">Create New</button> -->
      </div>
    </div>
    <!-- EXISTING STORIES -->
    <div id="existingStoriesPanel" class="flex min-h-0 flex-1 flex-col overflow-hidden">
      <div class="flex shrink-0 items-center gap-2 border-b border-[#eeeeee] bg-white p-2 select-none">
        <!-- LEFT -->
        <button id="dateScrollLeft" class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-[#eeeeee] text-gray-500 hover:bg-gray-100 hover:text-black">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <!-- DATE SCROLLER -->
        <div id="dateScroller" class="flex flex-1 gap-2 overflow-x-auto scroll-smooth" style="scrollbar-width:none;"></div>
        <!-- RIGHT -->
        <button id="dateScrollRight" class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-[#eeeeee] text-gray-500 hover:bg-gray-100 hover:text-black">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <!-- QUICK DATE BUTTONS -->
      <div class="flex shrink-0 flex-nowrap items-center justify-center gap-1.5 border-b border-[#eeeeee] bg-[#fafafa] px-3 py-2 select-none">
        <button onclick="jumpToDate(-10)" class="cursor-pointer rounded-md border border-[#e5e5e5] bg-white px-2.5 py-1.5 text-[9px] text-nowrap text-gray-500 hover:border-gray-300 hover:text-black">10 days ago</button>
        <button onclick="jumpToDate(-2)" class="cursor-pointer rounded-md border border-[#e5e5e5] bg-white px-2.5 py-1.5 text-[9px] text-nowrap text-gray-500 hover:border-gray-300 hover:text-black">2 days ago</button>
        <button onclick="jumpToDate(0)" class="Outfit-Medium cursor-pointer rounded-md bg-black px-2.5 py-1.5 text-[9px] text-nowrap text-white hover:bg-gray-800">Today</button>
        <button onclick="jumpToDate(1)" class="cursor-pointer rounded-md border border-[#e5e5e5] bg-white px-2.5 py-1.5 text-[9px] text-nowrap text-gray-500 hover:border-gray-300 hover:text-black">Tomorrow</button>
        <button onclick="jumpToDate(7)" class="cursor-pointer rounded-md border border-[#e5e5e5] bg-white px-2.5 py-1.5 text-[9px] text-nowrap text-gray-500 hover:border-gray-300 hover:text-black">7 days from now</button>
      </div>
      <!-- SEARCH -->
      <div class="flex shrink-0 gap-2 border-b border-[#eeeeee] p-4">
        <input id="storySearch" type="text" placeholder="Search stories..." class="w-full rounded-lg border border-[#dddddd] bg-gray-50 px-3 py-2 text-[10px] outline-none focus:border-black focus:bg-white" />
        <div class="relative">
          <button id="filterBtn" onclick="toggleFilterMenu()" class="flex cursor-pointer items-center gap-2 rounded-lg border border-[#dddddd] px-3 py-2 text-[10px] text-gray-500 hover:bg-gray-50">
            <span id="filterText">English</span>
            <svg width="12" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 10L12 15L17 10H7Z"></path>
            </svg>
          </button>
          <div id="filterMenu" class="absolute top-10 right-0 z-30 hidden w-40 rounded-lg border border-[#e5e5e5] bg-white p-1.5 shadow-lg">
            <button onclick="selectLanguageFilter('en', 'English')" class="w-full cursor-pointer rounded-md px-3 py-2 text-left text-[10px] text-gray-600 hover:bg-gray-50">English</button>
            <button onclick="selectLanguageFilter('dv', 'Dhivehi')" class="w-full cursor-pointer rounded-md px-3 py-2 text-left text-[10px] text-gray-600 hover:bg-gray-50">Dhivehi</button>
          </div>
        </div>
      </div>
      <div id="storyBank" class="scrollbar min-h-0 flex-1 overflow-y-auto"></div>
    </div>

    <!-- NEW STORY -->

    <div id="newStoryPanel" class="scrollbar hidden flex-1 overflow-y-auto p-5">
      <div class="space-y-4">
        <!-- SLUG -->

        <div class="mb-5">
          <label class="mb-2 block text-[10px] font-medium text-gray-500"> SLUG </label>
          <input id="slug" type="text" value="" placeholder="Enter story slug" class="Outfit-Faseyha-Regular w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] uppercase outline-none focus:border-black" />
          <div class="mt-1.5 text-[9px] text-gray-400">Short identifier used by the newsroom.</div>
        </div>

        <!-- TYPE + LANGUAGE -->

        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> LANGUAGE </label>
          <select id="newStoryLanguage" class="w-full rounded-lg border border-[#dddddd] bg-white px-3 py-2.5 text-[10px] outline-none">
            <option value="dv">Dhivehi</option>
            <option value="en">English</option>
          </select>
        </div>

        <!-- TEXT -->

        <div class="mb-5">
          <div class="mb-2 flex items-center justify-between">
            <label class="text-[10px] font-medium text-gray-500"> CG TEXT </label>
            <div class="flex items-center gap-3 text-[9px] text-gray-400">
              <label class="relative inline-flex cursor-pointer items-center">
                <input id="cgToggle" type="checkbox" class="peer sr-only" />
                <div class="h-4 w-8 rounded-full bg-gray-200 transition peer-checked:bg-black"></div>
                <div class="absolute top-0.5 left-0.5 h-3 w-3 rounded-full bg-white shadow-sm transition peer-checked:translate-x-4"></div>
                <span class="ml-2 text-[10px] text-gray-500"> EN / DV </span>
              </label>
            </div>
          </div>
          <input id="cg" type="text" value="" placeholder="Enter CG text" class="Outfit-Faseyha-Regular w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-sm outline-none focus:border-black" dir="rtl" />
          <div class="mt-1.5 text-[9px] text-gray-400">This text can be sent directly to the graphics system.</div>
        </div>
        <!-- CG PREVIEW -->

        <div class="mb-5 w-full">
          <div class="headline-preview relative w-full overflow-hidden" style="container-type: inline-size;">
            <img src="/img/headlineBarPreview.png" alt="" class="block h-auto w-full" />
            <div id="cg_text_preview" class="AWaheed absolute top-[57%] right-[8.5%] -translate-y-1/2 text-right text-nowrap text-black" style="font-size: 2.43cqw; font-weight: bold;"></div>
          </div>
        </div>

        <!-- STORY TEXT -->
        <div class="mb-5">
          <div class="mb-2 flex items-center justify-between">
            <label class="text-[10px] font-medium text-gray-500"> STORY TEXT </label>
            <div class="flex items-center gap-3 text-[9px] text-gray-400">
              <label class="relative inline-flex cursor-pointer items-center">
                <input id="languageToggle" type="checkbox" class="peer sr-only" />
                <div class="h-4 w-8 rounded-full bg-gray-200 transition peer-checked:bg-black"></div>
                <div class="absolute top-0.5 left-0.5 h-3 w-3 rounded-full bg-white shadow-sm transition peer-checked:translate-x-4"></div>
                <span class="ml-2 text-[10px] text-gray-500"> EN / DV </span>
              </label>
            </div>
          </div>
          <textarea id="storyText" class="Outfit-Faseyha-Regular scrollbar h-full max-h-100 min-h-50 w-full resize-none rounded-lg border border-[#dddddd] px-4 py-3 text-sm leading-6 outline-none focus:border-black" style="font-family: 'Outfit-Regular', 'Faseyha-Regular';" placeholder="..." dir="rtl"></textarea>
          <div class="mt-3 flex items-center justify-end gap-1">
            <button onclick="copyType('PKG')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">PKG</button>
            <button onclick="copyType('VAR')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">VAR</button>
            <button onclick="copyType('INT')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">INT</button>
          </div>
        </div>
      </div>

      <div class="mt-5 flex justify-end gap-2 border-t border-[#eeeeee] pt-4">
        <button onclick="closeAddStoryModal()" class="rounded-lg px-4 py-2.5 text-[10px] text-gray-500 hover:bg-gray-100">Cancel</button>

        <button onclick="createAndAddStory()" class="rounded-lg bg-black px-4 py-2.5 text-[10px] text-white">Create & Add</button>
      </div>
    </div>
  </div>
</div>




    <!-- ========================================
     ADD BREAK MODAL
========================================= -->

<div id="breakModal" class="fixed inset-x-0 top-17 bottom-0 z-50 hidden items-center justify-center bg-black/30 p-2 select-none sm:p-4">
  <div class="flex w-full max-w-100 flex-col overflow-hidden rounded-xl bg-white shadow-xl">
    <!-- HEADER -->
    <div class="flex items-center justify-between gap-3 border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-SemiBold line-clamp-1 text-[14px] break-all">Add Break</div>
        <div class="mt-0.5 line-clamp-1 text-[10px] break-all text-gray-400">Insert a break into the rundown.</div>
      </div>
      <div onclick="closeBreakModal()" class="aspect-square h-fit w-fit cursor-pointer rounded-sm px-2 text-gray-400 hover:bg-gray-200 hover:text-black">
        <p class="cursor-pointer">×</p>
      </div>
    </div>

    <div class="space-y-4 p-5">
      <div>
        <label class="mb-1.5 block text-[9px] text-gray-500"> BREAK NAME </label>
        <input id="breakName" type="text" value="Commercial Break" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
      </div>
      <div>
        <label class="mb-1.5 block text-[9px] text-gray-500"> SELECT BREAK </label>
        <div class="grid grid-cols-3 grid-rows-3 gap-1">
          <button onclick="addBreaker('LOCAL')" class="cursor-pointer overflow-hidden rounded-md border border-[#e5e5e5] bg-white px-2.5 py-2 text-[11px] text-nowrap text-gray-500 hover:border-gray-300 hover:bg-black hover:text-white">LOCAL</button>
          <button onclick="addBreaker('BUSINESS')" class="cursor-pointer overflow-hidden rounded-md border border-[#e5e5e5] bg-white px-2.5 py-2 text-[11px] text-nowrap text-gray-500 hover:border-gray-300 hover:bg-black hover:text-white">BUSINESS</button>
          <button onclick="addBreaker('WORLD')" class="cursor-pointer overflow-hidden rounded-md border border-[#e5e5e5] bg-white px-2.5 py-2 text-[11px] text-nowrap text-gray-500 hover:border-gray-300 hover:bg-black hover:text-white">WORLD</button>
          <button onclick="addBreaker('SPORTS')" class="cursor-pointer overflow-hidden rounded-md border border-[#e5e5e5] bg-white px-2.5 py-2 text-[11px] text-nowrap text-gray-500 hover:border-gray-300 hover:bg-black hover:text-white">SPORTS</button>
          <button onclick="addBreaker('WEATHER')" class="cursor-pointer overflow-hidden rounded-md border border-[#e5e5e5] bg-white px-2.5 py-2 text-[11px] text-nowrap text-gray-500 hover:border-gray-300 hover:bg-black hover:text-white">WEATHER</button>
          <button onclick="addBreaker('BREAKING')" class="cursor-pointer overflow-hidden rounded-md border border-[#e5e5e5] bg-white px-2.5 py-2 text-[11px] text-nowrap text-gray-500 hover:border-gray-300 hover:bg-black hover:text-white">BREAKING</button>
          <button onclick="addBreaker('NEWS END')" class="cursor-pointer overflow-hidden rounded-md border border-[#e5e5e5] bg-white px-2.5 py-2 text-[11px] text-nowrap text-gray-500 hover:border-gray-300 hover:bg-black hover:text-white">NEWS END</button>
        </div>
      </div>
      <div class="flex justify-end gap-2 border-t border-[#eeeeee] pt-4">
        <button onclick="closeBreakModal()" class="cursor-pointer rounded-lg px-4 py-2.5 text-[10px] text-gray-500 hover:bg-gray-100">Cancel</button>
        <button onclick="addBreak()" class="cursor-pointer rounded-lg bg-black px-4 py-2.5 text-[10px] text-white">Add Break</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/alert') -%>


<script src="/js/runorders-id.js"></script>
</body>
</html>
