<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= code %> - <%= title %> | AirCue</title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon">
</head>
<body class="Outfit-Regular bg-[#f5f5f5] text-black">
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden px-5 py-10">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.035]"
      style="
        background-image:
          linear-gradient(to right, #000 1px, transparent 1px),
          linear-gradient(to bottom, #000 1px, transparent 1px);
        background-size: 32px 32px;
      ">
      </div>

    <div class="relative w-full max-w-170">
      <div class="overflow-hidden rounded-2xl border border-[#e2e2e2] bg-white shadow-[0_10px_50px_rgba(0,0,0,0.05)]">
        <!-- HEADER -->
        <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-3">
          <div class="flex items-center gap-2">
            <span class="Outfit-Medium text-[10px] tracking-[0.14em] text-gray-500">
              AIRCUE SYSTEM
            </span>
          </div>
          <div class="rounded-md bg-gray-100 px-2 py-1 text-[9px] text-gray-400">
            ERROR <%= code %>
          </div>
        </div>
        <!-- CONTENT -->
        <div class="px-7 py-10 md:px-10 md:py-12">
          <!-- ICON -->
          <div
            class="flex h-13 w-13 items-center justify-center rounded-xl
            <%= code === 500 ? 'bg-red-50 text-red-500' :
                code === 403 ? 'bg-orange-50 text-orange-500' :
                code === 401 ? 'bg-yellow-50 text-yellow-600' :
                'bg-gray-100 text-gray-500' %>"
          >
            <% if(code === 401){ %>
              <!-- Lock -->
               <svg width="22" height="22" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19 10H20C20.5523 10 21 10.4477 21 11V21C21 21.5523 20.5523 22 20 22H4C3.44772 22 3 21.5523 3 21V11C3 10.4477 3.44772 10 4 10H5V9C5 5.13401 8.13401 2 12 2C15.866 2 19 5.13401 19 9V10ZM5 12V20H19V12H5ZM11 14H13V18H11V14ZM17 10V9C17 6.23858 14.7614 4 12 4C9.23858 4 7 6.23858 7 9V10H17Z"></path></svg>
            <% } else if(code === 403){ %>
              <!-- Shield -->
              <svg width="22" height="22" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L20.2169 2.82598C20.6745 2.92766 21 3.33347 21 3.80217V13.7889C21 15.795 19.9974 17.6684 18.3282 18.7812L12 23L5.6718 18.7812C4.00261 17.6684 3 15.795 3 13.7889V3.80217C3 3.33347 3.32553 2.92766 3.78307 2.82598L12 1ZM12 3.04879L5 4.60434V13.7889C5 15.1263 5.6684 16.3752 6.7812 17.1171L12 20.5963L17.2188 17.1171C18.3316 16.3752 19 15.1263 19 13.7889V4.60434L12 3.04879ZM12 7C13.1046 7 14 7.89543 14 9C14 9.73984 13.5983 10.3858 13.0011 10.7318L13 15H11L10.9999 10.7324C10.4022 10.3866 10 9.74025 10 9C10 7.89543 10.8954 7 12 7Z"></path></svg>
            <% } else if(code === 404){ %>
              <!-- Missing page -->
              <svg width="22" height="22" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22V20H5V4H15V8H19V13H20.9998V7L16 2H3.9985C3.44749 2 3 2.44405 3 2.9918V21.0082C3 21.5447 3.44476 22 3.9934 22H12ZM21.5356 21.1212L19.4143 18.9999L21.5356 16.8786L20.1214 15.4644L18.0001 17.5857L15.8788 15.4644L14.4646 16.8786L16.5859 18.9999L14.4646 21.1212L15.8788 22.5354L18.0001 20.4141L20.1214 22.5354L21.5356 21.1212Z"></path></svg>
            <% } else { %>
              <!-- System error -->
               <svg width="22" height="22" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C7.58172 4 4 7.58172 4 12C4 16.4183 7.58172 20 12 20ZM11 15H13V17H11V15ZM11 7H13V13H11V7Z"></path></svg>
            <% } %>
          </div>
          <div class="mt-6 text-[10px] uppercase tracking-[0.18em] text-gray-400">
            <%= label %>
          </div>
          <h1 class="Outfit-SemiBold mt-2 text-[28px] leading-tight text-gray-900 md:text-[34px]">
            <%= heading %>
          </h1>
          <p class="mt-3 max-w-xl text-[11px] leading-5 text-gray-400">
            <%= description %>
          </p>
          <!-- ACTIONS -->
          <div class="mt-7 flex flex-wrap gap-2">
            <% if(code === 401){ %>
              <a href="/login" class="Outfit-Medium rounded-lg bg-black px-4 py-2.5 text-[10px] text-white hover:bg-gray-800">Return to Login</a>
            <% } else { %>
              <a href="/" class="Outfit-Medium rounded-lg bg-black px-4 py-2.5 text-[10px] text-white hover:bg-gray-800">Go to Stories</a>
              <button onclick="history.back()" class="Outfit-Medium cursor-pointer rounded-lg border border-[#dddddd] bg-white px-4 py-2.5 text-[10px] text-gray-600 hover:bg-gray-50 hover:text-black">Go Back</button>
            <% } %>
          </div>
        </div>
        <!-- FOOTER -->
            <div class="flex items-center justify-between border-t border-[#eeeeee] px-5 py-3 text-[9px] text-gray-300">
              <span>AirCue Newsroom System</span>
              <span><%= code %> / <%= title.toUpperCase() %></span>
            </div>
      </div>
    </div>
  </main>
</body>
</html>