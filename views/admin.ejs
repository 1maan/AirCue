<!-- ADD USER MODAL -->

<div
    id="addUserModal"
    class="hidden fixed inset-0 z-50 bg-black/80 items-center justify-center">

    <div class="w-[470px] bg-[#181a1c] border border-white/10">


        <div class="p-6 border-b border-white/10 flex items-center justify-between">

            <div>

                <div class="text-[9px] uppercase tracking-[2px] text-white/25">
                    User Management
                </div>

                <div class="text-lg font-bold mt-2">
                    Add User
                </div>

            </div>


            <button
                onclick="closeAddUser()"
                class="text-white/20 hover:text-white">
                ×
            </button>

        </div>


        <div class="p-6 space-y-5">


            <div class="grid grid-cols-2 gap-4">

                <div>

                    <label class="block text-[8px] uppercase tracking-[1px] text-white/20 mb-2">
                        First Name
                    </label>

                    <input
                        type="text"
                        placeholder="First name"
                        class="w-full h-10 px-3 bg-[#111315] border border-white/10 text-xs"
                    >

                </div>


                <div>

                    <label class="block text-[8px] uppercase tracking-[1px] text-white/20 mb-2">
                        Last Name
                    </label>

                    <input
                        type="text"
                        placeholder="Last name"
                        class="w-full h-10 px-3 bg-[#111315] border border-white/10 text-xs"
                    >

                </div>

            </div>


            <div>

                <label class="block text-[8px] uppercase tracking-[1px] text-white/20 mb-2">
                    Username
                </label>

                <input
                    type="text"
                    placeholder="username"
                    class="w-full h-10 px-3 bg-[#111315] border border-white/10 text-xs"
                >

            </div>


            <div>

                <label class="block text-[8px] uppercase tracking-[1px] text-white/20 mb-2">
                    Email
                </label>

                <input
                    type="email"
                    placeholder="name@company.com"
                    class="w-full h-10 px-3 bg-[#111315] border border-white/10 text-xs"
                >

            </div>


            <div>

                <label class="block text-[8px] uppercase tracking-[1px] text-white/20 mb-2">
                    Role
                </label>

                <select
                    class="w-full h-10 px-3 bg-[#111315] border border-white/10 text-xs text-white/60">

                    <option>Journalist</option>
                    <option>Producer</option>
                    <option>Editor</option>
                    <option>Presenter</option>
                    <option>Administrator</option>

                </select>

            </div>


            <div>

                <label class="block text-[8px] uppercase tracking-[1px] text-white/20 mb-2">
                    Temporary Password
                </label>

                <input
                    type="password"
                    placeholder="Temporary password"
                    class="w-full h-10 px-3 bg-[#111315] border border-white/10 text-xs"
                >

            </div>


            <label class="flex items-center gap-3">

                <input
                    type="checkbox"
                    checked
                    class="accent-white w-4 h-4"
                >

                <span class="text-[8px] text-white/40">
                    Send account details to user
                </span>

            </label>

        </div>


        <div class="p-5 border-t border-white/10 flex justify-end gap-3">

            <button
                onclick="closeAddUser()"
                class="h-9 px-5 border border-white/10 text-[8px] uppercase tracking-[1px] text-white/40">
                Cancel
            </button>


            <button
                onclick="createUser()"
                class="h-9 px-6 bg-white text-black text-[8px] uppercase tracking-[1px] font-bold">
                Create User
            </button>

        </div>

    </div>

</div>


<script>

    function openAddUser() {

        document.getElementById("addUserModal")
            .classList.remove("hidden");

        document.getElementById("addUserModal")
            .classList.add("flex");

    }


    function closeAddUser() {

        document.getElementById("addUserModal")
            .classList.add("hidden");

        document.getElementById("addUserModal")
            .classList.remove("flex");

    }


    function createUser() {

        /*
            Node.js / Socket.IO example:

            fetch("/api/users", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({

                    firstName,
                    lastName,
                    username,
                    email,
                    role,
                    password

                })

            });

        */

        closeAddUser();

        alert("User created.");

    }


    function filterUsers() {

        const search =
            document.getElementById("search")
                .value
                .toLowerCase();

        const role =
            document.getElementById("roleFilter")
                .value;

        const rows =
            document.querySelectorAll("#userTable tr");


        rows.forEach(row => {

            const name =
                row.dataset.name.toLowerCase();

            const userRole =
                row.dataset.role;


            const matchesSearch =
                name.includes(search);

            const matchesRole =
                role === "all" ||
                userRole === role;


            row.style.display =
                matchesSearch && matchesRole
                    ? ""
                    : "none";

        });

    }


    function toggleAll(source) {

        document
            .querySelectorAll(".user-checkbox")
            .forEach(box => {

                box.checked = source.checked;

            });

    }


    function refreshUsers() {

