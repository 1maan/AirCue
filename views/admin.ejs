<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AirCue | Users</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #101213;
            color: #f4f4f4;
            font-family: Arial, Helvetica, sans-serif;
        }

        input,
        select {
            outline: none;
        }

        .scrollbar::-webkit-scrollbar {
            width: 5px;
        }

        .scrollbar::-webkit-scrollbar-thumb {
            background: #34383b;
        }
    </style>
</head>

<body class="h-screen overflow-hidden">

<div class="h-screen flex flex-col">


    <!-- TOP BAR -->

    <header class="h-[64px] shrink-0 bg-[#17191b] border-b border-white/10 flex items-center">

        <div class="w-[220px] h-full border-r border-white/10 px-5 flex items-center">

            <div class="flex items-center gap-3">

                <div class="w-8 h-8 border border-white/30 flex items-center justify-center">

                    <div class="w-3.5 h-3.5 bg-white"></div>

                </div>

                <div>

                    <div class="font-bold">
                        AirCue
                    </div>

                    <div class="text-[7px] uppercase tracking-[2px] text-white/25">
                        Administration
                    </div>

                </div>

            </div>

        </div>


        <div class="flex-1 px-6">

            <div class="text-sm font-bold">
                Administration
            </div>

            <div class="text-[8px] text-white/25 mt-1">
                Users & access control
            </div>

        </div>


        <div class="px-6 flex items-center gap-4">

            <div class="flex items-center gap-2">

                <span class="w-2 h-2 bg-green-500 rounded-full"></span>

                <span class="text-[8px] uppercase tracking-[1px] text-green-500">
                    System Online
                </span>

            </div>

        </div>

    </header>


    <!-- MAIN -->

    <div class="flex flex-1 min-h-0">


        <!-- SIDEBAR -->

        <aside class="w-[220px] shrink-0 bg-[#151719] border-r border-white/10">


            <div class="p-4">


                <div class="text-[7px] uppercase tracking-[2px] text-white/20 px-3 mb-3">
                    Administration
                </div>


                <button
                    class="w-full h-9 px-3 flex items-center gap-3 bg-white/[0.06] border-l-2 border-white text-left">

                    <span class="text-[10px]">
                        ◉
                    </span>

                    <span class="text-[9px]">
                        Users
                    </span>

                </button>


                <button
                    onclick="window.location.href='/admin/roles'"
                    class="w-full h-9 px-3 flex items-center gap-3 text-white/40 hover:text-white text-left">

                    <span class="text-[10px]">
                        ◇
                    </span>

                    <span class="text-[9px]">
                        Roles & Permissions
                    </span>

                </button>


                <button
