<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirCue | Settings</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon">

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f5f5f5;
        color: #171717;
      }
      .scrollbar{
        scrollbar-gutter: stable;
      }
      .scrollbar::-webkit-scrollbar {
        width: 5px;
        height: 5px;
      }
      .scrollbar::-webkit-scrollbar-thumb {
        background: #d4d4d4;
        border-radius: 10px;
      }
    </style>
  </head>

  <body class="Outfit-Regular">
<div class="min-h-screen">

<%- include('partials/header') -%>

  <main class="mx-auto max-w-[1150px] p-4 md:p-7">

<!-- HEADER -->

<div class="mb-7">
  <h1 class="Outfit-SemiBold mt-1 text-[26px] tracking-[-0.8px]">
    Settings
  </h1>

  <p class="mt-1 text-[11px] text-gray-400">
    Configure AirCue newsroom and broadcast settings.
  </p>

</div>


<div class="space-y-5">


  <!-- SYSTEM PATHS -->

<section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
  <div class="border-b border-[#eeeeee] px-5 py-4">
    <div class="Outfit-Medium text-[12px]">Output File Paths</div>

    <div class="mt-0.5 text-[9px] text-gray-400">Set the locations AirCue will use when writing broadcast text files.</div>
  </div>

  <div class="space-y-5 p-5">
    <!-- BREAKING NEWS PATH -->

    <div>
      <label for="breakingNewsPath" class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> BREAKING NEWS TEXT FILE PATH </label>

      <input id="breakingNewsPath" name="breakingNewsPath" type="text" value="" placeholder="Example: C:\AirCue\output\breaking.txt" class="mono w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[10px] outline-none focus:border-black" />

      <div class="mt-1.5 text-[9px] text-gray-400">Breaking news text will be written to this file.</div>
    </div>

    <!-- CH PATH -->

    <div>
      <label for="chTextPath" class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> CG TEXT FILE PATH </label>

      <input id="chTextPath" name="chTextPath" type="text" value="" placeholder="Example: C:\AirCue\output\ch.txt" class="mono w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[10px] outline-none focus:border-black" />

      <div class="mt-1.5 text-[9px] text-gray-400">CG text will be written to this file.</div>
    </div>

    <!-- TEST PATHS -->

    <div class="flex justify-end">
      <button type="button" onclick="testPaths()" class="rounded-lg cursor-pointer border border-[#dddddd] px-4 py-2.5 text-[10px] text-gray-500 hover:bg-gray-50 hover:text-black">Test Paths</button>
    </div>
  </div>
</section>

  <!-- GRAPHICS -->

<section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
  <div class="border-b border-[#eeeeee] px-5 py-4">
    <div class="Outfit-Medium text-[12px]">Graphics / Jump</div>

    <div class="mt-0.5 text-[9px] text-gray-400">Graphics/Jump engine connection settings.</div>
  </div>

  <div class="grid gap-5 p-5 sm:grid-cols-2">
    <div>
      <label for="graphicsIp" class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> GRAPHICS ENGINE IP </label>
      <input id="graphicsIp" type="text" value="" placeholder="192.168.10.20" class="mono w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[10px] outline-none focus:border-black" />
    </div>
    <div class="flex items-end">
      <button type="button" onclick="testGraphics()" class="w-full rounded-lg border cursor-pointer border-[#dddddd] px-4 py-2.5 text-[10px] text-gray-500 hover:bg-gray-50 hover:text-black cursor-pointer">Test Connection</button>
    </div>
  </div>
</section>

  <!-- SAVE BAR -->

<div class="flex items-center justify-between rounded-xl border border-[#e3e3e3] bg-white p-4">
  <div>
    <div class="text-[10px] font-medium">AirCue Settings</div>

    <div id="saveStatus" class="mt-0.5 text-[9px] text-gray-400">Save your changes before leaving this page.</div>
  </div>

  <div class="flex gap-2">
    <button type="button" onclick="saveSettings()" class="Outfit-Medium cursor-pointer rounded-lg bg-black px-5 py-2.5 text-[10px] text-white hover:bg-gray-800">Save Settings</button>
  </div>
</div>


<!-- USER MANAGEMENT -->

<section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
  <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4">
    <div>
      <div class="Outfit-Medium text-[12px]">Users</div>

      <div class="mt-0.5 text-[9px] text-gray-400">Manage newsroom users and access.</div>
    </div>

    <button type="button" onclick="openAddUser()" class="Outfit-Medium rounded-lg bg-black px-4 py-2 text-[10px] text-white cursor-pointer hover:bg-gray-800">Add User</button>
  </div>

  <!-- TABLE HEADER -->

  <div class="hidden grid-cols-[1fr_140px_110px_100px] border-b border-[#eeeeee] bg-gray-50 px-5 py-2.5 sm:grid">
    <div class="text-[9px] text-gray-400">User</div>

    <div class="text-[9px] text-gray-400">Role</div>

    <div class="text-[9px] text-gray-400">Status</div>

    <div></div>
  </div>

  <!-- USER -->
<div id="userTb" class="space-y-0 overflow-auto scrollbar">

</div>


  <!-- ADD USER MODAL -->
  <div id="addUserModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/30 p-4">
    <div class="w-full max-w-[430px] overflow-hidden rounded-xl bg-white shadow-xl">
    <div class="flex items-center justify-between gap-3 border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-SemiBold line-clamp-1 text-[14px] break-all">Add User</div>
        <div class="mt-0.5 line-clamp-1 text-[10px] break-all text-gray-400">Create a new AirCue newsroom account.</div>
      </div>
      <div onclick="closeAddUser()" class="aspect-square h-fit w-fit cursor-pointer rounded-sm px-2 text-gray-400 hover:bg-gray-200 hover:text-black">
        <p class="cursor-pointer">×</p>
      </div>
    </div>
      <div class="space-y-4 p-5">
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> EMAIL </label>
          <input id="newEmail" type="email" placeholder="Enter email address" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> FULL NAME </label>
          <input id="newFullname" type="text" placeholder="Enter full name" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> USERNAME </label>
          <input id="newUsername" type="text" placeholder="Enter username" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> PASSWORD </label>
          <input id="newPassword" type="password" value="Welcome123" placeholder="Enter password" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> ROLE </label>
          <select id="newRole" class="w-full rounded-lg border border-[#dddddd] bg-white px-3 py-2.5 text-[11px] outline-none focus:border-black">
            <option value="journalist">Journalist</option>
            <option value="producer">Producer</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div class="flex justify-end gap-2 border-t border-[#eeeeee] pt-4">
          <button type="button" onclick="closeAddUser()" class="rounded-lg cursor-pointer px-4 py-2.5 text-[10px] text-gray-500 hover:bg-gray-100">Cancel</button>
          <button id="addUserForm" class="Outfit-Medium cursor-pointer rounded-lg bg-black px-4 py-2.5 text-[10px] text-white hover:bg-gray-800">Create User</button>
        </div>
      </div>
    </div>
  </div>

  <!-- edit user -->
  <div id="editUserModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/30 p-4">
    <div class="w-full max-w-[430px] overflow-hidden rounded-xl bg-white shadow-xl">
    <div class="flex items-center justify-between gap-3 border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-SemiBold line-clamp-1 text-[14px] break-all">Add User</div>
        <div class="mt-0.5 line-clamp-1 text-[10px] break-all text-gray-400">Create a new AirCue newsroom account.</div>
      </div>
      <div onclick="closeEditUser()" class="aspect-square h-fit w-fit cursor-pointer rounded-sm px-2 text-gray-400 hover:bg-gray-200 hover:text-black">
        <p class="cursor-pointer">×</p>
      </div>
    </div>
      <div class="space-y-4 p-5">
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> ID </label>
          <input id="edituserid" type="text" readonly placeholder="Enter user ID" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> EMAIL </label>
          <input id="editEmail" type="email" placeholder="Enter email address" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> FULL NAME </label>
          <input id="editFullname" type="text" placeholder="Enter full name" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> USERNAME </label>
          <input id="editUsername" type="text" placeholder="Enter username" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> ROLE </label>
          <select id="editRole" class="w-full rounded-lg border border-[#dddddd] bg-white px-3 py-2.5 text-[11px] outline-none focus:border-black">
            <option value="journalist">Journalist</option>
            <option value="producer">Producer</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div class="flex justify-end gap-2 border-t border-[#eeeeee] pt-4">
          <button type="button" onclick="closeEditUser()" class="rounded-lg cursor-pointer px-4 py-2.5 text-[10px] text-gray-500 hover:bg-gray-100">Cancel</button>
          <button id="editUserForm" class="Outfit-Medium cursor-pointer rounded-lg bg-black px-4 py-2.5 text-[10px] text-white hover:bg-gray-800">Save Changes</button>
        </div>
      </div>
    </div>
  </div>


  <div id="passwordChange" data-user-id="" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/30 p-4">
    <div class="w-full max-w-[430px] overflow-hidden rounded-xl bg-white shadow-xl">
    <div class="flex items-center justify-between gap-3 border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-SemiBold line-clamp-1 text-[14px] break-all">Change Password</div>
        <div class="mt-0.5 line-clamp-1 text-[10px] break-all text-gray-400">Update your password.</div>
      </div>
      <div onclick="closePasswordChange()" class="aspect-square h-fit w-fit cursor-pointer rounded-sm px-2 text-gray-400 hover:bg-gray-200 hover:text-black">
        <p class="cursor-pointer">×</p>
      </div>
    </div>
      <div class="space-y-4 p-5">
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"> NEW PASSWORD </label>
          <input id="newPassword" type="password" placeholder="Enter new password" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black" />
        </div>
        <div class="flex justify-end gap-2 border-t border-[#eeeeee] pt-4">
          <button type="button" onclick="closePasswordChange()" class="rounded-lg cursor-pointer px-4 py-2.5 text-[10px] text-gray-500 hover:bg-gray-100">Cancel</button>
          <button id="passwordChangeForm" class="Outfit-Medium cursor-pointer rounded-lg bg-black px-4 py-2.5 text-[10px] text-white hover:bg-gray-800">Save Changes</button>
        </div>
      </div>
    </div>
  </div>
</section>

</div>


  </main>

</div>
<%- include('partials/alert') -%>
<script>
function openAddUser() {
  const modal = document.getElementById("addUserModal");
  modal.classList.remove("hidden");
  modal.classList.add("flex");

}
function closeAddUser() {
  const modal = document.getElementById("addUserModal");
  modal.classList.add("hidden");
  modal.classList.remove("flex");
}
function openEditUser(id, fullname, email, username, role) {
  const modal = document.getElementById("editUserModal");
  document.getElementById("edituserid").value = id;
  document.getElementById("editFullname").value = fullname;
  document.getElementById("editEmail").value = email;
  document.getElementById("editUsername").value = username;
  document.getElementById("editRole").value = role;
  modal.classList.remove("hidden");
  modal.classList.add("flex");
}
function closeEditUser() {
  const modal = document.getElementById("editUserModal");
  modal.classList.add("hidden");
  modal.classList.remove("flex");
}
function openPasswordChange(id) {
  const modal = document.getElementById("passwordChange");
  modal.setAttribute("data-user-id", id);
  modal.classList.remove("hidden");
  modal.classList.add("flex");
}
function closePasswordChange() {
  const modal = document.getElementById("passwordChange");
  modal.classList.add("hidden");
  modal.classList.remove("flex");
}
function toggleUserMenu(button) {
  const menu = button.parentElement.querySelector(".user-menu");
  document.querySelectorAll(".user-menu").forEach(item => {
      if (item !== menu) {
        item.classList.add("hidden");
      }
    });
  menu.classList.toggle("hidden");
}

document.addEventListener("click", event => {
  if (
    !event.target.closest(".user-menu") &&
    !event.target.closest("[onclick^='toggleUserMenu']")
  ) {
  document.querySelectorAll(".user-menu").forEach(menu => {
    menu.classList.add("hidden");
  });
  }
});


document.getElementById("addUserModal").addEventListener("click", function(event) {
    if (event.target === this) {
      closeAddUser();
    }
  });


const addUserForm = document.getElementById("addUserForm")
const editUserForm = document.getElementById("editUserForm")
addUserForm.addEventListener("click", async (event) => {
    event.preventDefault();
    const user = {
      email: document.getElementById("newEmail").value.trim(),
      fullname: document.getElementById("newFullname").value.trim(),
      username: document.getElementById("newUsername").value.trim(),
      password: document.getElementById("newPassword").value,
      role: document.getElementById("newRole").value,
    };
    const response = await fetch("/api/add-user", {
      method: "POST",
      headers: { "Content-Type": "application/json"
      },
      body: JSON.stringify(user)
    });
    const data = await response.json();
    if(data.success) {
      showAlert('success', data.message || "User created successfully");
      closeAddUser();
      document.getElementById("newEmail").value = "";
      document.getElementById("newFullname").value = "";
      document.getElementById("newUsername").value = "";
      document.getElementById("newPassword").value = "";
      return;
    }
    if (!response.ok) {
      showAlert('error', data.message || "Unable to create user");
      return;
    }
    closeAddUser();
});


editUserForm.addEventListener("click", async (event) => {
    event.preventDefault();
    const userId = document.getElementById("edituserid").value;
    const user = {
      email: document.getElementById("editEmail").value.trim(),
      fullname: document.getElementById("editFullname").value.trim(),
      username: document.getElementById("editUsername").value.trim(),
      role: document.getElementById("editRole").value,
    };
    const response = await fetch(`/api/edit-user/${userId}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(user)
    });
    const data = await response.json();
    if(data.success) {
      showAlert('success', data.message || "User updated successfully");
      closeEditUser();
      getUsers();
      return;
    }
    if (!response.ok) {
      showAlert('error', data.message || "Unable to update user");
      return;
    }
});



function getUsers() {
  fetch("/api/users")
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        document.getElementById("userTb").innerHTML = ""
        document.getElementById("userTb").innerHTML = data.users.map(user => `
  <div class="grid gap-3 px-5 py-4 grid-cols-[1fr_140px_110px_100px] items-center">
    <div class="flex items-center gap-3">
      <div class="Outfit-Medium flex h-8 w-8 items-center justify-center rounded-full bg-gray-100 text-[9px] text-gray-600">${user.full_name.charAt(0).toUpperCase()}</div>
      <div>
        <div class="text-[11px] font-medium">${user.full_name}</div>
        <div class="mt-0.5 text-[9px] text-gray-400">@${user.username}</div>
      </div>
    </div>
    <div class="text-[10px] text-gray-500">${user.role}</div>
    <div class="flex items-center gap-2">
    ${user.status === 'active' ? `<span class="text-[9px] text-green-600"> Active </span>` : `</span><span class="text-[9px] text-red-600"> Deleted </span>`}
    </div>
    <div class="relative flex justify-end">
      <button type="button" onclick="toggleUserMenu(this)" class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-black">⋮</button>
      <div class="user-menu absolute top-9 right-0 z-20 hidden w-40 rounded-lg border border-[#e5e5e5] bg-white p-1.5 shadow-lg">
        <button type="button" onclick="openEditUser(${user.id}, '${user.full_name}', '${user.email}', '${user.username}', '${user.role}')" class="w-full rounded-md px-3 cursor-pointer py-2 text-left text-[10px] text-gray-600 hover:bg-gray-50">Edit User</button>
        <button type="button" onclick="openPasswordChange(${user.id})" class="w-full rounded-md px-3 cursor-pointer py-2 text-left text-[10px] text-gray-600 hover:bg-gray-50">Reset Password</button>
        <div class="my-1 border-t border-[#eeeeee]"></div>
        <button type="button" onclick="deleteUser(${user.id})" class="w-full rounded-md px-3 cursor-pointer py-2 text-left text-[10px] text-red-500 hover:bg-red-50">Delete User</button>
      </div>
    </div>
  </div>
        `).join('');
      } else {
        console.error("Failed to fetch users:", data.message);
      }
    })
    .catch(error => {
      console.error("Error fetching users:", error);
    });
}
getUsers()


function deleteUser(id){
  if(confirm("Are you sure you want to delete this user? This action cannot be undone.")){
    fetch(`/api/delete-user/${id}`, {
      method: "PUT"
    })
    .then(response => response.json())
    .then(data => {
      if(data.success){
        showAlert('success', data.message || "User deleted successfully");
        getUsers();
      } else {
        showAlert('error', data.message || "Failed to delete user");
      }
    })
    .catch(error => {
      console.error("Error deleting user:", error);
      showAlert('error', "An error occurred while deleting the user");
    });
  }
}

const passwordChangeForm = document.getElementById("passwordChangeForm")
passwordChangeForm.addEventListener("click", async (event) => {
    event.preventDefault();
    const userId = document.getElementById("passwordChange").getAttribute("data-user-id");
    const newPassword = document.getElementById("newPassword").value;
    if (!newPassword) {
      showAlert('error', "Please enter a new password");
      return;
    }
    fetch(`/api/reset-password/${userId}`, {
    method: "PUT",
    headers: {
        "Content-Type": "application/json"
    },
    body: JSON.stringify({
        newPassword: newPassword
    })
    })
    .then(response => response.json())
    .then(data => {
    if (data.success) {
        showAlert('success', data.message);
        document.getElementById("newPassword").value = "";
        closePasswordChange();
    } else {
        showAlert('error', data.message);
    }
    })
    .catch(error => {
        console.error(error);
        showAlert(
            'error',
            'An error occurred while resetting the password'
        );
    });
});

const breakingNewsPathInput = document.getElementById("breakingNewsPath");
const chTextPathInput = document.getElementById("chTextPath");
const graphicsIpInput = document.getElementById("graphicsIp");


function saveSettings(){
  fetch("/api/save-settings", {
    method: "PUT",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      breaking_path: breakingNewsPathInput.value,
      headline_path: chTextPathInput.value,
      graphics_ip: graphicsIpInput.value
    })
  })
  .then(response => response.json())
  .then(data => {
    if(data.success){
      showAlert('success', data.message || "Settings saved successfully");
    } else {
      showAlert('error', data.message || "Failed to save settings");
    }
  })
}

function getSettings(){
  fetch("/api/getSettings")
  .then(response => response.json())
  .then(data => {
    if(data.success){
      breakingNewsPathInput.value = data.data.breaking_path || "";
      chTextPathInput.value = data.data.headline_path || "";
      graphicsIpInput.value = data.data.graphics_ip || "";
    } else {
      showAlert('error', data.message || "Failed to load settings");
    }
  })
}
getSettings();

</script>
  </body>
</html>
