<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirCue | Profile</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon">

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f5f5f5;
        color: #171717;
      }
      .mono {
        font-family: "Courier New", monospace;
      }
      .scrollbar::-webkit-scrollbar {
        width: 5px;
        height: 5px;
      }
      .scrollbar::-webkit-scrollbar-thumb {
        background: #d4d4d4;
        border-radius: 10px;
      }
    </style>
  </head>

  <body class="Outfit-Regular">
    <div class="min-h-screen">

      <%- include('partials/header') -%>
  <main class="mx-auto max-w-[1150px] p-4 md:p-7">

<div class="mb-7">

  <div class="text-[10px] text-gray-400">
    ACCOUNT / PROFILE
  </div>

  <h1 class="Outfit-SemiBold mt-1 text-[26px] tracking-[-0.8px]">
    Profile
  </h1>

  <p class="mt-1 text-[11px] text-gray-400">
    Manage your AirCue account information.
  </p>

</div>


<div class="grid gap-5 lg:grid-cols-[300px_1fr]">


  <!-- LEFT -->

  <div class="space-y-5">


    <!-- PROFILE CARD -->

    <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">

      <div class="p-6">

        <div class="flex flex-col items-center text-center">

          <!-- AVATAR -->

          <div class="Outfit-SemiBold flex h-20 w-20 items-center justify-center rounded-full bg-[#1f1f1f] text-[22px] text-white">
          </div>


          <div class="mt-4">

            <div class="Outfit-SemiBold text-[16px]">
            </div>

            <div class="mt-1 text-[11px] text-gray-400">
            </div>

          </div>


          <div class="mt-3 rounded-full bg-gray-100 px-3 py-1.5 text-[9px] text-gray-600">
          </div>

        </div>

      </div>


      <div class="border-t border-[#eeeeee] px-5 py-3">

        <div class="flex items-center justify-between">

          <span class="text-[9px] text-gray-400">
            Account Status
          </span>

          <div class="flex items-center gap-2">

            <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>

            <span class="text-[9px] text-green-600">
              Active
            </span>

          </div>

        </div>

      </div>

    </section>


    <!-- ACCOUNT INFO -->

    <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">

      <div class="border-b border-[#eeeeee] px-5 py-4">

        <div class="Outfit-Medium text-[12px]">
          Account
        </div>

      </div>


      <div class="px-5">

        <div class="flex items-center justify-between border-b border-[#eeeeee] py-3">

          <span class="text-[9px] text-gray-400">
            User ID
          </span>

          <span class="text-[10px]">
          </span>

        </div>


        <div class="flex items-center justify-between border-b border-[#eeeeee] py-3">

          <span class="text-[9px] text-gray-400">
            Role
          </span>

          <span class="text-[10px]">
          </span>

        </div>


        <div class="flex items-center justify-between border-b border-[#eeeeee] py-3">

          <span class="text-[9px] text-gray-400">
            Joined
          </span>

          <span class="text-[10px]">
          </span>

        </div>


        <div class="flex items-center justify-between py-3">

          <span class="text-[9px] text-gray-400">
            Last Login
          </span>

          <span class="text-[10px]">
          </span>

        </div>

      </div>

    </section>

  </div>


  <!-- RIGHT -->

  <div class="space-y-5">


    <!-- PERSONAL INFORMATION -->

    <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">

      <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4">

        <div>

          <div class="Outfit-Medium text-[12px]">
            Personal Information
          </div>

          <div class="mt-0.5 text-[9px] text-gray-400">
            Update your account details.
          </div>

        </div>

      </div>


      <form id="profileForm" class="p-5">

        <div class="grid gap-4 sm:grid-cols-2">


          <!-- FULL NAME -->

          <div>

            <label
              for="fullname"
              class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"
            >
              FULL NAME
            </label>

            <input
              id="fullname"
              name="fullname"
              type="text"
              placeholder="Enter your full name"
              class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black"
            >

          </div>


          <!-- USERNAME -->

          <div>

            <label
              for="username"
              class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"
            >
              USERNAME
            </label>

            <input
              id="username"
              name="username"
              type="text"
              placeholder="Enter your username"
              class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black"
            >

          </div>


          <!-- EMAIL -->

          <div>

            <label
              for="email"
              class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"
            >
              EMAIL
            </label>

            <input
              id="email"
              name="email"
              type="email"
              placeholder="Enter your email"
              class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[11px] outline-none focus:border-black"
            >

          </div>


          <!-- ROLE -->

          <div>

            <label
              class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"
            >
              ROLE
            </label>

            <input
              type="text"
              disabled
              class="w-full cursor-not-allowed rounded-lg border border-[#eeeeee] bg-gray-50 px-3 py-2.5 text-[11px] text-gray-400"
            >

          </div>

        </div>


        <div class="mt-5 flex items-center justify-end gap-2 border-t border-[#eeeeee] pt-5">

          <button
            type="button"
            onclick="resetProfileForm()"
            class="rounded-lg px-4 py-2.5 text-[10px] text-gray-500 hover:bg-gray-100"
          >
            Cancel
          </button>

          <button
            type="submit"
            class="Outfit-Medium rounded-lg bg-black px-4 py-2.5 text-[10px] text-white hover:bg-gray-800"
          >
            Save Changes
          </button>

        </div>

      </form>

    </section>


    <!-- PASSWORD -->

    <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">

      <div class="border-b border-[#eeeeee] px-5 py-4">

        <div class="Outfit-Medium text-[12px]">
          Change Password
        </div>

        <div class="mt-0.5 text-[9px] text-gray-400">
          Update your account password.
        </div>

      </div>


      <form id="passwordForm" class="p-5">

        <div class="space-y-4">


          <!-- CURRENT PASSWORD -->

          <div>

            <label
              for="currentPassword"
              class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"
            >
              CURRENT PASSWORD
            </label>

            <div class="relative">

              <input
                id="currentPassword"
                name="currentPassword"
                type="password"
                placeholder="Enter current password"
                class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 pr-16 text-[11px] outline-none focus:border-black"
              >

              <button
                type="button"
                onclick="togglePassword('currentPassword', this)"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-[9px] text-gray-400 hover:text-black"
              >
                Show
              </button>

            </div>

          </div>


          <div class="grid gap-4 sm:grid-cols-2">


            <!-- NEW PASSWORD -->

            <div>

              <label
                for="newPassword"
                class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"
              >
                NEW PASSWORD
              </label>

              <div class="relative">

                <input
                  id="newPassword"
                  name="newPassword"
                  type="password"
                  placeholder="Enter new password"
                  class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 pr-16 text-[11px] outline-none focus:border-black"
                >

                <button
                  type="button"
                  onclick="togglePassword('newPassword', this)"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-[9px] text-gray-400 hover:text-black"
                >
                  Show
                </button>

              </div>

            </div>


            <!-- CONFIRM PASSWORD -->

            <div>

              <label
                for="confirmPassword"
                class="Outfit-Medium mb-1.5 block text-[9px] text-gray-500"
              >
                CONFIRM PASSWORD
              </label>

              <div class="relative">

                <input
                  id="confirmPassword"
                  name="confirmPassword"
                  type="password"
                  placeholder="Confirm new password"
                  class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 pr-16 text-[11px] outline-none focus:border-black"
                >

                <button
                  type="button"
                  onclick="togglePassword('confirmPassword', this)"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-[9px] text-gray-400 hover:text-black"
                >
                  Show
                </button>

              </div>

            </div>

          </div>

        </div>


        <div class="mt-5 flex justify-end border-t border-[#eeeeee] pt-5">

          <button
            type="submit"
            class="Outfit-Medium rounded-lg bg-black px-4 py-2.5 text-[10px] text-white hover:bg-gray-800"
          >
            Update Password
          </button>

        </div>

      </form>

    </section>


    <!-- SESSION -->

    <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">

      <div class="border-b border-[#eeeeee] px-5 py-4">

        <div class="Outfit-Medium text-[12px]">
          Current Session
        </div>

      </div>


      <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">

        <div>

          <div class="flex items-center gap-2">

            <span class="h-2 w-2 rounded-full bg-green-500"></span>

            <div class="text-[11px] font-medium">
              Current device
            </div>

          </div>

          <div class="mt-1 pl-4 text-[9px] text-gray-400">
            Windows • Web Browser
          </div>

        </div>


        <button
          type="button"
          onclick="logout()"
          class="rounded-lg border border-red-200 px-4 py-2.5 text-[10px] text-red-500 hover:bg-red-50"
        >
          Logout
        </button>

      </div>

    </section>

  </div>

</div>

  </main>
    </div>
  </body>
</html>
