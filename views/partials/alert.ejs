<style>
.alert-box{
    transition: opacity .3s ease, transform .3s ease;
}
</style>
<div id="alert_container"
    class="fixed top-0 right-0 h-svh w-full max-w-sm p-4 flex flex-col z-10000 justify-end gap-2 pointer-events-none">
</div>
<script>
const container = document.getElementById("alert_container");
function showAlert(type, message) {
    const isError = type === "error";
    const alert = document.createElement("div");
    alert.className =
        `alert-box pointer-events-auto relative overflow-hidden rounded border
        ${isError ? "border-red-500" : "border-green-500"}
        bg-white dark:bg-neutral-900 text-neutral-700 dark:text-neutral-200`;
    alert.innerHTML = `
        <div class="progress h-1 ${isError ? "bg-red-500" : "bg-green-500"}"></div>
        <div class="flex items-center gap-3 p-4 ${isError ? "bg-red-500/10" : "bg-green-500/10"}">
            <div class="rounded-full p-1 ${isError ? "bg-red-500/15 text-red-500" : "bg-green-500/15 text-green-500"}">
                ${
                    isError
                    ?
                    `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20" class="w-6 h-6">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16ZM8.28 7.22a.75.75 0 10-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd"/>
                    </svg>`
                    :
                    `<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20" class="w-6 h-6">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16Zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5Z" clip-rule="evenodd"/>
                    </svg>`
                }
            </div>
            <div class="flex-1">
                <h3 class="font-semibold text-sm ${isError ? "text-red-500" : "text-green-500"}">
                    ${isError ? "Error" : "Success"}
                </h3>
                <p class="text-xs">
                    ${message}
                </p>
            </div>
            <button class="alert-close ml-auto cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    class="w-4 h-4">
                    <path stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    `;
    container.appendChild(alert);
    const progress = alert.querySelector(".progress");
    let width = 100;
    const timer = setInterval(() => {
        width -= 1;
        progress.style.width = width + "%";
        if (width <= 0) {
            clearInterval(timer);
            closeAlert(alert);
        }
    }, 50);
    alert.dataset.timer = timer;
}
function closeAlert(alert){
    if(!alert || !alert.isConnected) return;
    clearInterval(alert.dataset.timer);
    alert.style.opacity = "0";
    alert.style.transform = "translateX(100%)";
    setTimeout(()=>{
        alert.remove();
    },300);
}
document.addEventListener("click",e=>{
    const btn = e.target.closest(".alert-close");
    if(!btn) return;
    closeAlert(btn.closest(".alert-box"));
});
</script>