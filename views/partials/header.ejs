<header class="h-[68px] border-b border-[#e5e5e5] bg-white">
  <div class="flex h-full items-center px-7 gap-2">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center bg-black">
        <div class="h-3.5 w-3.5 bg-white"></div>
      </div>
      <div>
        <div class="Outfit-Bold text-[17px] tracking-[-0.5px]">AirCue</div>
        <div class="text-[9px] text-gray-400">Newsroom</div>
      </div>
    </div>
        <nav class="ml-14 items-center gap-1 hidden md:flex">
        <a href="/dashboard" class="rounded-lg px-4 py-2 text-[12px] text-nowrap bg-gray-100 text-black Outfit-Medium"> Dashboard </a>
        <a href="/runorders" class="rounded-lg px-4 py-2 text-[12px] text-nowrap text-gray-500 hover:bg-gray-100 hover:text-black"> Run Orders </a>
        <a href="/stories" class="rounded-lg px-4 py-2 text-[12px] text-nowrap text-gray-500 hover:bg-gray-100 hover:text-black"> Stories </a>
        <a href="/controller" class="rounded-lg px-4 py-2 text-[12px] text-nowrap text-gray-500 hover:bg-gray-100 hover:text-black"> Teleprompter </a>
        </nav>
    <div class="ml-auto flex items-center gap-6">
      <div class="mono text-[12px] hidden md:block">
        <span id="clock">00:00:00</span>
      </div>
      <button class="hidden md:flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-[#1f1e1e] text-[10px]">
        <svg width="16" class="fill-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20 22H18V20C18 18.3431 16.6569 17 15 17H9C7.34315 17 6 18.3431 6 20V22H4V20C4 17.2386 6.23858 15 9 15H15C17.7614 15 20 17.2386 20 20V22ZM12 13C8.68629 13 6 10.3137 6 7C6 3.68629 8.68629 1 12 1C15.3137 1 18 3.68629 18 7C18 10.3137 15.3137 13 12 13ZM12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z"></path></svg>
      </button>
      <button id="mobileNavBtn" class="flex md:hidden h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-[#1f1e1e] text-[10px]">
        <svg width="20" class="fill-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18 18V20H6V18H18ZM21 11V13H3V11H21ZM18 4V6H6V4H18Z"></path></svg>  
      </button>  
    </div>
  </div>
</header>
<script>
  function updateClock() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2, "0");
    const m = String(now.getMinutes()).padStart(2, "0");
    const s = String(now.getSeconds()).padStart(2, "0");
    document.getElementById("clock").textContent =`${h}:${m}:${s}`;
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>

<nav id="mobileNav" data-status="false" class="h-[calc(100dvh-68px)] transition-all duration-300 fixed top-17 -left-64 w-full max-w-64 border-r border-[#e5e5e5] bg-white p-3">
  <div class="flex flex-col gap-1 border-b border-[#e5e5e5] pb-2">
    <a href="/dashboard" class="Outfit-Medium rounded-lg bg-gray-100 px-4 py-2 text-[12px] text-nowrap text-black"> Dashboard </a>
    <a href="/runorders" class="rounded-lg px-4 py-2 text-[12px] text-nowrap text-gray-500 hover:bg-gray-100 hover:text-black"> Run Orders </a>
    <a href="/stories" class="rounded-lg px-4 py-2 text-[12px] text-nowrap text-gray-500 hover:bg-gray-100 hover:text-black"> Stories </a>
    <a href="/controller" class="rounded-lg px-4 py-2 text-[12px] text-nowrap text-gray-500 hover:bg-gray-100 hover:text-black"> Teleprompter </a>
  </div>
  <div class="flex w-full pt-2">
    <button id="logout" class="flex w-full cursor-pointer rounded-lg px-4 py-2 text-[12px] text-nowrap text-red-500 hover:bg-red-100 hover:text-red-500">Logout</button>
  </div>
</nav>

<script>
  let mobileNav = document.getElementById("mobileNav");
  let mobileNavBtn = document.getElementById("mobileNavBtn");
  mobileNavBtn.addEventListener('click',() =>{
    if(mobileNav.dataset.status == 'false'){
      mobileNav.classList.add('left-0')
      mobileNav.classList.remove('-left-64')
      mobileNav.dataset.status = 'true';
      return;
    }
    if(mobileNav.dataset.status == 'true'){
      mobileNav.classList.add('-left-64')
      mobileNav.classList.remove('left-0')
      mobileNav.dataset.status = 'false';
      return;
    }
  })

  window.addEventListener('resize', ()=>{
    console.log(window.innerWidth)
      if(window.innerWidth > 768){
        if(mobileNav.dataset.status == 'true'){
          mobileNav.classList.add('-left-64')
          mobileNav.classList.remove('left-0')
          mobileNav.dataset.status = 'false';
          return;
        }
      }
  })

  document.getElementById("logout").addEventListener("click", () => {
      fetch('/api/logout', {
          method: 'POST',
          headers: {
              'Content-Type': 'application/json'
          }
      }).then(res => {
          if (res.ok) {
              window.location.href = '/login';
          }
      });
  });
</script>
