<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirCue | Login</title>
    <link rel="stylesheet" href="/css/output.css">
    <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon">
    <style>
      * {
          box-sizing: border-box;
      }
      body {
          margin: 0;
          font-family: Arial, Helvetica, sans-serif;
          background: #101214;
          color: #f4f4f4;
      }
      .grain {
          background-image:
              radial-gradient(rgba(255,255,255,.04) 1px, transparent 1px);
          background-size: 4px 4px;
      }
      .scanlines {
          background-image: linear-gradient(
              rgba(255,255,255,.025) 1px,
              transparent 1px
          );
          background-size: 100% 5px;
      }
      .mono {
          font-family: "Courier New", monospace;
      }
    </style>
  </head>
  <body class="min-h-screen overflow-hidden">
    <div class="grid min-h-screen lg:grid-cols-[58%_42%]">
      <section class="relative hidden overflow-hidden bg-[#17191b] lg:flex">
        <div class="grain absolute inset-0 opacity-40"></div>
        <div class="scanlines absolute inset-0 opacity-30"></div>
        <div class="absolute top-16 -left-12 text-[180px] leading-none font-black tracking-[-15px] text-white/[0.025] select-none">AC</div>
        <div class="relative z-10 w-full p-10">
          <div class="flex items-start justify-between">
            <div>
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center border border-white/30">
                  <div class="h-5 w-5 bg-white"></div>
                </div>
                <div>
                  <div class="text-[21px] font-bold tracking-[-0.5px]">AirCue</div>
                  <div class="text-[9px] tracking-[3px] text-white/40 uppercase">Newsroom System</div>
                </div>
              </div>
            </div>
            <div class="mono text-right">
              <div class="text-[10px] text-white/30 uppercase">System Time</div>
              <div id="clock" class="mt-1 text-sm text-white/80">00:00:00</div>
            </div>
          </div>
          <div class="absolute top-1/2 right-10 left-10 -translate-y-1/2">
            <div class="mb-8 flex items-center gap-3">
              <span class="text-[10px] tracking-[3px] text-white/50 uppercase"> Newsroom Control </span>
            </div>
            <h1 class="max-w-xl text-[64px] leading-[0.95] font-black tracking-[-3px]">
              READY<br />
              FOR AIR.
            </h1>
            <div class="mt-10 max-w-xl border-l border-white/20 pl-5">
              <p class="text-sm leading-6 text-white/45">Run orders, scripts, breaking news and teleprompter control, connected in real time.</p>
            </div>
            <div class="mt-12 max-w-2xl">
              <div class="mb-3 flex items-center justify-between">
                <span class="text-[9px] tracking-[2px] text-white/30 uppercase"> Current Rundown </span>
                <span class="mono text-[9px] text-white/30"> EVENING NEWS / 18:00 </span>
              </div>
              <div class="border border-white/10 bg-black/20">
                <div class="grid grid-cols-[45px_1fr_70px] items-center border-b border-white/10 px-4 py-3">
                  <span class="mono text-[10px] text-white/25"> 01 </span>
                  <span class="text-xs"> Opening </span>
                  <span class="text-right text-[9px] text-white/30"> 00:25 </span>
                </div>
                <div class="grid grid-cols-[45px_1fr_70px] items-center border-b border-white/10 bg-white/[0.04] px-4 py-3">
                  <span class="mono text-[10px] text-white/40"> 02 </span>
                  <span class="text-xs"> Government announces new project </span>
                  <span class="text-right text-[9px] text-white/40"> 01:42 </span>
                </div>
                <div class="grid grid-cols-[45px_1fr_70px] items-center px-4 py-3">
                  <span class="mono text-[10px] text-white/25"> 03 </span>
                  <span class="text-xs text-white/50"> Sports </span>
                  <span class="text-right text-[9px] text-white/25"> 02:10 </span>
                </div>
              </div>
            </div>
          </div>
          <div class="absolute right-10 bottom-8 left-10 flex items-end justify-between">
            <div class="mono text-[9px] tracking-[2px] text-white/20 uppercase">AIR CUE / CONTROL</div>
          </div>
        </div>
      </section>
      <section class="relative flex items-center justify-center bg-[#f1f0ec] text-[#17191b]">
        <div class="w-full max-w-[390px] px-8">
          <div class="mb-14 lg:hidden">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center bg-[#17191b]">
                <div class="h-4 w-4 bg-white"></div>
              </div>
                <span class="text-xl font-bold"> AirCue </span>
            </div>
          </div>
          <div class="mb-10">
            <h2 class="text-[38px] leading-none font-black tracking-[-1.5px]">Sign in.</h2>
            <p class="mt-4 text-sm text-black/45">Access your newsroom workspace.</p>
          </div>
          <div>
            <div class="mb-6">
              <label for="username" class="mb-3 block text-[10px] font-bold tracking-[2px] text-black/45 uppercase"> Username </label>
              <input id="username" name="username" type="text" autocomplete="username" required placeholder="Enter username" class="h-12 w-full border-b-2 border-black/15 bg-transparent text-sm transition outline-none placeholder:text-black/25 focus:border-black" />
            </div>
            <div class="mb-10">
              <div class="mb-3 flex items-center justify-between">
                <label for="password" class="block text-[10px] font-bold tracking-[2px] text-black/45 uppercase"> Password </label>
              </div>
              <input id="password" name="password" type="password" autocomplete="current-password" required placeholder="Enter password" class="h-12 w-full border-b-2 border-black/15 bg-transparent text-sm transition outline-none placeholder:text-black/25 focus:border-black" />
            </div>
            <button id="loginButton" class="flex h-12 w-full select-none cursor-pointer items-center justify-center bg-[#17191b] px-5 text-white hover:bg-black active:bg-black/80">
              <span class="animate-spin hidden" id="button_Loading">
                <svg width="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.9995 2C12.5518 2 12.9995 2.44772 12.9995 3V6C12.9995 6.55228 12.5518 7 11.9995 7C11.4472 7 10.9995 6.55228 10.9995 6V3C10.9995 2.44772 11.4472 2 11.9995 2ZM11.9995 17C12.5518 17 12.9995 17.4477 12.9995 18V21C12.9995 21.5523 12.5518 22 11.9995 22C11.4472 22 10.9995 21.5523 10.9995 21V18C10.9995 17.4477 11.4472 17 11.9995 17ZM20.6597 7C20.9359 7.47829 20.772 8.08988 20.2937 8.36602L17.6956 9.86602C17.2173 10.1422 16.6057 9.97829 16.3296 9.5C16.0535 9.02171 16.2173 8.41012 16.6956 8.13398L19.2937 6.63397C19.772 6.35783 20.3836 6.52171 20.6597 7ZM7.66935 14.5C7.94549 14.9783 7.78161 15.5899 7.30332 15.866L4.70525 17.366C4.22695 17.6422 3.61536 17.4783 3.33922 17C3.06308 16.5217 3.22695 15.9101 3.70525 15.634L6.30332 14.134C6.78161 13.8578 7.3932 14.0217 7.66935 14.5ZM20.6597 17C20.3836 17.4783 19.772 17.6422 19.2937 17.366L16.6956 15.866C16.2173 15.5899 16.0535 14.9783 16.3296 14.5C16.6057 14.0217 17.2173 13.8578 17.6956 14.134L20.2937 15.634C20.772 15.9101 20.9359 16.5217 20.6597 17ZM7.66935 9.5C7.3932 9.97829 6.78161 10.1422 6.30332 9.86602L3.70525 8.36602C3.22695 8.08988 3.06308 7.47829 3.33922 7C3.61536 6.52171 4.22695 6.35783 4.70525 6.63397L7.30332 8.13398C7.78161 8.41012 7.94549 9.02171 7.66935 9.5Z"></path></svg>
              </span>
              <span id="button_Text" class="text-xs font-bold tracking-[2px] uppercase"> Enter AirCue </span>
            </button>
        </div>
          <div class="mt-14 flex justify-between border-t border-black/10 pt-5">
            <span class="mono text-[8px] tracking-[2px] text-black/30 uppercase"> AIR CUE </span>
            <span class="mono text-[8px] tracking-[2px] text-black/30 uppercase"> v1.0.0 </span>
          </div>
        </div>
      </section>
    </div>

    <%- include('partials/alert') -%>

    <script>
        function updateClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, "0");
            const minutes = String(now.getMinutes()).padStart(2, "0");
            const seconds = String(now.getSeconds()).padStart(2, "0");
            document.getElementById("clock").textContent =`${hours}:${minutes}:${seconds}`;
        }
        updateClock();
      setInterval(updateClock, 1000);
    </script>
    <script src="/js/login.js"></script>
  </body>
</html>
