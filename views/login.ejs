<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AirCue | Login</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #101214;
            color: #f4f4f4;
        }

        .grain {
            background-image:
                radial-gradient(rgba(255,255,255,.04) 1px, transparent 1px);
            background-size: 4px 4px;
        }

        .scanlines {
            background-image: linear-gradient(
                rgba(255,255,255,.025) 1px,
                transparent 1px
            );
            background-size: 100% 5px;
        }

        .mono {
            font-family: "Courier New", monospace;
        }
    </style>
</head>

<body class="min-h-screen overflow-hidden">

<div class="min-h-screen grid lg:grid-cols-[58%_42%]">

    <!-- LEFT -->
    <section class="relative hidden lg:flex overflow-hidden bg-[#17191b]">

        <div class="absolute inset-0 grain opacity-40"></div>
        <div class="absolute inset-0 scanlines opacity-30"></div>

        <!-- Large AirCue mark -->
        <div class="absolute -left-12 top-16 text-[180px] leading-none font-black tracking-[-15px] text-white/[0.025] select-none">
            AC
        </div>

        <!-- Top information -->
        <div class="relative z-10 w-full p-10">

            <div class="flex justify-between items-start">

                <div>
                    <div class="flex items-center gap-3">

                        <div class="w-10 h-10 border border-white/30 flex items-center justify-center">
                            <div class="w-5 h-5 bg-white"></div>
                        </div>

                        <div>
                            <div class="text-[21px] font-bold tracking-[-0.5px]">
                                AirCue
                            </div>

                            <div class="text-[9px] uppercase tracking-[3px] text-white/40">
                                Newsroom System
                            </div>
                        </div>

                    </div>
                </div>

                <div class="text-right mono">
                    <div class="text-[10px] text-white/30 uppercase">
                        System Time
                    </div>

                    <div id="clock" class="text-sm text-white/80 mt-1">
                        00:00:00
                    </div>
                </div>

            </div>


            <!-- Main broadcast panel -->
            <div class="absolute left-10 right-10 top-1/2 -translate-y-1/2">

                <div class="flex items-center gap-3 mb-8">
                    <span class="text-[10px] uppercase tracking-[3px] text-white/50">
                        Newsroom Control
                    </span>

                </div>


                <h1 class="text-[64px] leading-[0.95] font-black tracking-[-3px] max-w-xl">
                    READY<br>
                    FOR AIR.
                </h1>


                <div class="mt-10 max-w-xl border-l border-white/20 pl-5">

                    <p class="text-sm leading-6 text-white/45">
                        Run orders, scripts, breaking news and
                        teleprompter control, connected in real time.
                    </p>

                </div>


                <!-- Fake rundown -->
                <div class="mt-12 max-w-2xl">

                    <div class="flex items-center justify-between mb-3">

                        <span class="text-[9px] uppercase tracking-[2px] text-white/30">
                            Current Rundown
                        </span>

                        <span class="mono text-[9px] text-white/30">
                            EVENING NEWS / 18:00
                        </span>

                    </div>


                    <div class="border border-white/10 bg-black/20">

                        <div class="grid grid-cols-[45px_1fr_70px] items-center px-4 py-3 border-b border-white/10">

                            <span class="mono text-[10px] text-white/25">
                                01
                            </span>

                            <span class="text-xs">
                                Opening
                            </span>

                            <span class="text-[9px] text-white/30 text-right">
                                00:25
                            </span>

                        </div>


                        <div class="grid grid-cols-[45px_1fr_70px] items-center px-4 py-3 border-b border-white/10 bg-white/[0.04]">

                            <span class="mono text-[10px] text-white/40">
                                02
                            </span>

                            <span class="text-xs">
                                Government announces new project
                            </span>

                            <span class="text-[9px] text-white/40 text-right">
                                01:42
                            </span>

                        </div>


                        <div class="grid grid-cols-[45px_1fr_70px] items-center px-4 py-3">

                            <span class="mono text-[10px] text-white/25">
                                03
                            </span>

                            <span class="text-xs text-white/50">
                                Sports
                            </span>

                            <span class="text-[9px] text-white/25 text-right">
                                02:10
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Bottom -->
            <div class="absolute bottom-8 left-10 right-10 flex justify-between items-end">

                <div class="mono text-[9px] uppercase tracking-[2px] text-white/20">
                    AIR CUE / CONTROL
                </div>

            </div>

        </div>

    </section>


    <!-- RIGHT -->
    <section class="relative flex items-center justify-center bg-[#f1f0ec] text-[#17191b]">

        <div class="w-full max-w-[390px] px-8">

            <!-- Mobile brand -->
            <div class="lg:hidden mb-14">

                <div class="flex items-center gap-3">

                    <div class="w-9 h-9 bg-[#17191b] flex items-center justify-center">
                        <div class="w-4 h-4 bg-white"></div>
                    </div>

                    <span class="font-bold text-xl">
                        AirCue
                    </span>

                </div>

            </div>


            <!-- Heading -->
            <div class="mb-10">
               
                <h2 class="text-[38px] leading-none font-black tracking-[-1.5px]">
                    Sign in.
                </h2>

                <p class="mt-4 text-sm text-black/45">
                    Access your newsroom workspace.
                </p>

            </div>


            <!-- Form -->
            <form action="/login" method="POST">

                <div class="mb-6">

                    <label
                        for="username"
                        class="block text-[10px] uppercase tracking-[2px] font-bold text-black/45 mb-3">
                        Username
                    </label>

                    <input
                        id="username"
                        name="username"
                        type="text"
                        autocomplete="username"
                        required
                        placeholder="Enter username"
                        class="w-full h-12 bg-transparent border-b-2 border-black/15 outline-none text-sm transition focus:border-black placeholder:text-black/25"
                    >

                </div>


                <div class="mb-5">

                    <div class="flex justify-between items-center mb-3">

                        <label
                            for="password"
                            class="block text-[10px] uppercase tracking-[2px] font-bold text-black/45">
                            Password
                        </label>

                        <a
                            href="/forgot-password"
                            class="text-[10px] uppercase tracking-[1px] text-black/40 hover:text-black">
                            Forgot?
                        </a>

                    </div>

                    <input
                        id="password"
                        name="password"
                        type="password"
                        autocomplete="current-password"
                        required
                        placeholder="Enter password"
                        class="w-full h-12 bg-transparent border-b-2 border-black/15 outline-none text-sm transition focus:border-black placeholder:text-black/25"
                    >

                </div>


                <div class="flex items-center mb-8">

                    <label class="flex items-center gap-3 cursor-pointer">

                        <input
                            type="checkbox"
                            name="remember"
                            class="w-4 h-4 accent-black">

                        <span class="text-xs text-black/45">
                            Keep me signed in
                        </span>

                    </label>

                </div>


                <button
                    type="submit"
                    class="group w-full h-12 bg-[#17191b] text-white flex items-center justify-between px-5 hover:bg-black transition">

                    <span class="text-xs uppercase tracking-[2px] font-bold">
                        Enter AirCue
                    </span>

                    <span class="text-lg transition-transform group-hover:translate-x-1">
                        →
                    </span>

                </button>

            </form>


            <!-- Footer -->
            <div class="mt-14 pt-5 border-t border-black/10 flex justify-between">

                <span class="mono text-[8px] uppercase tracking-[2px] text-black/30">
                    AIR CUE
                </span>

                <span class="mono text-[8px] uppercase tracking-[2px] text-black/30">
                    v1.0.0
                </span>

            </div>

        </div>

    </section>

</div>


<script>

    function updateClock() {

        const now = new Date();

        const hours = String(now.getHours()).padStart(2, "0");
        const minutes = String(now.getMinutes()).padStart(2, "0");
        const seconds = String(now.getSeconds()).padStart(2, "0");

        document.getElementById("clock").textContent =
            `${hours}:${minutes}:${seconds}`;
    }

    updateClock();

    setInterval(updateClock, 1000);

</script>

</body>
</html>