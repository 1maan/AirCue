<script>

const searchInput =
  document.getElementById("activitySearch");

const typeFilter =
  document.getElementById("typeFilter");

const userFilter =
  document.getElementById("userFilter");


function filterActivity() {

  const search =
    searchInput.value.toLowerCase().trim();

  const type =
    typeFilter.value;

  const user =
    userFilter.value;

  const items =
    document.querySelectorAll(".activity-item");

  let count = 0;


  items.forEach(item => {

    const text =
      item.textContent.toLowerCase();

    const itemType =
      item.dataset.type;

    const itemUser =
      item.dataset.user;


    const searchMatch =
      !search || text.includes(search);

    const typeMatch =
      type === "all" || itemType === type;

    const userMatch =
      user === "all" || itemUser === user;


    if (
      searchMatch &&
      typeMatch &&
      userMatch
    ) {

      item.classList.remove("hidden");
      count++;

    } else {

      item.classList.add("hidden");

    }

  });


  document
    .getElementById("activityCount")
    .textContent =
      `Showing ${count} activities`;

}

if(searchInput){
searchInput.addEventListener(
  "input",
  filterActivity
);
}
if(typeFilter){
typeFilter.addEventListener(
  "change",
  filterActivity
);
}
if(userFilter){
userFilter.addEventListener(
  "change",
  filterActivity
);
}


