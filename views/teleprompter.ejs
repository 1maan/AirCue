<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirCue | Teleprompter </title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon" />
</head>
<style>
    body{
        background-color: black;
        color: white;
    }
</style>
<script>
    (() => {
        const goFullscreen = () => {
            if (document.fullscreenElement) return;
            const page = document.documentElement;
            const requestFullscreen = page.requestFullscreen || page.webkitRequestFullscreen;
            if (requestFullscreen) {
                requestFullscreen.call(page).catch(() => {});
            }
        };
        window.addEventListener('load', goFullscreen);
        document.addEventListener('click', goFullscreen, { once: true });
        document.addEventListener('keydown', goFullscreen, { once: true });
    })();
</script>
<script src="/socket.io/socket.io.js"></script>
<body>
<div id="prompterPreview" dir="rtl" class="scrollbar select-none cursor-none h-full w-full overflow-y-auto leading-[1.45] text-white Outfit-Faseyha-Regular">

<% if(runDown.length === 0){ %>

<% } %>

<% if (runDownInfo) { %>
  <div class="py-16">
        <div class="flex flex-col w-full justify-center items-center">
            <span class="rounded-md text-[#7460ee] Outfit-Bold px-2 py-1 text-5xl h-fit uppercase"> <%= runDownInfo.name %> </span>
        </div>
  </div>

<% } %>

<% runDown.forEach(item => { %>

  <% if (item.item_type === 'story') { %>

    <div id="<%= item.id %>" class="flex flex-col w-full justify-center items-center mt-32">
        <span class="rounded-md text-[#e9ab2e] Outfit-Regular px-2 text-center py-1 text-[36px] h-fit"> <%= item.slug %> </span>
    </div>
<%
const formattedStory = (item.story_text || '')
  .replace(/<br\s*\/?>\r?\n?/gi, '\n')
  .replace(/\r\n?/g, '\n')
  .replace(/\n{2,}/g, '\n')
  .replace(/\n/g, '<br>')
  .replace(/__([^_]+)__/g, (_, text) =>
    `<span class="flex mt-40 w-full items-center justify-center rounded-xl border border-[#e9ab2e] text-[#e9ab2e] uppercase">
${text.trim()}
    </span>`
  );
%>

<div class="Outfit-Faseyha-Regular w-full bg-transparent outline-none border-b border-dashed border-white stoy"><%- formattedStory %></div>

  <% } else if (item.item_type === 'break') { %>
    <div class="my-10 flex text-5xl min-h-24 w-full items-center justify-center rounded-xl bg-red-500 Outfit-Medium">
      <%= item.break_name %>
    </div>
  <% } %>

<% }) %>

</div>
<style>
    .stoy{
        line-height: var(--line-ht);
        font-size: var(--line-fz);
        padding-top: 100px;
        padding-bottom: 200px;
        margin-bottom: 200px;
    }
</style>
<script>
const socket = io();

window.addEventListener('pagehide', () => {
    socket.disconnect();
});

window.addEventListener('pageshow', (event) => {
    if (event.persisted && !socket.connected) {
        socket.connect();
    }
});

socket.on('tele-settings-update', (data)=>{
    document.querySelectorAll('.stoy').forEach(element => {
        element.style.setProperty('--line-fz', `${data[0]}px`);
        element.style.setProperty('--line-ht', `${data[1]}px`);
    });
        prompterPreview.style.paddingLeft = `${data[2]}%`;
        prompterPreview.style.paddingRight = `${data[2]}%`;
        if(data[3]){
            prompterPreview.style.scale = `-1 1`;
        }else{
            prompterPreview.style.scale = `1`;
        }
    localStorage.setItem('tele-fontSize', data[0])
    localStorage.setItem('tele-lineHeight', data[1])
    localStorage.setItem('tele-margin', data[2])
})

socket.on('tele-jump-to', (data)=>{
    window.scrollTo({ top: 0, behavior: 'smooth' })
    window.location.href = `/teleprompter#${data}`
});
let prompterPreview = document.getElementById("prompterPreview")
if(localStorage.getItem('tele-fontSize')){
    document.querySelectorAll('.stoy').forEach(element => {
        element.style.setProperty('--line-fz', `${localStorage.getItem('tele-fontSize')}px`);
    });
}
if(localStorage.getItem('tele-lineHeight')){
    document.querySelectorAll('.stoy').forEach(element => {
        element.style.setProperty('--line-ht', `${localStorage.getItem('tele-lineHeight')}px`);
    });
}
if(localStorage.getItem('tele-margin')){
    prompterPreview.style.paddingLeft = `${localStorage.getItem('tele-margin')}%`;
    prompterPreview.style.paddingRight = `${localStorage.getItem('tele-margin')}%`;
}
if(localStorage.getItem('tele-mirror') == 'true'){
    prompterPreview.style.scale = `-1 1`;
}else{
    prompterPreview.style.scale = `1`;
}
</script>
</body>
</html>