<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found | AirCue</title>
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon">
  </head>

  <body class="Outfit-Regular bg-[#f5f5f5] text-black">
    <div class="flex min-h-screen flex-col">

      <main class="relative flex flex-1 items-center justify-center overflow-hidden px-5 py-12">
        <!-- Background detail -->
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.035]"
          style="
          background-image:
          linear-gradient(to right, #000 1px, transparent 1px),
          linear-gradient(to bottom, #000 1px, transparent 1px);
          background-size: 32px 32px;
        "
        ></div>

        <div class="relative w-full max-w-3xl">
          <div class="overflow-hidden rounded-2xl border border-[#e2e2e2] bg-white shadow-[0_8px_40px_rgba(0,0,0,0.04)]">
            <!-- Top bar -->
            <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-3">
                <span class="Outfit-Medium text-[10px] tracking-[0.14em] text-gray-500"> AIRCUE SYSTEM </span>
                <div class="rounded-md bg-gray-100 px-2 py-1 text-[9px] text-gray-400">ERROR 404</div>
            </div>

            <div class="grid md:grid-cols-[1fr_260px]">
              <!-- Main -->
              <div class="px-6 py-10 md:px-9 md:py-12">
                <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-gray-100 text-gray-500">
                  <svg width="22" height="22" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22V20H5V4H15V8H19V13H20.9998V7L16 2H3.9985C3.44749 2 3 2.44405 3 2.9918V21.0082C3 21.5447 3.44476 22 3.9934 22H12ZM21.5356 21.1212L19.4143 18.9999L21.5356 16.8786L20.1214 15.4644L18.0001 17.5857L15.8788 15.4644L14.4646 16.8786L16.5859 18.9999L14.4646 21.1212L15.8788 22.5354L18.0001 20.4141L20.1214 22.5354L21.5356 21.1212Z"></path></svg>
                </div>

                <div class="Outfit-SemiBold text-[12px] tracking-[0.16em] text-red-500 uppercase">Signal Lost</div>

                <h1 class="Outfit-SemiBold mt-2 text-[30px] leading-tight text-gray-900 md:text-[36px]">This page isn't on the rundown.</h1>

                <p class="mt-3 max-w-lg text-[11px] leading-5 text-gray-400">The page you requested may have been moved, removed, or the address may be incorrect. Return to the newsroom and continue from there.</p>

                <div class="mt-7 flex flex-wrap gap-2">
                  <a href="/" class="Outfit-Medium flex items-center gap-2 rounded-lg bg-black px-4 py-2.5 text-[10px] text-white transition hover:bg-gray-800">
                    <svg width="13" height="13" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19 21H5C4.44772 21 4 20.5523 4 20V11L1 11L11.3273 1.6115C11.7087 1.26475 12.2913 1.26475 12.6727 1.6115L23 11L20 11V20C20 20.5523 19.5523 21 19 21ZM6 19H18V9.15745L12 3.7029L6 9.15745V19Z"></path></svg>
                    Go to Stories
                  </a>

                  <button onclick="history.back()" class="Outfit-Medium flex cursor-pointer items-center gap-2 rounded-lg border border-[#dddddd] bg-white px-4 py-2.5 text-[10px] text-gray-600 transition hover:bg-gray-50 hover:text-black">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                      <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>

                    Go Back
                  </button>
                </div>
              </div>

              <!-- Right status panel -->
              <div class="border-t border-[#eeeeee] bg-[#fafafa] p-6 md:border-t-0 md:border-l max-md:hidden">
                <div class="text-[9px] tracking-[0.14em] text-gray-400 uppercase">System Status</div>

                <div class="mt-5 space-y-4">
                  <div class="flex items-center justify-between">
                    <div class="text-[10px] text-gray-500">AirCue</div>
                    <div class="flex items-center gap-1.5 text-[9px] text-green-600">
                      Online
                    </div>
                  </div>

                  <div class="h-px bg-[#eeeeee]"></div>

                  <div class="flex items-center justify-between">
                    <div class="text-[10px] text-gray-500">Requested Page</div>

                    <div class="text-[9px] text-red-500">Not Found</div>
                  </div>

                  <div class="h-px bg-[#eeeeee]"></div>

                  <div>
                    <div class="text-[9px] tracking-[0.12em] text-gray-400 uppercase">Quick Access</div>

                    <div class="mt-3 space-y-1">
                      <a href="/runorders" class="flex items-center justify-between rounded-lg px-3 py-2 text-[10px] text-gray-500 hover:bg-white hover:text-black">
                        Rundowns
                        <span>→</span>
                      </a>

                      <a href="/stories" class="flex items-center justify-between rounded-lg px-3 py-2 text-[10px] text-gray-500 hover:bg-white hover:text-black">
                        Stories
                        <span>→</span>
                      </a>

                      <a href="/controller" class="flex items-center justify-between rounded-lg px-3 py-2 text-[10px] text-gray-500 hover:bg-white hover:text-black">
                        Controller
                        <span>→</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bottom bar -->
            <div class="flex items-center justify-between border-t border-[#eeeeee] px-5 py-3 text-[9px] text-gray-300">
              <span>AirCue Newsroom System</span>

              <span>404 / PAGE NOT FOUND</span>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
