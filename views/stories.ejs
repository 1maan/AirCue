        <button onclick="saveStory()" class="rounded-lg bg-black px-4 py-2 text-[10px] font-medium text-white hover:bg-gray-800 cursor-pointer">Save Story</button>
      </div>
    </div>
    <!-- FORM -->
    <div class="p-6">
      <!-- SLUG -->
      <div class="mb-5">
        <label class="mb-2 block text-[10px] font-medium text-gray-500"> SLUG </label>
        <input id="slug" type="text" value="GOVERNMENT-POLICY" placeholder="Enter story slug" class="w-full rounded-lg border border-[#dddddd] px-3 py-3 text-[12px] font-medium uppercase outline-none focus:border-black Outfit-Faseyha-Regular" />
