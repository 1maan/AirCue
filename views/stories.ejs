<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirCue | Stories</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon">

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f5f5f5;
        color: #171717;
      }
      .scrollbar::-webkit-scrollbar {
        width: 5px;
        height: 5px;
      }
      .scrollbar::-webkit-scrollbar-thumb {
        background: #d4d4d4;
        border-radius: 10px;
      }
    </style>
  </head>

<body class="Outfit-Regular">
<div class="min-h-screen">
  <%- include('partials/header') -%>

  <main class="mx-auto max-w-375 p-4 md:p-7">
    <!-- PAGE HEADER -->
    <div class="mb-7 flex items-end justify-between gap-3">
      <div>
        <h1 class="Outfit-SemiBold text-[26px] tracking-[-0.8px] text-nowrap">Stories</h1>
        <p class="mt-1 line-clamp-1 text-[12px] break-all text-gray-400">Write and manage news stories</p>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="resertStoryEditor('true')" class="Outfit-Medium flex cursor-pointer gap-0.5 rounded-lg bg-black px-4 py-2 text-[11px] text-nowrap text-white hover:bg-gray-800">New Story</button>
      </div>
    </div>

    <!-- DATE BAR -->

    <div class="mb-5 flex items-center justify-between gap-3 overflow-hidden rounded-xl border border-[#e3e3e3] bg-white px-5 py-4">
     
      <div class="flex items-center justify-between gap-4 max-[470px]:w-full">
        <button id="prevDate" class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-[#dddddd] text-gray-500 hover:bg-gray-50">
          <svg width="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.8284 12.0005L14.6569 14.8289L13.2426 16.2431L9 12.0005L13.2426 7.75781L14.6569 9.17203L11.8284 12.0005Z"></path>
          </svg>
        </button>
          <div class="flex w-37.5 flex-col max-[470px]:items-center">
            <div id="selectedDateText" class="Outfit-Medium line-clamp-1 text-[13px] break-all max-[470px]:text-center"></div>
            <div id="selectedDateLabel" class="mt-0.5 line-clamp-2 text-[10px] break-all text-gray-400 max-[470px]:text-center"></div>
          </div>
        <button id="nextDate" class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-[#dddddd] text-gray-500 hover:bg-gray-50">
          <svg width="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.1717 12.0005L9.34326 9.17203L10.7575 7.75781L15.0001 12.0005L10.7575 16.2431L9.34326 14.8289L12.1717 12.0005Z"></path>
          </svg>
        </button>
      </div>


      <div class="hidden items-center gap-4 min-[470px]:flex">
        <div class="text-right">
          <div class="text-[9px] text-gray-400">STORIES</div>
          <div id="todaysTotalStories" class="text-[13px] font-semibold">0</div>
        </div>
        <div class="h-7 w-px bg-gray-200"></div>
        <div class="text-right">
          <div class="text-[9px] text-gray-400">READY</div>
          <div class="text-[13px] font-semibold text-green-600">0</div>
        </div>
      </div>
    </div>

    <!-- CONTENT -->

    <div class="grid min-h-[650px] grid-cols-1 gap-5 xl:grid-cols-[390px_1fr]">
      <!-- STORY LIST -->
      <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
        <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4">
          <div>
            <div id="titleStories" class="text-[13px] font-semibold">Today's Stories</div>
            <div id="totalStories" class="mt-0.5 text-[10px] text-gray-400">0 stories</div>
          </div>

          <div class="relative">
            <button id="filterBtn" onclick="toggleFilterMenu()" class="cursor-pointer flex items-center gap-2 rounded-lg border border-[#dddddd] px-3 py-2 text-[10px] text-gray-500 hover:bg-gray-50">
              <span id="filterText">Dhivehi</span>
              <svg width="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7 10L12 15L17 10H7Z"></path>
              </svg>
            </button>
            <div id="filterMenu" class="absolute top-10 right-0 z-30 hidden w-40 rounded-lg border border-[#e5e5e5] bg-white p-1.5 shadow-lg">
              <button onclick="selectLanguageFilter('en', 'English')" class="cursor-pointer w-full rounded-md px-3 py-2 text-left text-[10px] text-gray-600 hover:bg-gray-50">English</button>
              <button onclick="selectLanguageFilter('dv', 'Dhivehi')" class="cursor-pointer w-full rounded-md px-3 py-2 text-left text-[10px] text-gray-600 hover:bg-gray-50">Dhivehi</button>
            </div>
          </div>

        </div>
        <!-- SEARCH -->
        <div class="border-b border-[#eeeeee] p-3">
          <input type="text" id="searchStories" placeholder="Search stories..." class="w-full rounded-lg border border-[#e5e5e5] bg-gray-50 px-3 py-2.5 text-[11px] outline-none focus:border-black focus:bg-white" />
        </div>
        <!-- STORIES -->
        <div id="sideStories" class="scrollbar max-h-137.5 overflow-y-auto xl:max-h-175">
          <!-- STORY -->
        </div>
      </section>
      <!-- STORY EDITOR -->
      <section id="storyEditor" class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
        <!-- EDITOR HEADER -->
        <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4 gap-3">
          <div id="storyStatus" class="text-[13px] font-semibold break-all line-clamp-1">New Story</div>
          <div class="flex items-center gap-2">
            <button onclick="resertStoryEditor()" id="closeStoryBtn" class="hidden rounded-lg px-4 py-2 text-[11px] cursor-pointer text-gray-500 hover:bg-gray-100 text-nowrap">Cancel</button>
            <button onclick="saveStory()" id="saveStoryBtn" class="cursor-pointer w-23.25 rounded-lg bg-black px-4 py-2 text-[10px] font-medium text-white hover:bg-gray-800 text-nowrap">Save Story</button>
          </div>
        </div>
        <!-- FORM -->
        <div class="p-6">
          <!-- SLUG -->
          <div class="mb-5">
            <label class="mb-2 block text-[10px] font-medium text-gray-500"> SLUG </label>
            <input id="slug" type="text" value="" placeholder="Enter story slug" class="Outfit-Faseyha-Regular w-full rounded-lg border border-[#dddddd] px-3 py-3 text-[12px] font-medium uppercase outline-none focus:border-black" />
            <div class="mt-1.5 text-[9px] text-gray-400">Short identifier used by the newsroom.</div>
          </div>
          <!-- CG -->
          <div class="mb-5">
            <div class="mb-2 flex items-center justify-between">
              <label class="text-[10px] font-medium text-gray-500"> CG TEXT </label>
              <div class="flex items-center gap-3 text-[9px] text-gray-400">
                <label class="relative inline-flex cursor-pointer items-center">
                  <input id="cgToggle" type="checkbox" class="peer sr-only" checked />
                  <div class="h-4 w-8 rounded-full bg-gray-200 transition peer-checked:bg-black"></div>
                  <div class="absolute top-0.5 left-0.5 h-3 w-3 rounded-full bg-white shadow-sm transition peer-checked:translate-x-4"></div>
                  <span class="ml-2 text-[10px] text-gray-500"> EN / DV </span>
                </label>
              </div>
            </div>
            <input id="cg" type="text" value="" placeholder="Enter CG text" class="Outfit-Faseyha-Regular w-full rounded-lg border border-[#dddddd] px-3 py-3 text-sm outline-none focus:border-black" />
            <div class="mt-1.5 text-[9px] text-gray-400">This text can be sent directly to the graphics system.</div>
          </div>

          <!-- CG TEXT PREVIEW -->
          <div class="mb-5 w-full">
            <div class="headline-preview overflow-hidden relative w-full" style="container-type: inline-size;">
              <img src="/img/headlineBarPreview.png" alt="" class="block h-auto w-full">
              <div id="cg_text_preview" class="absolute text-right text-nowrap right-[8.5%] top-[57%] -translate-y-1/2 text-black" style="font-size: 2.47cqw; font-weight: bold;">
              ބޭރު ފައިސާގެ އެކްސްޗޭންޖް ހާލަތުގޯސްވުމުގެ މައްސަލައިގައި އެމްއެމްއޭގެ ގަވަރުނަރު މަޖިލީހަށް ހާޒިރުކުރަން އެމްޑީޕީއިން އެދިއްޖެ
              </div>
            </div>
          </div>

          <!-- STORY TEXT -->
          <div class="mb-5">
            <div class="mb-2 flex items-center justify-between">
              <label class="text-[10px] font-medium text-gray-500"> STORY TEXT </label>
              <div class="flex items-center gap-3 text-[9px] text-gray-400">
                <label class="relative inline-flex cursor-pointer items-center">
                  <input id="languageToggle" type="checkbox" class="peer sr-only" checked />
                  <div class="h-4 w-8 rounded-full bg-gray-200 transition peer-checked:bg-black"></div>
                  <div class="absolute top-0.5 left-0.5 h-3 w-3 rounded-full bg-white shadow-sm transition peer-checked:translate-x-4"></div>
                  <span class="ml-2 text-[10px] text-gray-500"> EN / DV </span>
                </label>
              </div>
            </div>
            <textarea
            id="storyText"
            class="Outfit-Faseyha-Regular scrollbar min-h-100 w-full resize-none rounded-lg border border-[#dddddd] px-4 py-3 text-sm leading-6 outline-none focus:border-black"
            style="font-family: 'Outfit-Regular', 'Faseyha-Regular';"
            placeholder="..."></textarea>
            <div class="flex items-center justify-end gap-1 mt-3">
              <button onclick="copyType('PKG')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">PKG</button>
              <button onclick="copyType('VAR')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">VAR</button>
              <button onclick="copyType('INT')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">INT</button>
            </div>
          </div>

          <!-- STORY INFO -->
          <!-- <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="text-[9px] text-gray-400">CREATED BY</div>
              <div class="mt-1 text-[11px] font-medium">Hussain</div>
            </div>
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="text-[9px] text-gray-400">CREATED</div>
              <div class="mt-1 text-[11px] font-medium">09:42</div>
            </div>
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="mt-1 text-[11px] font-medium text-green-600">Ready</div>
            </div>
          </div> -->
        </div>
      </section>
    </div>
  </main>
</div>
<%- include('partials/alert') -%>
<script src="/js/stories.js"></script>
</body>
</html>
