              <span class="ml-2 text-[10px] text-gray-500">
                EN / DV
              </span>
            </label>
          </div>
        </div>
        <input id="cg" type="text" dir="rtl" value="" placeholder="Enter CG text" class="w-full rounded-lg border border-[#dddddd] px-3 py-3 text-sm outline-none focus:border-black Outfit-Faseyha-Regular" />
        <div class="mt-1.5 text-[9px] text-gray-400">This text can be sent directly to the graphics system.</div>
      </div>
      <!-- STORY TEXT -->
      <div class="mb-5">
        <div class="mb-2 flex items-center justify-between">
          <label class="text-[10px] font-medium text-gray-500"> STORY TEXT </label>
          <div class="flex items-center gap-3 text-[9px] text-gray-400">
            <label class="relative inline-flex cursor-pointer items-center">
              <input id="languageToggle" type="checkbox" class="peer sr-only" checked>
              <div class="h-4 w-8 rounded-full bg-gray-200 transition peer-checked:bg-black"></div>
              <div class="absolute left-0.5 top-0.5 h-3 w-3 rounded-full bg-white shadow-sm transition peer-checked:translate-x-4"></div>
              <span class="ml-2 text-[10px] text-gray-500">
                EN / DV
              </span>
            </label>
          </div>
        </div>
        <textarea id="storyText" dir="rtl" rows="18" placeholder="Write the news story here" class="w-full rounded-lg border border-[#dddddd] px-4 py-3 text-sm leading-6 outline-none focus:border-black Outfit-Faseyha-Regular">

އީރާނުގެ ބަނދަރުތައް ބަންދުކުރުމަށް (ނޭވަލް ބްލޮކޭޑް) ހަރަކާތްތެރިވާ ފަރާތްތަކުން ދިން އިންޒާރުތަކަށް އެ އުޅަނދުގެ ފަޅުވެރިން އިޖާބަ ނުދިނުމާ ގުޅިގެން، އެމެރިކާގެ އަސްކަރީ ހެލިކޮޕްޓަރަކުން ޕެނަމާގެ ދިދަ ނަގާފައިވާ އުޅަނދެއްގެ ހުންގާނަށް ހަމަލާދީފި ކަމަށް ވޯލް ސްޓްރީޓް ޖާނަލްއިން ރިޕޯޓްކޮށްފި އެވެ. އަންގާރަ ދުވަހު އެ ނޫހުން މި ޚަބަރު ފެތުރީ އެމެރިކާ ސަރުކާރުގެ އޮފިޝަލަކާ ހަވާލާދީ އެވެ.

މި ހާދިސާގައި އެއްވެސް މީހަކަށް އަނިޔާވި ކަމުގެ ރިޕޯޓެއް މިހާތަނަށް ލިބިފައި ނުވާ ކަމަށް އެ ނޫހުން ބުނެ އެވެ. އަދި މި ހަމަލާއަށްފަހު، އެ އުޅަނދުގައި ތިބި ފަޅުވެރިން މަދަނީ އެހެން އުޅަނދަކަށް ބަދަލުވުމަށް މަސައްކަތް ކުރަމުންދާ ކަމަށް ވެސް އެ ރިޕޯޓުގައި ފާހަގަކޮށްފައިވެ އެވެ.

ބްރިޓިޝް މެރިޓައިމް ރިސްކް މެނޭޖްމަންޓް ގްރޫޕް، "ވޭންގާޑް" އާއި ކަނޑުގެ ސަލާމަތީ ކަންކަމާ ގުޅޭ މަސްދަރަކުން މީގެ ކުރިން ބުނެފައިވާ ގޮތުގައި، ފުރަތަމަ ލިބުނު މައުލޫމާތުތަކަށް ބަލާއިރު ޕެނަމާގެ ދިދަ ނަގާފައިވާ "ވޭލާ ނޯވާ" ނަމަކަށް ކިޔާ ކޮންޓެއިނަރު އުޅަނދަށް އޮމާން ކަނޑުން ދަތުރުކުރަނިކޮށް މިސައިލް ހަމަލާއެއް އަމާޒުވެފައިވާ ކަމަށް ބެލެވެ އެވެ.

        </textarea>
<div class="flex items-center gap-1 justify-end">
  <button onclick="copyType('PKG')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">PKG</button>
  <button onclick="copyType('VAR')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">VAR</button>
  <button onclick="copyType('INT')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">INT</button>
</div>


      </div>

      
      <!-- STORY INFO -->
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-lg bg-gray-50 p-3">
          <div class="text-[9px] text-gray-400">CREATED BY</div>
          <div class="mt-1 text-[11px] font-medium">Hussain</div>
