<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirCue | Stories</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon">

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f5f5f5;
        color: #171717;
      }
      .scrollbar::-webkit-scrollbar {
        width: 5px;
        height: 5px;
      }
      .scrollbar::-webkit-scrollbar-thumb {
        background: #d4d4d4;
        border-radius: 10px;
      }
    </style>
  </head>

<body class="Outfit-Regular">
<div class="min-h-screen">
  <%- include('partials/header') -%>

  <main class="mx-auto max-w-375 p-4 md:p-7">
    <!-- PAGE HEADER -->
    <div class="mb-7 flex items-end justify-between gap-3">
      <div>
        <h1 class="Outfit-SemiBold text-[26px] tracking-[-0.8px] text-nowrap">Stories</h1>
        <p class="mt-1 line-clamp-1 text-[12px] break-all text-gray-400">Write and manage today's news stories.</p>
      </div>
      <div class="flex items-center gap-2">
        <button class="Outfit-Medium flex cursor-pointer gap-0.5 rounded-lg bg-black px-4 py-2 text-[11px] text-nowrap text-white hover:bg-gray-800">New Story</button>
      </div>
    </div>

    <!-- DATE BAR -->

    <div class="mb-5 flex items-center justify-between gap-3 overflow-hidden rounded-xl border border-[#e3e3e3] bg-white px-5 py-4">
      <div class="flex items-center justify-between gap-4 max-[470px]:w-full">
        <button class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-[#dddddd] text-gray-500 hover:bg-gray-50">
          <svg width="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.8284 12.0005L14.6569 14.8289L13.2426 16.2431L9 12.0005L13.2426 7.75781L14.6569 9.17203L11.8284 12.0005Z"></path></svg>
        </button>
        <div class="flex w-33.75 flex-col max-[470px]:items-center">
          <div class="Outfit-Medium line-clamp-2 text-[13px] break-all max-[470px]:text-center">Tuesday, 11 Aug 2026</div>
          <div class="mt-0.5 line-clamp-2 text-[10px] break-all text-gray-400 max-[470px]:text-center">Today’s newsroom story lineup</div>
        </div>
        <button class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-[#dddddd] text-gray-500 hover:bg-gray-50">
          <svg width="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12.1717 12.0005L9.34326 9.17203L10.7575 7.75781L15.0001 12.0005L10.7575 16.2431L9.34326 14.8289L12.1717 12.0005Z"></path></svg>
        </button>
      </div>

      <div class="hidden items-center gap-4 min-[470px]:flex">
        <div class="text-right">
          <div class="text-[9px] text-gray-400">STORIES</div>
          <div class="text-[13px] font-semibold">14</div>
        </div>
        <div class="h-7 w-px bg-gray-200"></div>
        <div class="text-right">
          <div class="text-[9px] text-gray-400">READY</div>
          <div class="text-[13px] font-semibold text-green-600">9</div>
        </div>
      </div>
    </div>

    <!-- CONTENT -->

    <div class="grid min-h-[650px] grid-cols-1 gap-5 xl:grid-cols-[390px_1fr]">
      <!-- STORY LIST -->
      <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
        <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4">
          <div>
            <div class="text-[13px] font-semibold">Today's Stories</div>
            <div class="mt-0.5 text-[10px] text-gray-400">14 stories</div>
          </div>
          <button class="rounded-lg border border-[#dddddd] px-3 py-2 text-[10px] text-gray-500 hover:bg-gray-50">Filter</button>
        </div>
        <!-- SEARCH -->
        <div class="border-b border-[#eeeeee] p-3">
          <input type="text" placeholder="Search stories..." class="w-full rounded-lg border border-[#e5e5e5] bg-gray-50 px-3 py-2.5 text-[11px] outline-none focus:border-black focus:bg-white" />
        </div>
        <!-- STORIES -->
        <div class="scrollbar max-h-137.5 overflow-y-auto xl:max-h-197.5">
          <!-- STORY -->
          <button onclick="selectStory('1')" class="story-item w-full cursor-pointer border-b border-[#eeeeee] bg-gray-50 p-4 text-left" data-story="1">
            <div class="flex items-start gap-3">
              <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-black text-[9px] text-white">01</div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <div class="truncate text-[12px] font-medium">GOVERNMENT-POLICY</div>
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-green-500"></span>
                </div>
                <div class="Faseyha-Regular mt-1 truncate text-[10px] text-gray-400">ޑީސަލް ގަންނަން އެހީވުމަށް އޭޑީބީން ރާއްޖެއަށް 50 މިލިއަން ޑޮލަރުގެ އިމަޖެންސީ ލޯނެއް ދެނީ</div>
                <div class="mt-2 flex gap-3 text-[9px] text-gray-400">
                  <span> 09:42 </span>
                  <span> 245 words </span>
                </div>
              </div>
            </div>
          </button>
          <!-- STORY -->
          <button onclick="selectStory('2')" class="story-item w-full cursor-pointer border-b border-[#eeeeee] p-4 text-left hover:bg-gray-50" data-story="2">
            <div class="flex items-start gap-3">
              <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-gray-100 text-[9px] text-gray-500">02</div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <div class="truncate text-[12px] font-medium">Heavy rain expected tonight</div>
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-yellow-500"></span>
                </div>
                <div class="Faseyha-Regular mt-1 truncate text-[10px] text-gray-400">ޑީސަލް ގަންނަން އެހީވުމަށް އޭޑީބީން ރާއްޖެއަށް 50 މިލިއަން ޑޮލަރުގެ އިމަޖެންސީ ލޯނެއް ދެނީ</div>
                <div class="mt-2 flex gap-3 text-[9px] text-gray-400">
                  <span> 10:15 </span>
                  <span> 182 words </span>
                </div>
              </div>
            </div>
          </button>
          <!-- STORY -->
          <button onclick="selectStory('3')" class="story-item w-full cursor-pointer border-b border-[#eeeeee] p-4 text-left hover:bg-gray-50" data-story="3">
            <div class="flex items-start gap-3">
              <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-gray-100 text-[9px] text-gray-500">03</div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <div class="truncate text-[12px] font-medium">Local team reaches final</div>
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-green-500"></span>
                </div>
                <div class="Faseyha-Regular mt-1 truncate text-[10px] text-gray-400">މިސަރުކާރުގައި އުޅެނީ މެނޭޖުކުރަން ނޭނގުމުގެ މައްސަލަ ކަމަށް ފައިސަލް ވިދާޅުވެއްޖެ</div>
                <div class="mt-2 flex gap-3 text-[9px] text-gray-400">
                  <span> 11:20 </span>
                  <span> 310 words </span>
                </div>
              </div>
            </div>
          </button>
          <!-- STORY -->
          <button onclick="selectStory('4')" class="story-item w-full cursor-pointer border-b border-[#eeeeee] p-4 text-left hover:bg-gray-50" data-story="4">
            <div class="flex items-start gap-3">
              <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-gray-100 text-[9px] text-gray-500">04</div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <div class="truncate text-[12px] font-medium">New development project</div>
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-gray-300"></span>
                </div>
                <div class="Faseyha-Regular mt-1 truncate text-[10px] text-gray-400">ޓްރަމްޕްގެ ކެމްޕޭން ވީޑިއޯތަކުން ޓޭލާ ސުވިފްޓްގެ ލަވަތައް އުނިކޮށްފި</div>
                <div class="mt-2 flex gap-3 text-[9px] text-gray-400">
                  <span> 12:04 </span>
                  <span> Draft </span>
                </div>
              </div>
            </div>
          </button>
          <!-- STORY -->
          <button onclick="selectStory('5')" class="story-item w-full cursor-pointer border-b border-[#eeeeee] p-4 text-left hover:bg-gray-50" data-story="5">
            <div class="flex items-start gap-3">
              <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-gray-100 text-[9px] text-gray-500">05</div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <div class="truncate text-[12px] font-medium">Airport introduces new service</div>
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-green-500"></span>
                </div>
                <div class="Faseyha-Regular mt-1 truncate text-[10px] text-gray-400">އެމެރިކާގެ އަސްކަރިއްޔާގެ އިންޒާރުތަކަށް އިޖާބަ ނުދީ އޮމާން ކަނޑުން ދަތުރުކުރި ބޯޓަކަށް ހަމަލާ ދީފި</div>
                <div class="mt-2 flex gap-3 text-[9px] text-gray-400">
                  <span> 12:40 </span>
                  <span> 201 words </span>
                </div>
              </div>
            </div>
          </button>
        </div>
      </section>
      <!-- STORY EDITOR -->
      <section class="overflow-hidden rounded-xl border border-[#e3e3e3] bg-white">
        <!-- EDITOR HEADER -->
        <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4">
          <div id="storyStatus" data-storyID="0" data-status="new" class="text-[13px] font-semibold">New Story</div>
          <div class="flex items-center gap-2">
            <button onclick="saveStory()" class="cursor-pointer rounded-lg bg-black px-4 py-2 text-[10px] font-medium text-white hover:bg-gray-800">Save Story</button>
          </div>
        </div>
        <!-- FORM -->
        <div class="p-6">
          <!-- SLUG -->
          <div class="mb-5">
            <label class="mb-2 block text-[10px] font-medium text-gray-500"> SLUG </label>
            <input id="slug" type="text" value="" placeholder="Enter story slug" class="Outfit-Faseyha-Regular w-full rounded-lg border border-[#dddddd] px-3 py-3 text-[12px] font-medium uppercase outline-none focus:border-black" />
            <div class="mt-1.5 text-[9px] text-gray-400">Short identifier used by the newsroom.</div>
          </div>
          <!-- CG -->
          <div class="mb-5">
            <div class="mb-2 flex items-center justify-between">
              <label class="text-[10px] font-medium text-gray-500"> CG TEXT </label>
              <div class="flex items-center gap-3 text-[9px] text-gray-400">
                <label class="relative inline-flex cursor-pointer items-center">
                  <input id="cgToggle" type="checkbox" class="peer sr-only" checked />
                  <div class="h-4 w-8 rounded-full bg-gray-200 transition peer-checked:bg-black"></div>
                  <div class="absolute top-0.5 left-0.5 h-3 w-3 rounded-full bg-white shadow-sm transition peer-checked:translate-x-4"></div>
                  <span class="ml-2 text-[10px] text-gray-500"> EN / DV </span>
                </label>
              </div>
            </div>
            <input id="cg" type="text" dir="rtl" value="" placeholder="Enter CG text" class="Outfit-Faseyha-Regular w-full rounded-lg border border-[#dddddd] px-3 py-3 text-sm outline-none focus:border-black" />
            <div class="mt-1.5 text-[9px] text-gray-400">This text can be sent directly to the graphics system.</div>
          </div>
          <!-- STORY TEXT -->
          <div class="mb-5">
            <div class="mb-2 flex items-center justify-between">
              <label class="text-[10px] font-medium text-gray-500"> STORY TEXT </label>
              <div class="flex items-center gap-3 text-[9px] text-gray-400">
                <label class="relative inline-flex cursor-pointer items-center">
                  <input id="languageToggle" type="checkbox" class="peer sr-only" checked />
                  <div class="h-4 w-8 rounded-full bg-gray-200 transition peer-checked:bg-black"></div>
                  <div class="absolute top-0.5 left-0.5 h-3 w-3 rounded-full bg-white shadow-sm transition peer-checked:translate-x-4"></div>
                  <span class="ml-2 text-[10px] text-gray-500"> EN / DV </span>
                </label>
              </div>
            </div>
            <textarea id="storyText" dir="rtl" rows="18" placeholder="Write the news story here" class="Outfit-Faseyha-Regular w-full rounded-lg border border-[#dddddd] px-4 py-3 text-sm leading-6 outline-none focus:border-black"> </textarea>
            <div class="flex items-center justify-end gap-1">
              <button onclick="copyType('PKG')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">PKG</button>
              <button onclick="copyType('VAR')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">VAR</button>
              <button onclick="copyType('INT')" class="cursor-pointer rounded-md border border-gray-200 px-3 py-1.5 text-[10px] font-medium text-gray-600 hover:bg-gray-100 hover:text-black">INT</button>
            </div>
          </div>

          <!-- STORY INFO -->
          <!-- <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="text-[9px] text-gray-400">CREATED BY</div>
              <div class="mt-1 text-[11px] font-medium">Hussain</div>
            </div>
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="text-[9px] text-gray-400">CREATED</div>
              <div class="mt-1 text-[11px] font-medium">09:42</div>
            </div>
            <div class="rounded-lg bg-gray-50 p-3">
              <div class="mt-1 text-[11px] font-medium text-green-600">Ready</div>
            </div>
          </div> -->
        </div>
      </section>
    </div>
  </main>
</div>
<%- include('partials/alert') -%>
<script src="/js/stories.js"></script>
</body>
</html>
