        <div class="flex items-start gap-3">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-gray-100 text-[9px] text-gray-500">02</div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-2">
              <div class="truncate text-[12px] font-medium">Heavy rain expected tonight</div>
              <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-yellow-500"></span>
            </div>
            <div class="mt-1 truncate text-[10px] text-gray-400 Faseyha-Regular">
            ޑީސަލް ގަންނަން އެހީވުމަށް އޭޑީބީން ރާއްޖެއަށް 50 މިލިއަން ޑޮލަރުގެ އިމަޖެންސީ ލޯނެއް ދެނީ
            </div>
