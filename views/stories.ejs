      </div>
      <!-- CG -->
      <div class="mb-5">
        <div class="mb-2 flex items-center justify-between">
          <label class="text-[10px] font-medium text-gray-500"> CG TEXT </label>
          <div class="flex items-center gap-3 text-[9px] text-gray-400">
            <label class="relative inline-flex cursor-pointer items-center">
              <input id="cgToggle" type="checkbox" class="peer sr-only" checked>
              <div class="h-4 w-8 rounded-full bg-gray-200 transition peer-checked:bg-black"></div>
