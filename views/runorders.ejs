<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AirCue | Run Order</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="/css/output.css" />
    <link rel="shortcut icon" href="/img/logo.svg" type="image/x-icon">

    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: #f5f5f5;
        color: #171717;
      }
      .mono {
        font-family: "Courier New", monospace;
      }
      .scrollbar::-webkit-scrollbar {
        width: 5px;
        height: 5px;
      }
      .scrollbar::-webkit-scrollbar-thumb {
        background: #d4d4d4;
        border-radius: 10px;
      }
    </style>
  </head>
<script src="/socket.io/socket.io.js"></script>
  <body class="Outfit-Regular">
    <div class="min-h-screen">

      <%- include('partials/header') -%>



<main class="mx-auto max-w-375 p-4 md:p-7">


<!-- PAGE HEADER -->
<div class="mb-7 flex items-end justify-between gap-3">
    <div>
      <h1 class="Outfit-SemiBold text-[26px] tracking-[-0.8px] text-nowrap">Run Orders</h1>
      <p class="mt-1 text-[12px] text-gray-400 break-all line-clamp-1">Plan and manage today's broadcasts.</p>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="openPresetModal()" class="Outfit-Medium cursor-pointer rounded-lg border border-[#dddddd] bg-white px-4 py-2 text-[11px] text-nowrap hover:bg-gray-50">Use Preset</button>
      <button onclick="openCreateModal()" class="Outfit-Medium flex cursor-pointer gap-0.5 rounded-lg bg-black px-4 py-2 text-[11px] text-nowrap text-white hover:bg-gray-800">New <span class="hidden sm:block">Run</span> Order</button>
    </div>
</div>

<!-- DATE BAR -->
<div class="mb-5 flex items-center justify-between gap-3 overflow-hidden rounded-xl border border-[#e3e3e3] bg-white px-5 py-4">
    <div class="flex items-center justify-between gap-4 max-[470px]:w-full">
    <button id="prevDate" class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-[#dddddd] text-gray-500 hover:bg-gray-50">
      <svg width="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M11.8284 12.0005L14.6569 14.8289L13.2426 16.2431L9 12.0005L13.2426 7.75781L14.6569 9.17203L11.8284 12.0005Z"></path>
      </svg>
    </button>
      <div class="flex w-37.5 flex-col max-[470px]:items-center">
    <div id="selectedDateText" class="Outfit-Medium line-clamp-1 text-[13px] break-all max-[470px]:text-center"></div>
    <div id="selectedDateLabel" class="mt-0.5 line-clamp-2 text-[10px] break-all text-gray-400 max-[470px]:text-center"></div>
      </div>
    <button id="nextDate" class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-[#dddddd] text-gray-500 hover:bg-gray-50">
      <svg width="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.1717 12.0005L9.34326 9.17203L10.7575 7.75781L15.0001 12.0005L10.7575 16.2431L9.34326 14.8289L12.1717 12.0005Z"></path>
      </svg>
    </button>
  </div>

  <div class="hidden items-center gap-4 min-[470px]:flex">
    <div class="text-right">
      <div class="text-[9px] text-gray-400">TOTAL</div>
      <div id="todaysTotalRunorder" class="text-[13px] font-semibold"><%= runorders.length %></div>
    </div>
  </div>
</div>


<!-- CONTENT -->
<div class="grid grid-cols-1 gap-5 xl:grid-cols-[1fr_350px]">
  <!-- TODAY'S RUN ORDERS -->

<section class="rounded-xl border border-[#e3e3e3] bg-white">

<div class="flex items-center justify-between gap-3 overflow-hidden border-b border-[#eeeeee] px-5 py-4">
  <div class="min-w-0">
    <div id="titleRunOrder" class="Outfit-SemiBold truncate text-[14px]">Broadcast Lineups</div>
    <div id="titleRunOrderScheduled" class="mt-0.5 truncate text-[11px] text-gray-400"><%= runorders.length %> rundowns scheduled</div>
  </div>
  <div id="runDownStatus" class="shrink-0 text-right max-[400px]:hidden">
  <% if(nextNews){ %>
  <div class="text-[9px] text-gray-400">ACTIVE RUNDOWN</div>
  <div class="Outfit-SemiBold max-w-40 truncate text-[13px] text-red-600"><%= nextNews.name %></div>
  <div class="mt-0.5 text-[9px] text-gray-400"><%= nextNews.air_time.slice(0, 5) %></div>
  <% } else { %>
  <div class="text-[9px] text-gray-400">ACTIVE RUNDOWN</div>
  <div class="Outfit-Medium mt-0.5 text-[11px] text-gray-500">No active rundown</div>
  <% } %>
  </div>
</div>
<div id="sideRunorders" class="scrollbar min-h-75 max-h-137.5 overflow-y-auto xl:max-h-175" style="scrollbar-gutter: stable;">
<% runorders.forEach((order) => { %>
  <div class="border-b border-[#eeeeee] px-5 py-2.5 select-none <%= order.status == 'live' ? 'bg-black/5' : '' %>">
    <div class="flex items-start justify-between gap-5">
      <div class="flex items-start gap-4">
        <div class="Outfit-SemiBold flex h-11 w-11 shrink-0 items-center justify-center rounded-lg <%= order.status === 'live' ? 'bg-red-100 border border-red-500 text-red-700' : order.status === 'completed' ? 'bg-green-100 border border-green-500 text-green-700' : 'bg-gray-100 text-gray-600' %>  text-[11px] "><%= order.air_time.slice(0, 5) %></div>
        <div class="min-w-0">
          <h2 class="Outfit-SemiBold line-clamp-1 text-[14px] text-nowrap break-all"><%= order.name %></h2>
          <div class="mt-1 flex items-center gap-4 text-[10px] text-gray-400">
            <span class="text-nowrap "> Producer: <%= order.full_name %> </span>
            <span class="text-nowrap hidden md:block "> <%= order.status %> </span>
          </div>
        </div>
      </div>
      <div class="relative flex shrink-0 items-center gap-1">
        <a href='/runorder/<%= order.runorderID %>'>
          <button class="hidden md:block rounded-lg px-3 py-2 text-[10px] text-gray-500 hover:bg-gray-100 hover:text-black cursor-pointer">Open</button>
        </a>
        <button onclick="activeRunOrder('<%= order.runorderID %>')" class="hidden md:block rounded-lg px-3 py-2 text-[10px] text-gray-500 hover:bg-gray-100 hover:text-black cursor-pointer">Set Active</button>
        <button onclick="toggleRunOrderMenu(this)" class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-black">⋮</button>
        <div class="runorder-menu fixed z-9999 hidden w-44 rounded-xl border border-[#e5e5e5] bg-white p-1.5 shadow-[0_8px_25px_rgba(0,0,0,0.08)]">
        <a href='/runorder/<%= order.runorderID %>'>
          <button class="flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-left text-[11px] text-gray-600 hover:bg-gray-100 hover:text-black">
            <svg width="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M1.18164 12C2.12215 6.87976 6.60812 3 12.0003 3C17.3924 3 21.8784 6.87976 22.8189 12C21.8784 17.1202 17.3924 21 12.0003 21C6.60812 21 2.12215 17.1202 1.18164 12ZM12.0003 17C14.7617 17 17.0003 14.7614 17.0003 12C17.0003 9.23858 14.7617 7 12.0003 7C9.23884 7 7.00026 9.23858 7.00026 12C7.00026 14.7614 9.23884 17 12.0003 17ZM12.0003 15C10.3434 15 9.00026 13.6569 9.00026 12C9.00026 10.3431 10.3434 9 12.0003 9C13.6571 9 15.0003 10.3431 15.0003 12C15.0003 13.6569 13.6571 15 12.0003 15Z"></path></svg>
            <span>Open Run Order</span>
          </button>
        </a>
          <button onclick="activeRunOrder('<%= order.runorderID %>')" class="flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-left text-[11px] text-gray-600 hover:bg-gray-100 hover:text-black">
            <svg width="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M4 12C4 7.58172 7.58172 4 12 4C16.4183 4 20 7.58172 20 12C20 16.4183 16.4183 20 12 20C7.58172 20 4 16.4183 4 12ZM12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM17.4571 9.45711L16.0429 8.04289L11 13.0858L8.20711 10.2929L6.79289 11.7071L11 15.9142L17.4571 9.45711Z"></path></svg>
            <span>Set Active</span>
          </button>
          <button onclick="editRunOrder('<%= order.runorderID %>')" class="flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-left text-[11px] text-gray-600 hover:bg-gray-100 hover:text-black">
            <svg width="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M5 18.89H6.41421L15.7279 9.57627L14.3137 8.16206L5 17.4758V18.89ZM21 20.89H3V16.6473L16.435 3.21231C16.8256 2.82179 17.4587 2.82179 17.8492 3.21231L20.6777 6.04074C21.0682 6.43126 21.0682 7.06443 20.6777 7.45495L9.24264 18.89H21V20.89ZM15.7279 6.74785L17.1421 8.16206L18.5563 6.74785L17.1421 5.33363L15.7279 6.74785Z"></path></svg>
            <span>Edit Run Order</span>
          </button>
          <button onclick="downloadRunOrder('<%= order.runorderID %>')" class="flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-left text-[11px] text-gray-600 hover:bg-gray-100 hover:text-black">
            <svg width="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M3 19H21V21H3V19ZM13 13.1716L19.0711 7.1005L20.4853 8.51472L12 17L3.51472 8.51472L4.92893 7.1005L11 13.1716V2H13V13.1716Z"></path></svg>
            <span>Download</span>
          </button>
          <button onclick="saveAsPreset('<%= order.runorderID %>')" class="flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-left text-[11px] text-gray-600 hover:bg-gray-100 hover:text-black">
            <svg width="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18 19H19V6.82843L17.1716 5H16V9H7V5H5V19H6V12H18V19ZM4 3H18L20.7071 5.70711C20.8946 5.89464 21 6.149 21 6.41421V20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V4C3 3.44772 3.44772 3 4 3ZM8 14V19H16V14H8Z"></path></svg>
            <span>Save as Preset</span>
          </button>
          <div class="my-1 border-t border-[#eeeeee]"></div>
          <button ondblclick="deleteRunOrder('<%= order.runorderID %>')" class="flex w-full cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 text-left text-[11px] text-red-500 hover:bg-red-50">
            <svg width="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17 6H22V8H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V8H2V6H7V3C7 2.44772 7.44772 2 8 2H16C16.5523 2 17 2.44772 17 3V6ZM18 8H6V20H18V8ZM9 11H11V17H9V11ZM13 11H15V17H13V11ZM9 4V6H15V4H9Z"></path></svg>
            <span>Delete Run Order</span>
          </button>
        </div>
      </div>
    </div>
  </div>
<% }) %>
<% if(runorders.length === 0 ){ %>
  <div id="NoRunorderYet" class="flex min-h-75 flex-col items-center justify-center px-6 py-12 text-center">
  <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gray-100 text-gray-400">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor" stroke-width="1.5"></rect>
      <path d="M8 8H16M8 12H16M8 16H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
  </div>
  <div class="Outfit-Medium mt-3 text-[12px] text-gray-700">No rundowns scheduled</div>
  <div class="mt-1 max-w-55 text-[10px] leading-4 text-gray-400">There are no broadcast run orders scheduled for this date.</div>
  <button onclick="openCreateModal()" class="Outfit-Medium mt-4 cursor-pointer rounded-lg bg-black px-4 py-2 text-[9px] text-white hover:bg-gray-800">Create Run Order</button>
</div>

<% } %>
</div>






</section>


  <!-- RIGHT PANEL -->

<aside class="space-y-5">
  <!-- CREATE -->
  <section class="rounded-xl border border-[#e3e3e3] bg-white">
    <div class="border-b border-[#eeeeee] px-5 py-4">
      <div class="Outfit-SemiBold text-[13px] break-all line-clamp-1">Create Run Order</div>
      <div class="mt-0.5 text-[10px] text-gray-400 break-all line-clamp-1">Start with a blank rundown or a preset.</div>
    </div>
    <div class="p-4">
      <button onclick="openCreateModal()" class="mb-2 flex w-full overflow-hidden items-center gap-3 rounded-lg border border-[#dddddd] cursor-pointer p-4 text-left hover:bg-gray-50">
        <div class="flex h-9 w-9 aspect-square items-center justify-center rounded-lg bg-gray-100 text-lg">+</div>
        <div>
          <div class="Outfit-Medium text-[12px] break-all line-clamp-1">Blank Run Order</div>
          <div class="mt-0.5 text-[10px] text-gray-400 break-all line-clamp-1">Start from an empty rundown</div>
        </div>
      </button>
      <button onclick="openPresetModal()" class="flex w-full overflow-hidden items-center gap-3 rounded-lg border border-[#dddddd] cursor-pointer p-4 text-left hover:bg-gray-50">
        <div class="Outfit-SemiBold flex h-9 w-9 aspect-square items-center justify-center rounded-lg bg-gray-100 text-[11px]">P</div>
        <div>
          <div class="Outfit-Medium text-[12px] break-all line-clamp-1">From Preset</div>
          <div class="mt-0.5 text-[10px] text-gray-400 break-all line-clamp-1">Use a saved newsroom format</div>
        </div>
      </button>
    </div>
  </section>

  <!-- PRESETS -->

  <section class="rounded-xl border border-[#e3e3e3] bg-white">
    <div class="flex items-center justify-between gap-3 border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-SemiBold text-[13px] break-all line-clamp-1">Saved Presets</div>
        <div class="mt-0.5 text-[10px] text-gray-400 break-all line-clamp-1">Your newsroom formats</div>
      </div>
      <a href="/settings/presets" class="text-[10px] text-gray-400 hover:text-black"> Manage </a>
    </div>
    <div class="p-2">
      <button onclick="usePreset('Evening News')" class="cursor-pointer flex w-full items-center justify-between rounded-lg p-3 text-left hover:bg-gray-50">
        <div>
          <div class="Outfit-Medium text-[11px] break-all line-clamp-1">Evening News</div>
          <div class="mt-0.5 text-[9px] text-gray-400 break-all line-clamp-1">18 story slots</div>
        </div>
        <span class="text-gray-300"> › </span>
      </button>
      <button onclick="usePreset('Morning Bulletin')" class="cursor-pointer flex w-full items-center justify-between rounded-lg p-3 text-left hover:bg-gray-50">
        <div>
          <div class="Outfit-Medium text-[11px] break-all line-clamp-1">Morning Bulletin</div>
          <div class="mt-0.5 text-[9px] text-gray-400 break-all line-clamp-1">12 story slots</div>
        </div>
        <span class="text-gray-300"> › </span>
      </button>
      <button onclick="usePreset('Weekend News')" class="cursor-pointer flex w-full items-center justify-between rounded-lg p-3 text-left hover:bg-gray-50">
        <div>
          <div class="Outfit-Medium text-[11px] break-all line-clamp-1">Weekend News</div>
          <div class="mt-0.5 text-[9px] text-gray-400 break-all line-clamp-1">15 story slots</div>
        </div>
        <span class="text-gray-300"> › </span>
      </button>
    </div>
  </section>

  <!-- RECENT -->
  <section class="rounded-xl border border-[#e3e3e3] bg-white">
    <div class="border-b border-[#eeeeee] px-5 py-4">
      <div class="Outfit-SemiBold text-[13px] break-all line-clamp-1">Recent Run Orders</div>
    </div>
    <div class="p-2">
      <button class="flex w-full items-center gap-3 justify-between rounded-lg p-3 text-left hover:bg-gray-50">
        <div>
          <div class="Outfit-Medium text-[11px] break-all line-clamp-1">Evening News</div>
          <div class="mt-0.5 text-[9px] text-gray-400 break-all line-clamp-1">10 Aug • 18 stories</div>
        </div>
        <span class="text-[9px] text-gray-400"> Yesterday </span>
      </button>
      <button class="flex w-full items-center gap-3 justify-between rounded-lg p-3 text-left hover:bg-gray-50">
        <div>
          <div class="Outfit-Medium text-[11px] break-all line-clamp-1">Night Bulletin</div>
          <div class="mt-0.5 text-[9px] text-gray-400 break-all line-clamp-1">09 Aug • 11 stories</div>
        </div>
        <span class="text-[9px] text-gray-400"> 2d ago </span>
      </button>
    </div>
  </section>
</aside>

</div>



</main>

  <!-- CREATE MODAL -->
<div id="createModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/30 p-5">
  <div class="w-full max-w-md rounded-xl bg-white shadow-xl overflow-hidden">
    <div class="flex items-center gap-3 justify-between border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-SemiBold text-[14px] break-all line-clamp-1">New Run Order</div>
        <div class="mt-0.5 text-[10px] text-gray-400 break-all line-clamp-1">Create today's broadcast rundown</div>
      </div>
      <div onclick="closeCreateModal()" class="rounded-sm px-2 cursor-pointer w-fit h-fit aspect-square hover:bg-gray-200 text-gray-400 hover:text-black">
        <p class="cursor-pointer">×</p>
      </div>
    </div>
    <div class="space-y-4 p-5">
      <div>
        <label class="Outfit-Medium mb-1.5 block text-[10px] text-gray-500 break-all line-clamp-1"> Run Order Name </label>
        <input type="text" name="runOrderName" id="runOrderName" placeholder="Example: Evening News" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[12px] outline-none focus:border-black" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[10px] text-gray-500 break-all line-clamp-1"> Date </label>
          <input type="date" name="runOrderDate" id="runOrderDate" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[12px] outline-none focus:border-black" />
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[10px] text-gray-500 break-all line-clamp-1"> Air Time </label>
          <input type="time" name="runOrderAirtime" id="runOrderAirtime" value="20:00" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[12px] outline-none focus:border-black" />
        </div>
      </div>
      <div>
        <label class="Outfit-Medium mb-1.5 block text-[10px] text-gray-500 break-all line-clamp-1"> Start With </label>
        <select name="runOrderPreset" id="runOrderPreset" class="w-full rounded-lg border border-[#dddddd] bg-white px-3 py-2.5 text-[12px] outline-none focus:border-black">
          <option value="11">Blank rundown</option>
          <option value="12">Evening News preset</option>
          <option value="13">Morning Bulletin preset</option>
          <option value="14">Duplicate yesterday's rundown</option>
        </select>
      </div>
    </div>
    <div class="flex justify-end gap-2 border-t border-[#eeeeee] px-5 py-4">
      <button onclick="closeCreateModal()" class="rounded-lg px-4 py-2 text-[11px] cursor-pointer text-gray-500 hover:bg-gray-100">Cancel</button>
      <button id="newRunOrder" class="Outfit-Medium justify-center w-28.75 rounded-lg bg-black px-4 py-2 text-[11px] flex cursor-pointer gap-0.5 text-white text-nowrap">
        <span id="buttonText" class="flex items-center justify-center">
          Create <span class="hidden sm:block px-0.5">Run</span> Order
        </span>
        <span id="buttionLoading" class="animate-spin hidden">
          <svg width="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.9995 2C12.5518 2 12.9995 2.44772 12.9995 3V6C12.9995 6.55228 12.5518 7 11.9995 7C11.4472 7 10.9995 6.55228 10.9995 6V3C10.9995 2.44772 11.4472 2 11.9995 2ZM11.9995 17C12.5518 17 12.9995 17.4477 12.9995 18V21C12.9995 21.5523 12.5518 22 11.9995 22C11.4472 22 10.9995 21.5523 10.9995 21V18C10.9995 17.4477 11.4472 17 11.9995 17ZM20.6597 7C20.9359 7.47829 20.772 8.08988 20.2937 8.36602L17.6956 9.86602C17.2173 10.1422 16.6057 9.97829 16.3296 9.5C16.0535 9.02171 16.2173 8.41012 16.6956 8.13398L19.2937 6.63397C19.772 6.35783 20.3836 6.52171 20.6597 7ZM7.66935 14.5C7.94549 14.9783 7.78161 15.5899 7.30332 15.866L4.70525 17.366C4.22695 17.6422 3.61536 17.4783 3.33922 17C3.06308 16.5217 3.22695 15.9101 3.70525 15.634L6.30332 14.134C6.78161 13.8578 7.3932 14.0217 7.66935 14.5ZM20.6597 17C20.3836 17.4783 19.772 17.6422 19.2937 17.366L16.6956 15.866C16.2173 15.5899 16.0535 14.9783 16.3296 14.5C16.6057 14.0217 17.2173 13.8578 17.6956 14.134L20.2937 15.634C20.772 15.9101 20.9359 16.5217 20.6597 17ZM7.66935 9.5C7.3932 9.97829 6.78161 10.1422 6.30332 9.86602L3.70525 8.36602C3.22695 8.08988 3.06308 7.47829 3.33922 7C3.61536 6.52171 4.22695 6.35783 4.70525 6.63397L7.30332 8.13398C7.78161 8.41012 7.94549 9.02171 7.66935 9.5Z"></path></svg>
        </span>
      </button>
    </div>
  </div>
</div>

  <!-- PRESET MODAL -->
<div id="presetModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/30 p-5">
  <div class="w-full max-w-md rounded-xl bg-white shadow-xl overflow-hidden">
    <div class="flex items-center justify-between gap-3 border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-SemiBold line-clamp-1 text-[14px] break-all">Use a Preset</div>
        <div class="mt-0.5 line-clamp-1 text-[10px] break-all text-gray-400">Select a newsroom format</div>
      </div>
      <div onclick="closePresetModal()" class="rounded-sm px-2 cursor-pointer w-fit h-fit aspect-square hover:bg-gray-200 text-gray-400 hover:text-black">
        <p class="cursor-pointer">×</p>
      </div>
    </div>
    <div class="space-y-2 p-4">
      <button onclick="usePreset('Evening News')" class="flex w-full cursor-pointer items-center justify-between gap-3 rounded-lg border border-[#e5e5e5] p-4 text-left hover:bg-gray-50">
        <div>
          <div class="Outfit-Medium line-clamp-1 text-[12px] break-all">Evening News</div>
          <div class="mt-1 line-clamp-1 text-[10px] break-all text-gray-400">Main evening format • 18 slots</div>
        </div>
        <span class="text-gray-300"> › </span>
      </button>
      <button onclick="usePreset('Morning Bulletin')" class="flex w-full cursor-pointer items-center justify-between gap-3 rounded-lg border border-[#e5e5e5] p-4 text-left hover:bg-gray-50">
        <div>
          <div class="Outfit-Medium line-clamp-1 text-[12px] break-all">Morning Bulletin</div>
          <div class="mt-1 line-clamp-1 text-[10px] break-all text-gray-400">Morning format • 12 slots</div>
        </div>
        <span class="text-gray-300"> › </span>
      </button>
      <button onclick="usePreset('Weekend News')" class="flex w-full cursor-pointer items-center justify-between gap-3 rounded-lg border border-[#e5e5e5] p-4 text-left hover:bg-gray-50">
        <div>
          <div class="Outfit-Medium line-clamp-1 text-[12px] break-all">Weekend News</div>
          <div class="mt-1 line-clamp-1 text-[10px] break-all text-gray-400">Weekend format • 15 slots</div>
        </div>
        <span class="text-gray-300"> › </span>
      </button>
    </div>
  </div>
</div>


  <!-- UPDATE MODAL -->

<div id="UpdateModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/30 p-5">
  <div class="w-full max-w-md rounded-xl bg-white shadow-xl overflow-hidden">
    <div class="flex items-center gap-3 justify-between border-b border-[#eeeeee] px-5 py-4">
      <div>
        <div class="Outfit-SemiBold text-[14px] break-all line-clamp-1">New Run Order</div>
        <div class="mt-0.5 text-[10px] text-gray-400 break-all line-clamp-1">Create today's broadcast rundown</div>
      </div>
      <div onclick="CloseUpdateModal()" class="rounded-sm px-2 cursor-pointer w-fit h-fit aspect-square hover:bg-gray-200 text-gray-400 hover:text-black">
        <p class="cursor-pointer">×</p>
      </div>
    </div>
    <div class="space-y-4 p-5">
      <div>
        <label class="Outfit-Medium mb-1.5 block text-[10px] text-gray-500 break-all line-clamp-1"> Run Order Name </label>
        <input type="text" name="UpdaterunOrderName" id="UpdaterunOrderName" placeholder="Example: Evening News" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[12px] outline-none focus:border-black">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[10px] text-gray-500 break-all line-clamp-1"> Date </label>
          <input type="date" name="UpdaterunOrderDate" id="UpdaterunOrderDate" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[12px] outline-none focus:border-black">
        </div>
        <div>
          <label class="Outfit-Medium mb-1.5 block text-[10px] text-gray-500 break-all line-clamp-1"> Air Time </label>
          <input type="time" name="UpdaterunOrderAirtime" id="UpdaterunOrderAirtime" value="20:00" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[12px] outline-none focus:border-black">
        </div>
      </div>
      <div>
        <label class="Outfit-Medium mb-1.5 block text-[10px] text-gray-500 break-all line-clamp-1"> Producer </label>
        <select name="UpdaterunOrderProducer" id="UpdaterunOrderProducer" class="w-full rounded-lg border border-[#dddddd] bg-white px-3 py-2.5 text-[12px] outline-none focus:border-black">
          <option value="0">Select</option>
        </select>
      </div>
    </div>
    <div class="flex justify-end gap-2 border-t border-[#eeeeee] px-5 py-4">
      <button onclick="CloseUpdateModal()" class="rounded-lg px-4 py-2 text-[11px] cursor-pointer text-gray-500 hover:bg-gray-100">Cancel</button>
      <button id="UpdateRunOrder" class="Outfit-Medium justify-center w-28.75 rounded-lg bg-black px-4 py-2 text-[11px] flex cursor-pointer gap-0.5 text-white text-nowrap">
        <span id="buttonText" class="flex items-center justify-center">
          Update <span class="hidden sm:block px-0.5">Run</span> Order
        </span>
        <span id="buttionLoading" class="animate-spin hidden">
          <svg width="15" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.9995 2C12.5518 2 12.9995 2.44772 12.9995 3V6C12.9995 6.55228 12.5518 7 11.9995 7C11.4472 7 10.9995 6.55228 10.9995 6V3C10.9995 2.44772 11.4472 2 11.9995 2ZM11.9995 17C12.5518 17 12.9995 17.4477 12.9995 18V21C12.9995 21.5523 12.5518 22 11.9995 22C11.4472 22 10.9995 21.5523 10.9995 21V18C10.9995 17.4477 11.4472 17 11.9995 17ZM20.6597 7C20.9359 7.47829 20.772 8.08988 20.2937 8.36602L17.6956 9.86602C17.2173 10.1422 16.6057 9.97829 16.3296 9.5C16.0535 9.02171 16.2173 8.41012 16.6956 8.13398L19.2937 6.63397C19.772 6.35783 20.3836 6.52171 20.6597 7ZM7.66935 14.5C7.94549 14.9783 7.78161 15.5899 7.30332 15.866L4.70525 17.366C4.22695 17.6422 3.61536 17.4783 3.33922 17C3.06308 16.5217 3.22695 15.9101 3.70525 15.634L6.30332 14.134C6.78161 13.8578 7.3932 14.0217 7.66935 14.5ZM20.6597 17C20.3836 17.4783 19.772 17.6422 19.2937 17.366L16.6956 15.866C16.2173 15.5899 16.0535 14.9783 16.3296 14.5C16.6057 14.0217 17.2173 13.8578 17.6956 14.134L20.2937 15.634C20.772 15.9101 20.9359 16.5217 20.6597 17ZM7.66935 9.5C7.3932 9.97829 6.78161 10.1422 6.30332 9.86602L3.70525 8.36602C3.22695 8.08988 3.06308 7.47829 3.33922 7C3.61536 6.52171 4.22695 6.35783 4.70525 6.63397L7.30332 8.13398C7.78161 8.41012 7.94549 9.02171 7.66935 9.5Z"></path></svg>
        </span>
      </button>
    </div>
  </div>
</div>
</div>
<!-- DUPLICATE MODAL -->
<div id="duplicateModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/30 p-5">
  <div class="w-full max-w-md rounded-xl bg-white shadow-xl">
    
    <!-- Header -->

    <div class="flex items-center justify-between border-b border-[#eeeeee] px-5 py-4 gap-3">
      <div>
        <div class="Outfit-SemiBold line-clamp-1 text-[14px] break-all">Duplicate Run Order</div>
        <div class="mt-0.5 line-clamp-1 text-[10px] break-all text-gray-400">Create a copy of this rundown</div>
      </div>
      <div onclick="closeDuplicateModal()" class="rounded-sm px-2 cursor-pointer w-fit h-fit aspect-square hover:bg-gray-200 text-gray-400 hover:text-black">
        <p class="cursor-pointer">×</p>
      </div>
    </div>

    <!-- Body -->

    <div class="space-y-4 p-5">
      <!-- Original -->

      <div class="rounded-lg bg-gray-50 p-3">
        <div class="text-[9px] text-gray-400">DUPLICATING</div>

        <div id="duplicateOriginalName" class="mt-1 text-[12px] font-medium">Fahuge Khabaru</div>
      </div>

      <!-- Name -->

      <div>
        <label class="mb-1.5 block text-[10px] font-medium text-gray-500"> NEW RUN ORDER NAME </label>

        <input id="duplicateName" type="text" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[12px] outline-none focus:border-black" placeholder="Enter run order name" />
      </div>

      <!-- Date -->

      <div>
        <label class="mb-1.5 block text-[10px] font-medium text-gray-500"> DATE </label>

        <input id="duplicateDate" type="date" class="w-full rounded-lg border border-[#dddddd] px-3 py-2.5 text-[12px] outline-none focus:border-black" />
      </div>

      <!-- Options -->

      <div class="space-y-2">
        <label class="flex cursor-pointer items-center gap-3 overflow-hidden rounded-lg border border-[#eeeeee] p-3 hover:bg-gray-50">
          <input id="duplicateStories" type="checkbox" checked class="h-3.5 w-3.5" />

          <div>
            <div class="text-[11px] font-medium">Copy stories</div>

            <div class="text-[9px] text-gray-400">Include all stories from the original rundown</div>
          </div>
        </label>

        <label class="flex cursor-pointer items-center gap-3 overflow-hidden rounded-lg border border-[#eeeeee] p-3 hover:bg-gray-50">
          <input id="duplicateGraphics" type="checkbox" checked class="h-3.5 w-3.5" />

          <div>
            <div class="text-[11px] font-medium">Copy graphics</div>

            <div class="text-[9px] text-gray-400">Keep CG and graphics information</div>
          </div>
        </label>
      </div>
    </div>

    <!-- Footer -->

    <div class="flex justify-end gap-2 border-t border-[#eeeeee] px-5 py-4">
      <button onclick="closeDuplicateModal()" class="rounded-lg px-4 py-2 text-[11px] text-gray-500 hover:bg-gray-100 cursor-pointer">Cancel</button>

      <button onclick="confirmDuplicate()" class="rounded-lg bg-black px-4 py-2 text-[11px] font-medium text-white hover:bg-gray-800 cursor-pointer text-nowrap line-clamp-1 break-all">Duplicate Run Order</button>
    </div>
    
  </div>
</div>
<%- include('partials/alert') -%>
<script src="/js/runorders.js"></script>
    </div>
  </body>
</html>
