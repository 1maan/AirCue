<!-- ========================================== -->
<!-- DEDICATED STORY EDITOR & RUNDOWN GRID VIEW -->
<!-- ========================================== -->
<div class="flex h-screen w-full flex-col bg-[#18181b] text-zinc-200 font-sans select-none overflow-hidden">
  
  <!-- Top Bar / Title Bar -->
  <div class="flex h-7 w-full items-center bg-[#464646] px-2 justify-between">
    <p class="outfit-Regular text-sm text-white">AirCue 1.7.5 - [Story Editor & Rundown Grid Workspace]</p>
    <div class="flex items-center space-x-2 text-zinc-400 text-xs">
      <span class="hover:text-white cursor-pointer px-2 py-0.5">🗕</span>
      <span class="hover:text-white cursor-pointer px-2 py-0.5">🗖</span>
      <span class="hover:bg-red-600 hover:text-white cursor-pointer px-2 py-0.5">✕</span>
    </div>
  </div>

  <!-- Menu Bar -->
  <div class="flex w-full items-center border-t border-[#3C3E3D] bg-[#4b4b4b] z-50">
    <nav>
      <div class="flex flex-row">
        <!-- File Menu -->
        <div class="group relative">
          <p class="outfit-Regular cursor-pointer border border-transparent px-3 py-1 text-[12px] text-white hover:border-[#686868] hover:bg-[#575757]">File</p>
          <div class="absolute left-0 hidden text-left font-sans text-xs group-hover:block">
            <div class="w-56 border border-[#3f3f4a] bg-[#1e1e24] py-1 text-zinc-200 shadow-2xl">
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-[#0066cc] hover:text-white">
                <span>New Bulletin</span>
                <span class="font-mono text-[10px] text-zinc-400">Ctrl+N</span>
              </div>
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-[#0066cc] hover:text-white">
                <span>Open...</span>
                <span class="font-mono text-[10px] text-zinc-400">Ctrl+O</span>
              </div>
              <div class="my-1 h-[1px] bg-[#3f3f4a]"></div>
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-[#0066cc] hover:text-white">
                <span>Save</span>
                <span class="font-mono text-[10px] text-zinc-400">Ctrl+S</span>
              </div>
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-red-700 hover:text-white">
                <span>Exit</span>
                <span class="font-mono text-[10px] text-zinc-400">Alt+F4</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Edit Menu -->
        <div class="group relative">
          <p class="outfit-Regular cursor-pointer border border-transparent px-3 py-1 text-[12px] text-white hover:border-[#686868] hover:bg-[#575757]">Edit</p>
          <div class="absolute left-0 hidden text-left font-sans text-xs group-hover:block">
            <div class="w-56 border border-[#3f3f4a] bg-[#1e1e24] py-1 text-zinc-200 shadow-2xl">
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-[#0066cc] hover:text-white">
                <span>Undo</span>
                <span class="font-mono text-[10px] text-zinc-400">Ctrl+Z</span>
              </div>
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-[#0066cc] hover:text-white">
                <span>Redo</span>
                <span class="font-mono text-[10px] text-zinc-400">Ctrl+Y</span>
              </div>
            </div>
          </div>
        </div>

        <!-- View Menu -->
        <div class="group relative">
          <p class="outfit-Regular cursor-pointer border border-transparent px-3 py-1 text-[12px] text-white hover:border-[#686868] hover:bg-[#575757]">View</p>
          <div class="absolute left-0 hidden text-left font-sans text-xs group-hover:block">
            <div class="w-56 border border-[#3f3f4a] bg-[#1e1e24] py-1 text-zinc-200 shadow-2xl">
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-[#0066cc] hover:text-white">
                <span>Rundown Grid View</span>
                <span class="font-mono text-[10px] text-zinc-400">F11</span>
              </div>
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-[#0066cc] hover:text-white">
                <span>Full Story Editor</span>
                <span class="font-mono text-[10px] text-zinc-400">Ctrl+E</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Rundown Menu -->
        <div class="group relative">
          <p class="outfit-Regular cursor-pointer border border-transparent px-3 py-1 text-[12px] text-white hover:border-[#686868] hover:bg-[#575757]">Rundown</p>
          <div class="absolute left-0 hidden text-left font-sans text-xs group-hover:block">
            <div class="w-56 border border-[#3f3f4a] bg-[#1e1e24] py-1 text-zinc-200 shadow-2xl">
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-[#0066cc] hover:text-white">
                <span>New Story</span>
                <span class="font-mono text-[10px] text-zinc-400">Ctrl+N</span>
              </div>
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 hover:bg-[#0066cc] hover:text-white">
                <span>Delete Story</span>
                <span class="font-mono text-[10px] text-zinc-400">Del</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Broadcast Menu -->
        <div class="group relative">
          <p class="outfit-Regular cursor-pointer border border-transparent px-3 py-1 text-[12px] text-white hover:border-[#686868] hover:bg-[#575757]">Broadcast</p>
          <div class="absolute left-0 hidden text-left font-sans text-xs group-hover:block">
            <div class="w-56 border border-[#3f3f4a] bg-[#1e1e24] py-1 text-zinc-200 shadow-2xl">
              <div class="flex cursor-pointer items-center justify-between px-3 py-1.5 font-bold hover:bg-red-700 hover:text-white">
                <span>Go On Air</span>
                <span class="font-mono text-[10px] text-white">Enter</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </div>

  <!-- Action Sub-Toolbar -->
  <div class="flex h-10 w-full items-center bg-[#3c3c3c] border-b border-[#2d2d30] px-3 space-x-2 text-xs">
    <button class="bg-[#515155] hover:bg-[#0066cc] text-white px-3 py-1 rounded transition-colors flex items-center space-x-1"><span>+ Add Story</span></button>
    <button class="bg-[#515155] hover:bg-[#0066cc] text-white px-3 py-1 rounded transition-colors">Duplicate Row</button>
    <button class="bg-[#515155] hover:bg-[#0066cc] text-white px-3 py-1 rounded transition-colors">Move Up</button>
    <button class="bg-[#515155] hover:bg-[#0066cc] text-white px-3 py-1 rounded transition-colors">Move Down</button>
    <div class="h-5 w-[1px] bg-[#5a5a5e] mx-1"></div>
    <button class="bg-emerald-700 hover:bg-emerald-800 text-white px-3 py-1 rounded transition-colors">Approve Changes</button>
    <div class="h-5 w-[1px] bg-[#5a5a5e] mx-1"></div>
    <span class="text-zinc-300 font-mono text-[11px]">Active Bulletin: <strong class="text-white">Evening News 18:00 (LOCKED)</strong></span>
  </div>

  <!-- Main Split Pane: Grid on Left, Detailed Multi-Tab Editor on Right -->
  <div class="flex flex-1 w-full overflow-hidden">
    
    <!-- LEFT PANEL: Extended Rundown Table (55% Width) -->
    <div class="w-[55%] flex flex-col border-r border-[#2d2d30] bg-[#1e1e22]">
      <div class="flex h-8 items-center justify-between bg-[#2d2d30] px-3 text-xs font-bold uppercase tracking-wider text-zinc-400 border-b border-[#3f3f4a]">
        <span>Rundown Master Sequence</span>
        <span class="font-mono text-emerald-400">Total Show: 00:28:45</span>
      </div>

      <!-- Advanced Table Column Headings -->
      <div class="grid grid-cols-12 bg-[#252528] px-3 py-1.5 text-[11px] text-zinc-400 border-b border-[#333338]">
        <span class="col-span-1">No.</span>
        <span class="col-span-4">Slug / Title</span>
        <span class="col-span-2">Type</span>
        <span class="col-span-2">Dur</span>
        <span class="col-span-3 text-right">Status</span>
      </div>

      <!-- Multi-Row Grid Entries -->
      <div class="flex-1 overflow-y-auto text-xs divide-y divide-[#2d2d30]">
        
        <!-- Active Row Selected -->
        <div class="grid grid-cols-12 items-center px-3 py-2.5 bg-[#2a2d32] border-l-4 border-blue-500 cursor-pointer">
          <span class="col-span-1 font-mono text-zinc-400 font-bold">01</span>
          <span class="col-span-4 text-white font-bold">Opening Intro & Headlines</span>
          <span class="col-span-2 text-zinc-400 text-[11px]">ANCHOR</span>
          <span class="col-span-2 font-mono text-zinc-200">01:30</span>
          <span class="col-span-3 text-right text-emerald-400 font-semibold">Approved</span>
        </div>

        <div class="grid grid-cols-12 items-center px-3 py-2.5 hover:bg-[#252528] cursor-pointer">
          <span class="col-span-1 font-mono text-zinc-400">02</span>
          <span class="col-span-4 text-zinc-200">Global Climate Summit Update</span>
          <span class="col-span-2 text-zinc-400 text-[11px]">PKG/VO</span>
          <span class="col-span-2 font-mono text-zinc-200">03:00</span>
          <span class="col-span-3 text-right text-amber-400 font-semibold">In Editing</span>
        </div>

        <div class="grid grid-cols-12 items-center px-3 py-2.5 hover:bg-[#252528] cursor-pointer">
          <span class="col-span-1 font-mono text-zinc-400">03</span>
          <span class="col-span-4 text-zinc-200">Tech Sector Market Rally</span>
          <span class="col-span-2 text-zinc-400 text-[11px]">LIVE INTERVIEW</span>
          <span class="col-span-2 font-mono text-zinc-200">02:15</span>
          <span class="col-span-3 text-right text-zinc-400 font-semibold">Draft</span>
        </div>

        <div class="grid grid-cols-12 items-center px-3 py-2.5 hover:bg-[#252528] cursor-pointer">
          <span class="col-span-1 font-mono text-zinc-400">04</span>
          <span class="col-span-4 text-zinc-200">Local Transit Strike Impact</span>
          <span class="col-span-2 text-zinc-400 text-[11px]">PKG</span>
          <span class="col-span-2 font-mono text-zinc-200">02:00</span>
          <span class="col-span-3 text-right text-emerald-400 font-semibold">Approved</span>
        </div>

        <div class="grid grid-cols-12 items-center px-3 py-2.5 hover:bg-[#252528] cursor-pointer">
          <span class="col-span-1 font-mono text-zinc-400">05</span>
          <span class="col-span-4 text-zinc-200">Commercial Break 1</span>
          <span class="col-span-2 text-zinc-500 text-[11px]">BREAK</span>
          <span class="col-span-2 font-mono text-zinc-500">04:00</span>
          <span class="col-span-3 text-right text-blue-400 font-semibold">Scheduled</span>
        </div>

      </div>
    </div>

    <!-- RIGHT PANEL: Full Script & Metadata Editor (45% Width) -->
    <div class="w-[45%] flex flex-col bg-[#18181b]">
      
      <!-- Editor Header -->
      <div class="flex h-8 items-center justify-between bg-[#2d2d30] px-3 text-xs font-bold uppercase tracking-wider text-zinc-400 border-b border-[#3f3f4a]">
        <span>Story Editor [ID: STY-1082]</span>
        <span class="text-xs font-normal text-zinc-400">Last saved: 18:35:10</span>
      </div>

      <!-- Form & Script Container -->
      <div class="flex flex-1 flex-col p-4 space-y-3 overflow-y-auto">
        
        <!-- Story Slug Row -->
        <div class="grid grid-cols-2 gap-3">
          <div class="flex flex-col space-y-1">
            <label class="text-[11px] text-zinc-400">Story Slug</label>
            <input type="text" value="Opening Intro & Headlines" class="bg-[#252528] border border-[#3f3f4a] rounded px-3 py-1.5 text-xs text-white focus:outline-none focus:border-[#0066cc]" />
          </div>
          <div class="flex flex-col space-y-1">
            <label class="text-[11px] text-zinc-400">Segment Type</label>
            <select class="bg-[#252528] border border-[#3f3f4a] rounded px-3 py-1.5 text-xs text-white focus:outline-none focus:border-[#0066cc]">
              <option>Anchor Intro</option>
              <option>Package (PKG)</option>
              <option>Voiceover (VO)</option>
              <option>Live Interview</option>
            </select>
          </div>
        </div>

        <!-- Metadata Properties Row -->
        <div class="grid grid-cols-3 gap-2">
          <div class="flex flex-col space-y-1">
            <label class="text-[11px] text-zinc-400">Journalist</label>
            <input type="text" value="Sarah Jenkins" class="bg-[#252528] border border-[#3f3f4a] rounded px-2.5 py-1.5 text-xs text-white" />
          </div>
          <div class="flex flex-col space-y-1">
            <label class="text-[11px] text-zinc-400">Est. Duration</label>
            <input type="text" value="01:30" class="bg-[#252528] border border-[#3f3f4a] rounded px-2.5 py-1.5 text-xs font-mono text-white" />
          </div>
          <div class="flex flex-col space-y-1">
            <label class="text-[11px] text-zinc-400">Graphics Template</label>
            <input type="text" value="Lower Third F1" class="bg-[#252528] border border-[#3f3f4a] rounded px-2.5 py-1.5 text-xs text-cyan-300 font-mono" />
          </div>
        </div>

        <!-- Script Body Textarea -->
        <div class="flex flex-col space-y-1 flex-1">
          <div class="flex justify-between items-center">
            <label class="text-[11px] text-zinc-400">Script Text (Teleprompter Feed)</label>
            <span class="text-[10px] text-zinc-500 font-mono">Word Count: 184 words</span>
          </div>
          <textarea class="w-full flex-1 min-h-[180px] bg-[#252528] border border-[#3f3f4a] rounded p-3 text-xs text-white font-mono leading-relaxed focus:outline-none resize-none">Good evening, and welcome to the News at Six. I'm Sarah Jenkins.

Our top story tonight: Delegates in Geneva have reached a historic breakthrough on international climate funding frameworks after marathon overnight negotiations. We go live to our correspondent in Europe shortly.

Meanwhile, local markets surged today following unexpected policy shifts from the central bank. Stay with us for full coverage.</textarea>
        </div>

        <!-- Editor Bottom Action Buttons -->
        <div class="flex justify-end space-x-2 pt-1">
          <button class="bg-zinc-700 hover:bg-zinc-600 text-white px-3 py-1.5 rounded text-xs transition-colors">Discard</button>
          <button class="bg-[#0066cc] hover:bg-blue-600 text-white font-semibold px-4 py-1.5 rounded text-xs transition-colors shadow">Save Changes</button>
        </div>

      </div>
    </div>

  </div>

  <!-- Status Bar -->
  <div class="flex h-6 w-full items-center justify-between bg-[#007acc] px-3 text-[11px] text-white">
    <div class="flex items-center space-x-4">
      <span>Database: Synced</span>
      <span>•</span>
      <span>Rundown Version: 14.2</span>
    </div>
    <div class="flex items-center space-x-3 font-mono">
      <span>READY</span>
      <span>|</span>
      <span>18:42:05</span>
    </div>
  </div>

</div>
